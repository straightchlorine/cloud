# Enforce LF line endings for all text files
* text=auto eol=lf

# Ansible / YAML
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Jinja2 templates
*.j2 text eol=lf

# Config files
*.cfg text eol=lf
*.ini text eol=lf
*.conf text eol=lf

# Documentation
*.md text eol=lf

# Vault files - treat as binary (no diff, no merge)
vault.yml binary
vault_*.yml binary

# Python
*.py text eol=lf
