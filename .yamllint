---
extends: default

rules:
  document-start: enable
  line-length:
    max: 120
    level: error
  trailing-spaces: enable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  indentation:
    spaces: 2
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
