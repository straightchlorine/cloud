---
extends: default

# Vendored collections (installed into ./collections) and the local venv are
# not ours to lint; the CI lint step writes collections/ into the workspace.
ignore: |
  .git/
  .venv/
  venv/
  collections/

rules:
  document-start: enable
  line-length:
    max: 120
    level: error
  trailing-spaces: enable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  indentation:
    spaces: 2
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
