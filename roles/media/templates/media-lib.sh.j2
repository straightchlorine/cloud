# shellcheck shell=bash
# shellcheck disable=SC2016  # beets format/query strings ('$id', '$path') are
# literal beets syntax, never shell expansion - hence quoted.
# media-lib - what media-sync and media-status share. Sourced, never run: the
# constants, the beets invocation, and every operation on the LIBRARY itself
# (registering files, pruning rows, regrouping albums, checkpoints), so each
# exists exactly once. The passes that decide what to import live in media-sync.
#
# Nothing here starts a container at source time; media-status sources this too
# and must stay a cheap, lock-free read.

LIB="{{ media_library_path }}"
MEDIA_HOME="{{ media_home }}"
DB="$LIB/beets/library.db"
COMPOSE=(docker compose -f "$MEDIA_HOME/docker-compose.yml")
# --entrypoint skips /init (and the beets web UI) so each run is a one-off that
# exits; service_user sets the uid so beets' moves and tag writes stay owned by
# the remapped stack user. PYTHONUNBUFFERED: without a TTY stdout is
# block-buffered, so a long release pass looks dead while it works.
BEET=("${COMPOSE[@]}" run --rm -T -e PYTHONUNBUFFERED=1 \
    --entrypoint /lsiopy/bin/beet beets)
# The same, but with a TTY: for the modes that prompt (used by media-sync).
# shellcheck disable=SC2034
BEET_TTY=("${COMPOSE[@]}" run --rm -it -e PYTHONUNBUFFERED=1 \
    --entrypoint /lsiopy/bin/beet beets)
# beets' own python, for the few things the CLI has no command for.
BEET_PY=("${COMPOSE[@]}" run --rm -T --entrypoint /lsiopy/bin/python3 beets)
# The role's python tools, as the beets container sees them (deployed to
# $LIB/beets/tools). Each shell function below is a thin call into media_tools.py.
TOOLS=/config/tools
# The library review's files (candidates, decisions, the MusicBrainz cache): on the
# host $LIB/state/review, in the container /review.
REVIEW=/review
MB_URL="{{ media_musicbrainz_url }}"

ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

notify() {
    # ntfy-notify reads its API key from /etc/ntfy/notify-api-key, which the
    # common role deploys root:root 0600 - so when the cron (or a reviewer) runs
    # this as the unprivileged stack user, it finds no key and exits 0 without
    # sending anything: every mode's notification was silently dropped. That
    # user has NOPASSWD sudo, so go through sudo; keep the bare call as a
    # fallback (correct if the key ever becomes group-readable) and never let a
    # failed notification abort a mode mid-run.
    local title
    title="$(hostname): media-sync ${MODE#--} $1"
    sudo -n /usr/local/bin/ntfy-notify "$title" "$2" "${3:-default}" "${4:-musical_note}" ||
        ntfy-notify "$title" "$2" "${3:-default}" "${4:-musical_note}" ||
        true
}

count() { "${BEET[@]}" ls -f '$id' "$@" | wc -l; }

# --- files and rows -------------------------------------------------------------

# Host paths of every audio file under a directory (default: the whole music/).
# One definition of "audio file", used by registration and by the dashboard
# (media_common.AUDIO_EXTENSIONS lists the same extensions for the audit).
audio_files() {  # [<host dir>]
    find "${1:-$LIB/music}" -type f ! -name '.*' \
        \( -iname '*.opus' -o -iname '*.m4a' -o -iname '*.mp3' -o -iname '*.flac' \
        -o -iname '*.ogg' -o -iname '*.wav' \)
}

# The container paths beets already holds a row for. Sorted with LC_ALL=C, and every
# comm that reads them runs under LC_ALL=C too: comm judges "sorted" by the locale's
# collation, so a host in en_GB.UTF-8 (the media Pi) rejects a byte-sorted list as
# "not in sorted order" as soon as names differ in case or script, and stops with a
# truncated result.
#
# Callers read it into a variable first: inside <( ) a failed beet ls is invisible,
# the list just comes out empty, and then EVERY file looks unregistered - the audit
# reports the whole library and register_paths re-imports it (row churn).
registered_paths() {
    local out
    out="$("${BEET[@]}" ls -f '$path' < /dev/null)" || { echo "beet ls failed: cannot tell what has a row" >&2; return 1; }
    printf '%s\n' "$out" | LC_ALL=C sort -u
}

# Container paths of the files under <container dir> that have no row yet. The
# host mirrors the container's /music and /downloads under $LIB, so the mapping
# is a prefix.
unregistered_files() {  # <container dir>
    local registered
    registered="$(registered_paths)" || return 1
    LC_ALL=C comm -23 \
        <(audio_files "$LIB$1" | sed "s|^$LIB||" | LC_ALL=C sort -u) \
        <(printf '%s\n' "$registered")
}

# Register files as they are, but ONLY the ones with no row. Pointing the importer
# at a directory instead re-imports files the library already holds, and beets
# replaces the old row with a new one: a fresh id, no album row (the items come
# back as singletons) and the flexible fields (reviewed) gone - for the whole
# library on every pass, taking minutes where this takes seconds. The candidates
# (container paths, one per line) come on stdin; whatever already has a row is
# dropped from them here.
register_paths() {  # <beets config>
    local cfg="$1" list registered
    registered="$(registered_paths)" || return 1
    # No array-length expansions in a .j2 (their brace-hash opens a Jinja comment).
    # Only files still on disk: a pin hands over the paths its files had BEFORE the
    # import moved them, and a path that no longer exists is not "unregistered".
    list="$(LC_ALL=C comm -23 <(LC_ALL=C sort -u) <(printf '%s\n' "$registered") |
        while IFS= read -r path; do [ ! -e "$LIB$path" ] || printf '%s\n' "$path"; done)"
    if [ -z "$list" ]; then
        echo "to register: 0 file(s)"
        return 0
    fi
    echo "to register: $(printf '%s\n' "$list" | wc -l) file(s)"
    # Batches keep the argument list short and one broken file from costing the
    # whole run; -d newline because paths hold spaces and quotes, not newlines.
    printf '%s\n' "$list" |
        xargs -d '\n' -n 200 -- "${BEET[@]}" -c "$cfg" import
}

register_new() {  # <beets config> <container dir>
    audio_files "$LIB$2" | sed "s|^$LIB||" | register_paths "$1"
}

# Drop rows whose file is gone (a track removed on purpose). The row only: a
# file is never deleted. With <dry> the rows are counted and nothing changes.
prune_rows() {  # [dry]
    local flag=()
    if [ "${1:-}" = dry ]; then
        flag=(--dry-run)
    fi
    "${BEET_PY[@]}" "$TOOLS/media_tools.py" prune "${flag[@]}"
}

# Give tracks that carry a release id but no album row their album row back.
# Importing as a singleton (what the as-is registration does) stores a track
# without one even when the file names its release, and that is also how rows
# damaged before register_new existed look. Grouping by release id and letting
# beets build the album from its items changes no file and no tag. A release
# that already has an album row takes the orphans into it (one row per release);
# a folder's cover.jpg becomes the art of a row that has none.
regroup_albums() {
    "${BEET_PY[@]}" "$TOOLS/media_tools.py" regroup
}

# A copy of library.db to fall back on. Plain cp is consistent here because the
# caller holds the writer lock. Three are kept; never take one of a library that
# is collapsed on purpose (mid-upgrade), or the good copy rotates away.
checkpoint() {
    local f
    f="$LIB/beets/library.db-checkpoint-$(date +%Y%m%d-%H%M%S).bak"
    cp -- "$DB" "$f"
    # shellcheck disable=SC2012  # names are ours: date-stamped, no odd characters
    ls -1t "$LIB"/beets/library.db-checkpoint-*.bak | tail -n +4 | xargs -r rm -f --
    echo "$f"
}

# Can the beets container reach MusicBrainz? A pass that cannot silently matches
# nothing and logs "Skipping." for days, so ask before starting one.
musicbrainz_reachable() {
    "${BEET_PY[@]}" "$TOOLS/media_tools.py" reachable --mb-url "$MB_URL"
}

# Compose an overlay with one extra setting, inside the container, so each
# overlay stays the single source of truth: beets --config takes a single file
# and `beet import --quiet` can only ever turn quiet ON, never off. Writes
# /config/.run.yaml, regenerated on every use.
#
#   release -> album.yaml + import.quiet: no            (prompt with candidates)
#   keep    -> adopt.yaml + import.move: yes            (register a directory as-is)
#   pinned  -> album.yaml + match.strong_rec_thresh 0.3 (the release was chosen
#              with --id: a lone candidate is accepted even when the pressing's
#              own track list or credits differ from the files. Used by `--albums
#              <dir> --id` and as the config pin_files reads its settings from)
#
# The prompting kinds are human-driven runs, so they let reviewed.py turn a
# "use as-is" answer into a marker.
overlay() {  # <release|keep|pinned>
    "${BEET_PY[@]}" "$TOOLS/media_tools.py" overlay "$1"
}

# Make the whole library older than the pipeline's "recent" window.
#
# `added` is set when a row is CREATED. Every row a rebuild, an adopt or an upgrade
# pass creates is therefore "added now", and `media-sync --retag` (weekly) and the
# default `--upgrade` scope (both `added:-4w..`) then see the entire library as new
# downloads: a multi-hour re-match of thousands of tracks that already went through
# it, with the library collapsed for the duration. Stamping the rows added inside
# the window as 29 days old leaves only what arrives afterwards - the nightly
# downloads - inside it. Touches the database only, never a file; run it while
# nothing else writes (media-sync holds the lock).
settle_library() {
    sqlite3 -cmd '.timeout 20000' "$DB" "
        update items set added = strftime('%s','now','-29 days') where added > strftime('%s','now','-28 days');
        update albums set added = strftime('%s','now','-29 days') where added > strftime('%s','now','-28 days');"
    echo "settled: $(count 'added:-4w..') track(s) still count as recent"
}

# Register what is on disk and has no row, then restore the reviewed markers.
adopt_library() {
    register_new /config/adopt.yaml /music
    # A rebuilt library loses the reviewed markers: the flexible field lives only
    # in library.db, but the comments prefix travelled with the files. `beet
    # modify` raises "No matching objects to modify." when its query matches
    # nothing - and a library that has never had a "use as-is" decision has none -
    # so restore only if there is something to restore.
    if [ "$(count 'comments::^reviewed')" -gt 0 ]; then
        "${BEET[@]}" modify -y reviewed=1 'comments::^reviewed'
    fi
}

# Lyrics and ReplayGain for tracks that came in without them (slow; run under
# tmux or --maintenance). media_backfill_exclude is a beets query - `^` negates -
# that keeps a kind of file out of both, e.g. an audiobook.
backfill() {
    "${BEET[@]}" lyrics {{ media_backfill_exclude | quote if media_backfill_exclude else '' }}
    "${BEET[@]}" replaygain -w {{ media_backfill_exclude | quote if media_backfill_exclude else '' }}
}

# --- pinning a release onto files -------------------------------------------------

# The files (container paths, one per line) a beets query selects, sorted.
files_for_query() {  # <beets query...>
    "${BEET[@]}" ls -f '$path' "$@" < /dev/null | LC_ALL=C sort -u
}

# Give the files on stdin (container paths) the MusicBrainz release <id>.
#
# The release is applied to the files directly, not by importing them. An import
# into an album that already has members re-imports those members too and lets
# beets re-assign every track to a slot: a second copy of a track (the same song
# from two sources, both matched) was pushed into the one vacant slot and came out
# retitled as another song. Here each file is matched to a track of the release by
# title, and nothing else is touched - rows keep their ids and flags, other members
# stay exactly as they are.
#
#   - a file whose title is not on the release is left as it is
#   - a file whose track the album already holds (a copy) is left as it is
#   - two files claiming one track: the closer in length takes it
#   - the album row of the release is joined if there is one, created if not
#
# Matched files get the release's tags written and are moved to where the album
# keeps its files; a new album also gets its cover art. Prints a summary and a
# line per file left alone.
pin_files() {  # <release id>
    local id="$1" paths out n=()
    paths="$(cat)"
    [ -n "$paths" ] || { echo "pin: no files given"; return 0; }
    overlay pinned
    out="$(printf '%s\n' "$paths" | "${BEET_PY[@]}" "$TOOLS/media_tools.py" pin "$id")" ||
        { printf '%s\n' "$out"; return 1; }
    printf '%s\n' "$out" | grep -v '^@' || true
    if printf '%s\n' "$out" | grep -q '^@album '; then
        mapfile -t n < <(printf '%s\n' "$out" | sed -n 's/^@pinned //p')
        album_art "$id" "${n[@]}"
    fi
}

# A new album row has no cover yet: fetch it, then embed it in the album's new files.
# Best effort - a release with no art on the Cover Art Archive is not an error.
album_art() {  # <release id> <item id>...
    local id="$1" n
    shift
    "${BEET[@]}" fetchart -q "mb_albumid:$id" < /dev/null || true
    for n in "$@"; do
        "${BEET[@]}" embedart -y "id:$n" < /dev/null || true
    done
}

# Albums where most tracks found their release and some did not, as the plan
# `media-sync --complete` acts on: lines of <release id> TAB <album> TAB <path>.
# An album qualifies with one release id among its matched tracks, at least three
# of them, and no more bare tracks than matched ones. A bare track is only
# included if its title is a track of that release - fetched from MusicBrainz -
# so a bonus track or a different song under the same album tag stays out. A bare
# track whose title a matched track of the album already has is a second copy of
# it (another download, the other format): pinning it would put the same track
# into the album twice, so it is left alone and counted on stderr.
complete_plan() {
    "${BEET_PY[@]}" "$TOOLS/media_tools.py" plan --mb-url "$MB_URL" --cache "$REVIEW/mb-cache"
}

# What the nightly release pass left half placed (see media_audit.py), written to
# $LIB/state/review/candidates.json; changes nothing in the library. The files with
# no row come from unregistered_files, so the audit and the adopt agree on them; the
# audit lists /downloads itself.
audit_library() {
    local loose
    loose="$(unregistered_files /music)" || return 1
    printf '%s\n' "$loose" | "${BEET_PY[@]}" "$TOOLS/media_audit.py" --mb-url "$MB_URL" --review "$REVIEW" \
        --downloads /downloads
}

# The saved review decisions, applied in one container (see media_apply.py). Lines
# starting with @ are for album_art; the rest is the report. Exit 3: refused, over
# the per-run file limit.
apply_decisions() {  # [--dry-run] [--force]
    "${BEET_PY[@]}" "$TOOLS/media_apply.py" apply --review "$REVIEW" \
        --max-files {{ media_apply_max_files }} "$@"
}

# Take an apply back from its log (a file name in $LIB/state/review/apply-log).
undo_apply() {  # <log file name>
    "${BEET_PY[@]}" "$TOOLS/media_apply.py" undo "$REVIEW/apply-log/$1"
}

# An apply rewrites tags and moves files, so it runs only with a fresh restic snapshot
# to fall back on, and never while restic is reading the library (a file moved
# mid-backup can be in neither place in that snapshot). systemd knows both, for the
# stack user too; --timestamp=unix because the default format ends in a zone name
# date(1) is not sure to parse. A unit that has not run since boot has no exit time:
# that counts as no snapshot.
backup_gate() {
    local unit="backup-{{ media_restic_service_name }}.service" state result ended age
    state="$(systemctl show -p ActiveState --value "$unit")"
    case "$state" in
        active | activating | deactivating | reloading)
            echo "the restic backup is running ($unit is $state)"
            return 1 ;;
    esac
    result="$(systemctl show -p Result --value "$unit")"
    ended="$(systemctl show --timestamp=unix -p ExecMainExitTimestamp --value "$unit")"
    if [ "$result" != success ] || [ -z "$ended" ]; then
        echo "no successful restic backup since boot ($unit: ${result:-no result})"
        return 1
    fi
    age=$(( ($(date +%s) - ${ended#@}) / 3600 ))
    if [ "$age" -ge {{ media_apply_backup_max_age_hours }} ]; then
        echo "the last restic backup finished $age h ago (the limit is {{ media_apply_backup_max_age_hours }} h)"
        return 1
    fi
}
