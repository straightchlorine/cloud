#!/usr/bin/env bash
# media-import - the INTERACTIVE half of the pipeline. A wrapper: every pass,
# overlay and beets invocation lives in media-sync (see its header), so there is
# nothing to keep in sync here. Needs a terminal.
#
#   media-import [<dir>]            the nightly two passes, but the singleton one
#                                   asks per track (Apply / as-is / Skip / ...)
#   media-import --review [<dir>]   a full review session: the release pass asks
#                                   per file, then the singleton pass asks per
#                                   track - the way to accept a near miss the
#                                   automatic run refused
#   media-import --singles [<dir>]  the judging pass on its own - after a nightly
#                                   run, go straight to the leftovers
#   media-import --release [<dir>]  the RELEASE pass asking per track - for the
#                                   near misses automatic matching refuses (a
#                                   match just under the strong threshold)
#
# Answering "use as-is" marks the track reviewed (see reviewed.py), so no later
# `--upgrade`/`--retag` re-matches something you chose to keep as it is.
# Ctrl-C stops it cleanly and says so; nothing is half-applied.
set -euo pipefail

if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "media-import needs an interactive terminal - run it from a shell." >&2
    exit 2
fi

mode=--interactive
case "${1:-}" in
    --singles | --release | --review)
        mode="$1"
        shift
        ;;
esac

exec /usr/local/bin/media-sync "$mode" "${1:-/downloads}"
