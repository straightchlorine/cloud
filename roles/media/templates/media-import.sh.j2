#!/usr/bin/env bash
# media-import - the interactive half of the pipeline. A wrapper: every pass,
# overlay and beets invocation lives in media-sync (see its header), so there is
# nothing to keep in sync here. Needs a terminal.
#
#   media-import [<dir>]            a review session: the release pass asks per
#                                   file (pick a candidate by number, E to search
#                                   MusicBrainz, I for a release id), then the
#                                   singleton pass asks per track
#   media-import --singles [<dir>]  the judging pass on its own - after a nightly
#                                   run, go straight to the leftovers
#   media-import --release [<dir>] [--id <release>]
#                                   the release pass asking, on its own; --id
#                                   offers only that MusicBrainz release
#   media-import --interactive [<dir>]  the nightly pairing (quiet release pass,
#                                   then the singleton pass) but asking per track
#   media-import --library [<query>]
#                                   the existing library: decide, one screen at a
#                                   time, what `media-sync --audit` found
#                                   (media_review.py); choices are saved for
#                                   `media-sync --apply`
#   media-import --quarantine <row id>...
#                                   queue files to be moved aside (pick remove)
#
# Answering "use as-is" marks the track reviewed (see reviewed.py), so no later
# `--upgrade`/`--retag` re-matches something you chose to keep as it is.
# Ctrl-C stops it cleanly; nothing is half-applied.
set -euo pipefail

# The library review runs on the host's python, not in a beets container: it reads
# the library with sqlite, so each prompt is instant. No lock: it writes nothing but
# decisions, under their own lock, and the apply checks each before acting.
case "${1:-}" in
    --library | --quarantine)
        # shellcheck source=/dev/null
        . "$(dirname "$(readlink -f "$0")")/media-lib.sh"
        cmd=review
        [ "$1" = --library ] || cmd=quarantine
        shift
        review_args=(--review "$LIB/state/review" --db "$DB" --music "$LIB/music")
        # the apply's file limit, so the end-of-session summary can say when --force is needed
        [ "$cmd" = quarantine ] || review_args+=(--mb-url "$MB_URL" --downloads "$LIB/downloads"
            --max-files {{ media_apply_max_files }})
        exec python3 "$LIB/beets/tools/media_review.py" "$cmd" "${review_args[@]}" "$@" ;;
esac

if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "media-import needs an interactive terminal - run it from a shell." >&2
    exit 2
fi

mode=--review
case "${1:-}" in
    --singles | --release | --review | --interactive)
        mode="$1"
        shift
        ;;
esac

# The directory and --id travel on to the engine, which owns their defaults and
# validation.
exec /usr/local/bin/media-sync "$mode" "$@"
