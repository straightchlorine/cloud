#!/usr/bin/env bash
# media-import - resolve downloads/ (or a given dir) in one go:
#   1. ALBUM (release) pass  - matches whole albums AND single tracks to a
#      MusicBrainz release (strong: the album name + tracklist, ignoring what a
#      YouTube rip cannot know - see album.yaml), so they get the release's
#      year, release ID, track numbers and Cover Art Archive art. Unattended:
#      only strong matches are applied.
#   2. SINGLETON pass        - interactive, per track, for whatever is left (a
#      track lookup carries no album-level metadata, by design).
# Run it whenever you have time. Needs an interactive terminal.
#
#   media-import              process /downloads
#   media-import <dir>        process another directory
set -euo pipefail

COMPOSE=(docker compose -f "{{ media_home }}/docker-compose.yml")
BEET=("${COMPOSE[@]}" run --rm -it --entrypoint /lsiopy/bin/beet beets)
TARGET="${1:-/downloads}"

if [ ! -t 0 ] || [ ! -t 1 ]; then
    echo "media-import needs an interactive terminal - run it from a shell." >&2
    exit 2
fi

echo "== media-import: album (release) pass =="
# One FILE at a time: a shared or wrong album tag over many files groups
# unrelated tracks into one "album", and beets scores such a group against the
# tracks the release does not have. Per file, the release that actually contains
# the track wins. See album.yaml.
"${COMPOSE[@]}" run --rm -T -e PYTHONUNBUFFERED=1 --entrypoint /bin/sh beets -c '
    for track in "$1"/*; do
        [ -f "$track" ] || continue
        /lsiopy/bin/beet --config /config/album.yaml import "$track"
    done' media-import "$TARGET" || true

echo "== media-import: singleton pass =="
exec "${BEET[@]}" --config /config/interactive.yaml import "$TARGET"
