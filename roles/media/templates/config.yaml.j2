# Paths are inside the beets container (see media_compose_services).
directory: /music
library: /config/library.db
statefile: /config/state.pickle

import:
    quiet: yes
    move: yes
    write: yes
    # YouTube tracks are single songs, never whole releases.
    singletons: yes
    # Unmatched tracks are SKIPPED and left in downloads/ so the nightly
    # unattended run imports only clean MusicBrainz matches; run `media-import`
    # (interactive) to resolve whatever is left.
    quiet_fallback: skip
    duplicate_action: keep
    resume: no
    log: /config/import.log

# Navidrome groups by tags only; paths just keep music/ browsable.
paths:
    default: $albumartist/$album%aunique{}/%if{$track,$track }$title
    singleton: $artist/$title
    comp: Compilations/$album%aunique{}/%if{$track,$track }$title

plugins: lyrics replaygain duplicates chroma musicbrainz lastgenre fetchart embedart

lyrics:
    auto: yes
    # lrclib matches on duration, so a slowed/sped-up edit gets no lyrics
    # rather than the original's mistimed ones.
    sources: [lrclib]
    synced: yes

# Opus gets R128_* tags, everything else REPLAYGAIN_*; Navidrome reads both.
replaygain:
    auto: yes
    backend: ffmpeg
    threads: 2

# Acoustic fingerprinting (Chromaprint/AcoustID, resolved through MusicBrainz):
# matches by how the audio sounds, so popular tracks resolve even when the text
# tags alone yield no autotagger candidate. Requires fpcalc + pyacoustid (both
# ship in the linuxserver/beets image); imports get slower (fingerprinting is
# CPU-heavy on a Pi).
chroma:
    auto: yes

# Genres from Last.fm (whitelist-filtered). force: yes replaces yt-dlp's useless
# "Music" genre with real ones; count keeps a few, comma-separated.
lastgenre:
    auto: yes
    force: yes
    count: 3

# Official cover art from the Cover Art Archive (reached via the MusicBrainz
# match), which replaces yt-dlp's video thumbnail; embedart writes the chosen
# art back into the file. Sources are tried in order.
fetchart:
    auto: yes
    sources:
        - coverart
        - itunes
embedart:
    auto: yes
    maxwidth: 1200
