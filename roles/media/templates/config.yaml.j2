# Paths are inside the beets container (see media_compose_services).
directory: /music
library: /config/library.db
statefile: /config/state.pickle

import:
    quiet: yes
    move: yes
    write: yes
    # YouTube tracks are single songs, never whole releases.
    singletons: yes
    # Unmatched tracks are skipped and left in downloads/, so the unattended run
    # imports only clean matches; `media-import` resolves the rest.
    quiet_fallback: skip
    duplicate_action: keep
    resume: no
    log: /config/import.log

# A new item has no data source, so it always differs from the MusicBrainz candidate
# and takes a fixed penalty of about 0.11. That is enough to push a perfect match past
# `strong_rec_thresh` and get it skipped in quiet mode. Zeroing the `data_source`
# weight avoids that, and the key is `data_source`, not `source`.
match:
    distance_weights:
        data_source: 0

# Navidrome groups by tags only; paths just keep music/ browsable.
paths:
    default: $albumartist/$album%aunique{}/%if{$track,$track }$title
    singleton: $artist/$title
    comp: Compilations/$album%aunique{}/%if{$track,$track }$title

# The reviewed plugin marks a "use as-is" answer, and only runs when an overlay sets
# `reviewed.mark: yes`.
# permissions (defaults 644/755): fetchart saves art through a 0600 temp file, which
# Navidrome's remapped uid cannot read, so every cover.jpg was skipped.
plugins: lyrics replaygain duplicates chroma musicbrainz lastgenre fetchart embedart reviewed permissions
pluginpath: /config/plugins

lyrics:
    auto: yes
    # lrclib matches on duration, so a slowed/sped-up edit gets no lyrics
    # rather than the original's mistimed ones.
    sources: [lrclib]
    synced: yes

# Opus gets R128_* tags, everything else REPLAYGAIN_*; Navidrome reads both.
replaygain:
    auto: yes
    backend: ffmpeg
    threads: 2

# Acoustic fingerprinting (Chromaprint/AcoustID, resolved through MusicBrainz) matches
# by how the audio sounds, so popular tracks resolve even when the text tags give no
# candidate. It needs fpcalc and pyacoustid, which the linuxserver/beets image ships.
# Fingerprinting is CPU-heavy on a Pi, so imports are slower.
chroma:
    auto: yes

# Genres come from Last.fm, filtered by the whitelist. `force: yes` replaces yt-dlp's
# generic "Music" genre, and `count` caps how many genres are kept.
lastgenre:
    auto: yes
    force: yes
    count: 3

# Official cover art from the Cover Art Archive (reached via the MusicBrainz
# match), which replaces yt-dlp's video thumbnail; embedart writes the chosen
# art back into the file. Sources are tried in order.
fetchart:
    auto: yes
    # Cover Art Archive originals average 2.5 MB; 1200 matches embedart and is more
    # than Navidrome ever serves.
    maxwidth: 1200
    sources:
        - coverart
        - itunes
embedart:
    auto: yes
    maxwidth: 1200
