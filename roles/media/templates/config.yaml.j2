# Paths are inside the beets container (see media_compose_services).
directory: /music
library: /config/library.db
statefile: /config/state.pickle

import:
    quiet: yes
    move: yes
    write: yes
    # YouTube tracks are single songs, never whole releases.
    singletons: yes
    # No confident MusicBrainz match: import with the tags yt-dlp wrote
    # rather than leaving the file stranded in downloads/.
    quiet_fallback: asis
    # Never delete on import; `beet duplicates` lists them for review.
    duplicate_action: keep
    resume: no
    log: /config/import.log

# Navidrome groups by tags only; paths just keep music/ browsable.
paths:
    default: $albumartist/$album%aunique{}/%if{$track,$track }$title
    singleton: $artist/$title
    comp: Compilations/$album%aunique{}/%if{$track,$track }$title

plugins: lyrics replaygain duplicates

# Embedded into the files (import.write), where Navidrome reads them.
lyrics:
    auto: yes
    # lrclib matches on duration, so a slowed/sped-up edit gets no lyrics
    # rather than the original's mistimed ones.
    sources: [lrclib]
    synced: yes

# Opus gets R128_* tags, everything else REPLAYGAIN_*; Navidrome reads both.
replaygain:
    auto: yes
    backend: ffmpeg
    threads: 2
