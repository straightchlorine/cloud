{# The upgrade overlay: the album overlay plus one line.

   `upgrade_releases` re-imports bare tracks through it for `media-sync --upgrade`,
   `--retag` and the maintenance flow. config.yaml sets lastgenre.force: yes, which
   would replace genres in library.db and in the files; a re-match must not rewrite
   metadata it was not asked to change.

   It is its own overlay because album.yaml also serves the nightly release pass,
   where new downloads should get Last.fm genres.
#}
{% include "album.yaml.j2" %}
lastgenre:
    auto: no
