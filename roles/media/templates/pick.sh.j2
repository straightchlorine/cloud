#!/bin/sh
# pick on the media host runs roles/media/files/pick-core.sh locally, the same tool
# a workstation uses, so it needs no ssh and no host argument:
#   pick remove [<query>]   pick fix [<query>]   pick album <query>
PICK_LOCAL=1 LIB="{{ media_library_path }}" exec "{{ media_home }}/scripts/pick-core.sh" "$@"
