# Merged over config.yaml by `media-import-album`: ALBUM (release) mode. beets
# groups the files in the target by their album tag and matches each group to a
# whole MusicBrainz release, so a full ripped CD (or a complete downloaded
# album) gets album / albumartist / track-number / release metadata. Partial
# sets and singles find no release match and stay in downloads/ for the
# singleton path (media-sync / media-import). quiet + skip are inherited.
import:
    singletons: no
