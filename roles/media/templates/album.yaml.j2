# Merged over config.yaml by every ALBUM (release) import: the release pass at
# the start of `media-sync` and of `media-import`, `media-import-album`, and
# `media-sync --upgrade`. beets groups the target's files by their album tag and
# matches each group to a whole MusicBrainz release, so a ripped CD (or a
# downloaded album) gets album / albumartist / track-number / release metadata -
# and, unlike a singleton import, real Cover Art Archive art (fetchart only runs
# for releases). quiet + skip are inherited from config.yaml.
import:
    singletons: no

# A YouTube rip is ONE track taken out of a release, so the release match must
# not be punished for what YouTube never told us. Each weight zeroed here is a
# "we cannot know this" component (`data_source` is zeroed in config.yaml for
# the same reason); the components that carry real signal - album name, artist,
# track title, track length - keep their defaults.
match:
    distance_weights:
        # One track of a 30-track release is not "29 tracks missing": missing
        # tracks are exactly what a partial album means.
        missing_tracks: 0
    preferred:
        # Digital Media first, CD second, anything else last: a cassette/vinyl
        # reissue must never win. (The 2015 CD of Volume Alpha lost to the 2011
        # digital release this way.)
        media: ['Digital Media', 'CD']
        # Prefer the EARLIEST release of the group. Every pressing that contains
        # the track scores identically, so without this the winner is arbitrary -
        # and tracks of one album then land on different editions, with different
        # titles, splitting one album into several in Navidrome. This also routes
        # the year through `album_info`, so yt-dlp's upload date never takes part
        # in the distance and no `year: 0` override is needed.
        original_year: yes
    # `unmatched_tracks` is deliberately LEFT at its default (0.6). It is the
    # opposite signal, and the useful one: a group holding files the release does
    # NOT have is a bad group (a playlist where every file shares one album tag),
    # and the penalty is what steers the match to the release that actually
    # contains our files rather than, say, a reissue missing a third of them.
    # Belt and braces for the zero weight: it already drops `missing_tracks` from
    # `Distance.keys()` (items() only reports non-zero penalties), so the max-rec
    # downgrade cannot fire - pinned in case a future beets changes that.
    max_rec:
        missing_tracks: strong

# Write the album's ORIGINAL year - the release group's first release - and not
# the year of whichever pressing the match landed on, so a track from a 2013
# album cannot inherit a 2025 reissue's year.
original_date: yes
