"""Mark a reviewer's "use as-is" answer so later runs leave the track alone.

Deployed to /config/plugins/reviewed.py (see `pluginpath` in config.yaml). It records:

* the flexible field `reviewed`, which `media-sync --upgrade` and `--retag` query
  with `reviewed::^$` (an absent flexible field reads as empty);
* a `reviewed | ` prefix on `comments`, a native field, so the mark is written into
  the file and read back by `--adopt` after a library rebuild. Navidrome shows it too.

It only runs when the overlay sets `reviewed.mark: yes` (see interactive.yaml and the
`media-sync --keep` overlay); the nightly sync and `--adopt` leave it off.
"""

from beets import importer
from beets.plugins import BeetsPlugin

FIELD = "reviewed"
MARK = "reviewed"
PREFIX = MARK + " | "


class ReviewedPlugin(BeetsPlugin):
    """Mark the items of a task the reviewer answered "use as-is" for."""

    def __init__(self):
        super().__init__()
        # confuse's ConfigView.get() raises NotFoundError for a missing key, and
        # most runs import with the flag absent.
        self.config.add({"mark": False})
        # import_task_files fires for every import path, after the files are in
        # place, so this is the one place the decision can be recorded.
        self.register_listener("import_task_files", self.mark_asis)

    def mark_asis(self, session, task):
        if not self.config["mark"].get(bool):
            return
        if task.choice_flag is not importer.Action.ASIS:
            return

        marked = 0
        for item in task.imported_items():
            item[FIELD] = "1"
            if not (item.comments or "").startswith(MARK):
                item.comments = PREFIX + item.comments if item.comments else MARK
            # try_write persists the comments tag (the decision has to outlive
            # library.db); store persists the flexible field.
            item.try_write()
            item.store()
            marked += 1
        self._log.info("{0}: marked {1} item(s)", MARK, marked)
