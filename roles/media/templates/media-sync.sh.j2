#!/usr/bin/env bash
# shellcheck disable=SC2016  # beets format/query strings ('$id', 'mb_albumid::^$',
# 'reviewed::^$') are literal beets syntax, never shell expansion - hence quoted.
# media-sync - the whole YouTube -> yt-dlp -> beets -> Navidrome pipeline. One engine
# for every mode, so the beets invocation, the overlays and the two import passes
# exist once. The README ("Modes") has the longer description of each.
#
#   media-sync                        nightly, from cron: pull the playlists, then
#                                     import what landed (release pass, then a
#                                     singleton pass for the rest)
#   media-sync --retag                weekly, from cron: retry MusicBrainz for recent
#                                     tracks that found no match, and give them
#                                     their release
#   media-sync --upgrade [all|<q>]    give tracks with no release their release
#                                     (last 4 weeks by default)
#   media-sync --albums [<dir>] [--id <release>]
#                                     release pass only, grouped: a ripped CD or a
#                                     complete album in one directory; --id names
#                                     the MusicBrainz release when the pressing
#                                     differs from the files
#   media-sync --keep [<dir>]         register a directory as it is, without
#                                     matching, and mark it reviewed
#   media-sync --adopt                register the files in music/ that have no
#                                     row and restore the reviewed markers (rows
#                                     that exist are not touched)
#   media-sync --regroup              album rows for tracks that carry a release id
#                                     but have none (changes no file)
#   media-sync --pin '<query>' --id <release> [--dry-run]
#                                     give the files a beets query selects one
#                                     MusicBrainz release, in one album row
#   media-sync --complete [--dry-run] finish partly matched albums: give their
#                                     remaining tracks the release the rest found
#   media-sync --fix-text [--dry-run]
#                                     decode HTML-escaped letters in titles, artists
#                                     and albums (YouTube Music "Topic" uploads), in the
#                                     tags and the folder names; the nightly run does it
#                                     for what it imports
#   media-sync --settle               stamp the library as older than the 4-week
#                                     "recent" window (see the README); database only
#   media-sync --audit                find what the release pass left half placed,
#                                     for the library review; changes nothing
#   media-sync --apply [--dry-run] [--force]
#                                     carry out the saved review decisions in one
#                                     batch (the weekly apply, from cron); needs a
#                                     fresh restic backup
#   media-sync --undo <apply log>     take an apply back (state/review/apply-log/)
#   media-sync --removed [--purge]    check removed/ against the library by audio and
#                                     list what is safe to delete; --purge deletes it
#   media-sync --plan                 show what --maintenance would face; changes nothing
#   media-sync --maintenance [--from <1-8>]
#                                     the one-time routine for an existing library,
#                                     with a checkpoint and a resume point (see
#                                     media-maintenance)
#   media-sync --backfill             one-time: lyrics and ReplayGain for adopted
#                                     tracks (slow - run it under tmux)
#   media-sync --interactive [<dir>]  both passes, the singleton one asking per
#                                     track (what `media-import` runs)
#   media-sync --review [<dir>]       a full session: the release pass asking per
#                                     file first (accept a near miss by number, or
#                                     dismiss it), then the singleton pass
#   media-sync --singles [<dir>]      the singleton pass on its own, for the leftovers
#                                     after a nightly run
#   media-sync --release [<dir>]      the release pass asking per track, for the
#                                     near misses automatic matching refuses
#
# The interactive modes need a terminal; run them through `media-import`.
# Ctrl-C stops any mode cleanly; an unattended run (no terminal) also sends one
# ntfy, a manual one just prints (see on_interrupt).
set -euo pipefail

MODE="${1:-sync}"
# The shared module (constants, beets invocation, library operations) sits beside
# this script; readlink -f because the command in PATH is a symlink to it.
# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/media-lib.sh"
# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/media-maintenance.sh"

# After the mode: a directory (or, for --upgrade, a beets query), --id <release>
# for the two release modes, --from <step> for --maintenance.
[ "$#" -eq 0 ] || shift
DIR="" ALBUM_ID="" FROM=1 DRY=0 FORCE=0 PURGE=0 ARGS=()
# FROM is read by media-maintenance, DRY by --complete, --pin and --apply, PURGE by --removed.
# shellcheck disable=SC2034
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1; shift ;;
        --force) FORCE=1; shift ;;
        --purge) PURGE=1; shift ;;
        --id | --from)
            [ "$#" -ge 2 ] || { echo "media-sync $1 needs a value" >&2; exit 2; }
            if [ "$1" = --id ]; then ALBUM_ID="$2"; else FROM="$2"; fi
            shift 2 ;;
        *) DIR="$1"; ARGS+=("$1"); shift ;;
    esac
done
# A release id is typed by a person and ends up in a beets command line: only a
# UUID gets that far, and only for the modes that import a release.
if [ -n "$ALBUM_ID" ]; then
    case "$MODE" in --albums | --release | --pin) ;; *) echo "--id only applies to --albums, --release and --pin" >&2; exit 2 ;; esac
    [[ "$ALBUM_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
        { echo "--id wants a MusicBrainz release id (a UUID), got: $ALBUM_ID" >&2; exit 2; }
fi
[ "$PURGE" = 0 ] || [ "$MODE" = --removed ] || { echo "--purge only applies to --removed" >&2; exit 2; }
case "$MODE" in
    --pin)
        [ -n "$DIR" ] || { echo "usage: media-sync --pin '<beets query>' --id <release> [--dry-run]" >&2; exit 2; }
        [ -n "$ALBUM_ID" ] || { echo "media-sync --pin needs --id <release>" >&2; exit 2; } ;;
esac

# Release pass, one file at a time. downloads/ is a playlist dump, so one album tag
# can cover tracks the release does not have, which beets scores badly. Judged on
# its own, a file can win the release that contains it, and gets the album year,
# release id, track number and Cover Art Archive art (fetchart only runs for
# releases). A track whose album does not contain it is refused and falls through.
# `find` walks the whole tree: downloads/ may hold subdirectories, and a top-level
# glob would hand them all to the singleton pass, which can never carry a release.
# `! -name ".*"` skips hidden files (a half-written .part or thumbnail).
release_pass() {  # [<dir>] [<overlay>] [tty] [<stamp>]
    # `tty` hands beets a terminal so it can ask (used by --review); the default
    # is unattended, where only strong matches are applied and the rest are
    # printed as "Skipping.". With a <stamp> (a container path) only files
    # created after it are taken - the nightly run's own downloads.
    local run=(-T)
    if [ "${3:-}" = tty ]; then
        run=(-it)
    fi
    # Stoppable by one ^C: `sh -c` with a single command execs it, so find would be
    # PID 1, which has no default signal handling. A trap alone is not enough
    # either, because a shell defers traps until its foreground child exits.
    # Backgrounding the loop and waiting lets the trap fire at once, kill find, and
    # the container goes with PID 1.
    "${COMPOSE[@]}" run "${run[@]}" --rm -e PYTHONUNBUFFERED=1 --entrypoint /bin/sh beets -c '
        trap "kill \$pid 2>/dev/null; exit 130" INT TERM
        find "$1" -type f ! -name ".*" ${3:+-cnewer "$3"} \
            -exec /lsiopy/bin/beet --config "$2" import {} \; &
        pid=$!
        wait $pid' \
        release-pass "${1:-/downloads}" "${2:-/config/album.yaml}" "${4:-}"
}

# Run beets interactively and keep this shell alive to catch Ctrl-C: `exec` would
# replace the shell (and its traps) with beets, so the subshell takes the exec
# instead. The subshell is still a proper child, so the terminal is handed over,
# yt-dlp/beets/compose clean up their own containers and an interrupt surfaces
# through on_interrupt as something a human can read.
interactive_pass() {  # <beets args...>
    local status=0
    ( exec "${BEET_TTY[@]}" "$@" ) || status=$?
    exit "$status"
}

# Give already-imported tracks with no release their release. beets only applies
# release metadata during an album import, and `beet import -L` re-imports a
# singleton as a singleton, so the files go to the importer instead: drop the rows
# (no -d, the files stay on disk), then import those paths in album mode.
# `reviewed::^$` leaves the reviewer's decisions alone (reviewed.py writes the
# marker). Anything that finds no release stays out of beets but keeps playing;
# re-register it with `media-sync --adopt`.
# Optional beets query as "$@".
upgrade_releases() {
    local files
    # sort -u: a library can hold several rows for one path. beets moves the file on
    # the first one, and the next task for that path then fails in chroma's
    # fingerprint stage and kills the session. One task per path avoids it.
    mapfile -t files < <("${BEET[@]}" ls -f '$path' 'mb_albumid::^$' 'reviewed::^$' "$@" | sort -u)
    [ -n "${files[*]:-}" ] || return 0
    "${BEET[@]}" remove -f 'mb_albumid::^$' 'reviewed::^$' "$@"
    # upgrade.yaml = album.yaml + `lastgenre: auto: no`: re-matching the existing
    # library must not re-derive (and replace) genres for every file it re-imports.
    # See the overlay's own header.
    "${BEET[@]}" --config /config/upgrade.yaml import "${files[@]}"
}

# upgrade_releases plus the numbers to report. A track that finds no release loses
# its row, so the rows left over do not count the failures; count what gained a
# release and what vanished instead. Sets UPG_BEFORE, UPG_GOT and UPG_DROPPED.
upgrade_report() {  # [<beets query>...]
    local rel_before rel_after bare_after
    UPG_BEFORE="$(count 'mb_albumid::^$' 'reviewed::^$' "$@")"
    rel_before="$(count 'mb_albumid::.' 'reviewed::^$' "$@")"
    upgrade_releases "$@"
    bare_after="$(count 'mb_albumid::^$' 'reviewed::^$' "$@")"
    rel_after="$(count 'mb_albumid::.' 'reviewed::^$' "$@")"
    UPG_GOT=$((rel_after - rel_before))
    UPG_DROPPED=$((UPG_BEFORE - bare_after - UPG_GOT))
}

exec 9>"$LIB/logs/.media-sync.lock"
# One writer at a time, interactive sessions included. An interactive run can hold
# the lock for an hour, so a skipped nightly sync says so instead of staying silent.
flock -n 9 || {
    echo "media-sync already running; skipping this run"
    notify "needs a look" "another media-sync run is in progress; this run skipped." default warning
    exit 0
}

# Ctrl-C / SIGTERM: stop and say so. An unattended run must not just vanish, hence
# the ntfy when there is no terminal. Nothing needs unwinding: flock drops the
# lock with the process, and yt-dlp's archive file means a re-run skips what was
# already downloaded. A file interrupted mid-move is either already renamed
# (downloads/ and music/ are the same filesystem) or still in downloads/, so the
# worst case is a track sitting in music/ that beets has not registered yet -
# `media-sync --adopt` picks it up.
on_interrupt() {
    echo "media-sync ${MODE#--} interrupted; stopping."
    if [ ! -t 0 ]; then
        notify "interrupted" "stopped before finishing - re-run when you can. See $LIB/logs/media-sync.log." default warning
    fi
    exit 130
}
trap on_interrupt INT TERM
trap 'notify failed "Line $LINENO. See $LIB/logs/media-sync.log." high rotating_light,error' ERR

# The interactive modes are for a human at a terminal. Refuse without one before
# anything else happens: the engine must never sit on a prompt nobody can answer.
case "$MODE" in
    --interactive | --review | --singles | --release)
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            echo "media-sync ${MODE#--} needs an interactive terminal - run it from a shell (or use media-import)." >&2
            exit 2
        fi
        ;;
esac

# Watchtower never sees this short-lived container, so pull here; a failed pull keeps the cached image.
"${COMPOSE[@]}" --profile tools pull -q beets || echo "beets pull failed; using the cached image"

case "$MODE" in
    --retag)
        # `reviewed::^$`: a track kept as it is carries no MusicBrainz ids, so this
        # would otherwise re-match it and overwrite the tags it was kept with.
        before="$(count 'mb_trackid::^$' 'reviewed::^$' added:-4w..)"
        "${BEET[@]}" import -L 'mb_trackid::^$' 'reviewed::^$' added:-4w..
        after="$(count 'mb_trackid::^$' 'reviewed::^$' added:-4w..)"
        # A track match carries no release data (year, release id, cover art), so
        # the recent matches get their release too, over the same window.
        upgrade_report added:-4w..
        notify "done" "$((before - after)) of $before recent unmatched track(s) found a MusicBrainz match; $UPG_GOT of $UPG_BEFORE got a release, $UPG_DROPPED found none and are out of beets until 'media-sync --adopt'; they still play."
        exit 0 ;;
    --upgrade)
        # The release half of --retag, on demand. Narrow it with a beets query, or
        # pass `all`.
        case "$DIR" in
            all) scope=() ;;
            '') scope=(added:-4w..) ;;
            *) scope=("$DIR") ;;
        esac
        upgrade_report "${scope[@]}"
        notify "done" "$UPG_GOT of $UPG_BEFORE track(s) got a release; $UPG_DROPPED found none and are out of beets until 'media-sync --adopt'; they still play."
        exit 0 ;;
    --albums)
        # Release pass only, grouped: a complete album (or a ripped CD) is matched
        # as a whole. The nightly run judges every file alone instead, because a
        # playlist dump cannot be trusted to group; see release_pass.
        #
        # --id names the release: a pressing whose track list or credits differ
        # from the files scores below the strong threshold and would be skipped, so
        # the `pinned` overlay accepts the one candidate a person chose.
        if [ -n "$ALBUM_ID" ]; then
            overlay pinned
            exec "${COMPOSE[@]}" run --rm -T -e PYTHONUNBUFFERED=1 \
                --entrypoint /lsiopy/bin/beet beets \
                -c /config/.run.yaml import -S "$ALBUM_ID" "${DIR:-/downloads}"
        fi
        exec "${COMPOSE[@]}" run --rm -T -e PYTHONUNBUFFERED=1 \
            --entrypoint /lsiopy/bin/beet beets \
            --config /config/album.yaml import "${DIR:-/downloads}" ;;
    --keep)
        # Register the files without matching them (adopt.yaml) and move them into
        # music/ so the nightly run stops retrying them; reviewed.py marks them,
        # which keeps --upgrade and --retag away from them later.
        overlay keep
        before="$(count)"
        register_new /config/.run.yaml "${DIR:-/downloads}"
        after="$(count)"
        notify "done" "$((after - before)) new track(s) registered as-is and marked reviewed."
        exit 0 ;;
    --adopt)
        adopt_library
        notify "done" "beets now tracks $(count) track(s) in music/, $(count 'reviewed::.') of them marked reviewed."
        exit 0 ;;
    --backfill)
        backfill
        notify "done" "$(count 'lyrics::.') of $(count) track(s) have lyrics; ReplayGain is set."
        exit 0 ;;
    --regroup)
        # Album rows for tracks that carry a release id but no album row. Changes
        # no file.
        result="$(regroup_albums)"
        echo "$result"
        notify "done" "$result"
        exit 0 ;;
    --pin)
        # Give the files a beets query selects a MusicBrainz release chosen by a
        # person (--id): for an album the per-file pass could not place, or tracks
        # spread over several folders, which a folder import cannot group. They
        # end up in one album row. --dry-run lists the files and stops. Several
        # words make several query terms: --pin 'album:X' 'track:1..5'.
        files="$(files_for_query "${ARGS[@]}")"
        [ -n "$files" ] || { echo "no track matches: ${ARGS[*]}" >&2; exit 1; }
        echo "$(printf '%s\n' "$files" | wc -l) file(s) match: ${ARGS[*]}"
        printf '%s\n' "$files" | head -5
        if [ "$DRY" -eq 1 ]; then
            echo "dry run: nothing changed."
            exit 0
        fi
        before="$(count "mb_albumid:$ALBUM_ID")"
        echo "checkpoint: $(checkpoint)"
        printf '%s\n' "$files" | pin_files "$ALBUM_ID"
        after="$(count "mb_albumid:$ALBUM_ID")"
        notify "done" "$((after - before)) of $(printf '%s\n' "$files" | wc -l) track(s) pinned to release ${ALBUM_ID%%-*}; the rest are unchanged."
        exit 0 ;;
    --complete)
        # Finish partly matched albums: pin the tracks that did not match to the
        # release the rest found, if their title is on it (complete_plan).
        # --dry-run prints the plan and stops. Run --regroup first, so the matched
        # tracks share one album row for the others to join.
        plan="$(complete_plan)"
        [ -n "$plan" ] || { echo "nothing to complete"; notify "done" "no partly matched album found."; exit 0; }
        printf '%s\n' "$plan" | awk -F'\t' '{k = $2 "  (" $1 ")"; n[k]++} END {for (k in n) print n[k] " track(s) -> " k}'
        if [ "$DRY" -eq 1 ]; then
            echo "dry run: nothing changed."
            exit 0
        fi
        echo "checkpoint: $(checkpoint)"
        total=0
        for id in $(printf '%s\n' "$plan" | cut -f1 | sort -u); do
            printf '%s\n' "$plan" | awk -F'\t' -v id="$id" '$1 == id {print $3}' | pin_files "$id"
            total=$((total + $(printf '%s\n' "$plan" | awk -F'\t' -v id="$id" '$1 == id' | wc -l)))
        done
        notify "done" "$total track(s) of $(printf '%s\n' "$plan" | cut -f1 | sort -u | wc -l) album(s) given their release."
        exit 0 ;;
    --audit)
        # Read-only (see media_audit.py); writes state/review/candidates.json.
        # Refuses when MusicBrainz is unreachable, or every lookup would fail
        # slowly and replace a good file with an empty one. Runs under the lock so
        # the library holds still while read.
        musicbrainz_reachable || exit 1
        result="$(audit_library)"
        echo "$result"
        notify "done" "$(printf '%s\n' "$result" | head -1)"
        exit 0 ;;
    --apply)
        # The review decisions in one batch (media_apply.py), weekly from cron, ahead
        # of the retag. Gated on the restic backup unless --force; a dry run changes
        # nothing and needs no gate. With nothing saved it stays quiet.
        [ -z "$DIR" ] || { echo "media-sync --apply takes only --dry-run and --force, not: $DIR" >&2; exit 2; }
        if ! grep -qs '[^[:space:]]' "$LIB/state/review/decisions.jsonl"; then
            echo "apply: no decisions to apply"
            exit 0
        fi
        apply_args=()
        [ "$DRY" = 0 ] || apply_args+=(--dry-run)
        [ "$FORCE" = 0 ] || apply_args+=(--force)
        if [ "$DRY" = 0 ] && [ "$FORCE" = 0 ] && ! why="$(backup_gate)"; then
            echo "apply: skipped - $why"
            notify "skipped" "$why. Nothing was applied. The decisions wait for the next run, or run 'media-sync --apply --force'." default warning
            exit 0
        fi
        [ "$DRY" = 1 ] || echo "checkpoint: $(checkpoint)"
        rc=0
        out="$(apply_decisions "${apply_args[@]}")" || rc=$?
        printf '%s\n' "$out" | grep -v '^@' || true
        while read -r _ release ids; do
            # shellcheck disable=SC2086  # item ids: numbers, one word each
            album_art "$release" $ids
        done < <(printf '%s\n' "$out" | grep '^@art ' || true)
        summary="$(printf '%s\n' "$out" | grep '^apply: ' | tail -1 || true)"
        summary="${summary:-media_apply.py exited $rc without a report}"
        case "$rc" in
            0) [ "$DRY" = 1 ] || notify "done" "$summary" ;;
            3 | 4) [ "$DRY" = 1 ] || notify "needs a look" "$summary" default warning ;;
            *)
                log="$(printf '%s\n' "$out" | sed -n 's/^apply: logging to .*(media-sync --undo \([^ ]*\) takes it back)$/\1/p')"
                notify "failed" "Stopped halfway (exit $rc). ${log:+Undo it with: media-sync --undo $log. }See $LIB/logs/media-sync.log." high rotating_light,error
                exit 1 ;;
        esac
        exit 0 ;;
    --undo)
        # Take an apply back, from its log in state/review/apply-log.
        name="$(basename "${DIR:-}")"
        # one argument: DIR holds the last one given, ARGS all of them (no array
        # length here: its brace-hash would open a Jinja comment)
        if [ -z "$DIR" ] || [ "${ARGS[*]}" != "$DIR" ] || [ "$DRY" = 1 ] || [ "$FORCE" = 1 ] ||
            [ ! -f "$LIB/state/review/apply-log/$name" ]; then
            echo "usage: media-sync --undo <apply log> - one of: $(find "$LIB/state/review/apply-log" -maxdepth 1 \
                -name '*.jsonl' ! -name '*.undone.jsonl' -printf '%f ' 2> /dev/null)" >&2
            exit 2
        fi
        echo "checkpoint: $(checkpoint)"
        rc=0
        result="$(undo_apply "$name")" || rc=$?
        echo "$result"
        if [ "$rc" = 0 ]; then
            notify "done" "$(printf '%s\n' "$result" | tail -1)"
        else
            notify "failed" "Exit $rc: $(printf '%s\n' "$result" | tail -1). See $LIB/logs/media-sync.log." high rotating_light,error
        fi
        exit "$rc" ;;
    --removed)
        # Read-only unless --purge (see media_removed.py): it fingerprints every audio
        # file in removed/, so the first run over a big quarantine takes a while. --purge
        # asks for nothing more than itself: the report is the review, and every file it
        # deletes is printed. Under the lock so the library holds still while read.
        if [ -n "$DIR" ] || [ "$DRY" = 1 ] || [ "$FORCE" = 1 ]; then
            echo "media-sync --removed takes only --purge" >&2
            exit 2
        fi
        purge_args=()
        [ "$PURGE" = 0 ] || purge_args+=(--purge)
        result="$(check_removed "${purge_args[@]}")"
        echo "$result"
        notify "done" "$(printf '%s\n' "$result" | tail -1)"
        exit 0 ;;
    --fix-text)
        # See fix_text. A dry run lists the changes and moves nothing.
        [ -z "$DIR" ] && [ "$FORCE" = 0 ] || { echo "media-sync --fix-text takes only --dry-run" >&2; exit 2; }
        if [ "$DRY" = 1 ]; then result="$(fix_text dry)"; else result="$(fix_text)"; fi
        if [ -z "$result" ]; then
            echo "fix-text: nothing to fix"
        else
            echo "$result"
            [ "$DRY" = 1 ] || notify "done" "$(printf '%s\n' "$result" | tail -1)"
        fi
        exit 0 ;;
    --settle)
        # See settle_library.
        echo "checkpoint: $(checkpoint)"
        result="$(settle_library)"
        echo "$result"
        notify "done" "$result"
        exit 0 ;;
    --plan)
        # What --maintenance would face, changing nothing.
        maintenance_plan || exit 1
        exit 0 ;;
    --maintenance)
        # The one-time routine for an existing library, with a checkpoint and a
        # resume point; see media-maintenance.
        maintenance
        exit 0 ;;
    --review)
        # A full session: the release pass with prompts, then the singleton pass.
        # Releases go first because a track match can never supply the year,
        # release id, track numbers or cover art, and the singleton pass cannot
        # reach an album afterwards.
        overlay release
        echo "== media-import: album (release) pass, asking =="
        release_pass "${DIR:-/downloads}" /config/.run.yaml tty || true
        echo "== media-import: singleton pass =="
        interactive_pass --config /config/interactive.yaml import "${DIR:-/downloads}" ;;
    --singles)
        # The singleton pass on its own: after a nightly run the release pass has
        # had its say, so this goes straight to the leftovers.
        interactive_pass --config /config/interactive.yaml import "${DIR:-/downloads}" ;;
    --interactive)
        # Both passes, the singleton one interactive (what `media-import` runs).
        echo "== media-import: album (release) pass =="
        release_pass "${DIR:-/downloads}" /config/album.yaml || true
        echo "== media-import: singleton pass =="
        interactive_pass --config /config/interactive.yaml import "${DIR:-/downloads}" ;;
    --release)
        # The release pass with prompts, for near misses automatic matching refuses
        # (a correct release can score 0.05 against the 0.04 `strong_rec_thresh`).
        # Answering as-is marks the track.
        overlay release
        if [ -n "$ALBUM_ID" ]; then
            interactive_pass -c /config/.run.yaml import -S "$ALBUM_ID" "${DIR:-/downloads}"
        fi
        interactive_pass -c /config/.run.yaml import "${DIR:-/downloads}" ;;
    sync) ;;
    *)
        echo "usage: media-sync [mode]"
        echo "  modes: --retag --upgrade [all|<query>] --albums [<dir>] [--id <release>] --keep [<dir>]"
        echo "         --adopt --regroup --audit --apply [--dry-run] [--force] --undo <log> --settle"
        echo "         --removed [--purge] --fix-text [--dry-run]"
        echo "         --pin '<query>' --id <release> [--dry-run] --complete [--dry-run] --backfill"
        echo "         --plan --maintenance [--from <1-8>] --interactive [<dir>] --review [<dir>]"
        echo "         --singles [<dir>] --release [<dir>] [--id <release>]"
        echo "  no mode: the nightly sync. The header of this script describes each mode."
        exit 2 ;;
esac

mapfile -t playlists < <(grep -v '^\s*$' "{{ media_home }}/config/playlists.txt")

# Only what this run downloads goes through the two passes. A leftover was judged
# the night it arrived and would be judged the same again, at about a minute a file
# (fingerprint and lookups, twice), so leftovers wait for media-import. The stamp
# marks the end of the last run that got through its passes, so an interrupted
# night's downloads are taken the next night; it is hidden so the passes never see
# it. ctime, because yt-dlp may set mtime to the upload date.
stamp="$LIB/downloads/.last-sync"
[ -e "$stamp" ] || touch "$stamp"
fresh() { find "$LIB/downloads" -type f ! -name '.*' -cnewer "$stamp" -printf '/downloads/%P\n'; }

# yt-dlp exits non-zero when a single video is gone; that is expected, as is what
# needs an account (age-restricted, members-only). Other errors alert.
run_log="$(mktemp)"
trap 'rm -f "$run_log"' EXIT
for url in "${playlists[@]}"; do
    yt-dlp --config-location "{{ media_home }}/config/yt-dlp.conf" "$url" 2>&1 | tee -a "$run_log" || true
done
errors="$(grep '^ERROR:' "$run_log" \
    | grep -cvE 'Video unavailable|Private video|video has been removed|not available in your country|members-only|Sign in to confirm your age' \
    || true)"

new="$(fresh | wc -l)"
if [ "$new" -gt 0 ]; then
    # Release pass, one file at a time (see release_pass), then a singleton pass
    # for whatever is left.
    release_pass /downloads /config/album.yaml "" /downloads/.last-sync
    # Singleton pass: a per-track MusicBrainz match for what is left. A track
    # lookup carries no album-level metadata, so this is the fallback.
    mapfile -t rest < <(fresh)
    if [ -n "${rest[*]:-}" ]; then
        "${BEET[@]}" import "${rest[@]}"
    fi
fi
left="$(fresh | wc -l)"
older=$(( $(find "$LIB/downloads" -type f ! -name '.*' | wc -l) - left ))
touch "$stamp"

# Decode HTML-escaped letters in what came in; silent when nothing changes.
fix_failed=0
fixes="$(fix_text)" || fix_failed=1
[ -z "$fixes" ] || echo "$fixes"
fixed="$(printf '%s\n' "$fixes" | grep -c ' -> ' || true)"

summary="$(grep -cv '^\s*$' "{{ media_home }}/config/playlists.txt") playlist(s): $((new - left)) track(s) imported, $left left in downloads/, $errors unexpected yt-dlp error(s)."
if [ "$older" -gt 0 ]; then
    summary="$summary $older older track(s) wait for media-import."
fi
if [ "$fixed" -gt 0 ]; then
    summary="$summary $fixed escaped text field(s) fixed."
fi
if [ "$fix_failed" = 1 ]; then
    summary="$summary The text fix failed."
fi
if [ "$errors" -gt 0 ] || [ "$left" -gt 0 ] || [ "$fix_failed" = 1 ]; then
    notify "needs a look" \
        "$summary Run 'media-import' to resolve what is left, interactively. See $LIB/logs/media-sync.log." \
        default warning
else
    notify "done" "$summary"
fi
