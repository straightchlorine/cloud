#!/usr/bin/env bash
# shellcheck disable=SC2016  # beets format/query strings ('$id', 'mb_albumid::^$',
# 'reviewed::^$') are literal beets syntax, never shell expansion - hence quoted.
# media-sync - the whole YouTube -> yt-dlp -> beets -> Navidrome pipeline, one
# engine for every mode, so the beets invocation, the overlays and the two
# import passes exist exactly once:
#
#   media-sync                        nightly: pull the playlists, then import
#                                     whatever landed (release pass, then a
#                                     singleton pass for the rest)  [cron 01:00]
#   media-sync --retag                retry MusicBrainz for recent as-is imports
#                                     and give them their release [cron Sun 4:15]
#   media-sync --upgrade [all|<q>]    give bare tracks their release (last 4
#                                     weeks by default)
#   media-sync --albums [<dir>] [--id <release>]
#                                     release pass only, grouped: a ripped CD or
#                                     a complete album dropped in one directory;
#                                     --id pins the MusicBrainz release when the
#                                     pressing differs from the files
#   media-sync --keep [<dir>]         register a directory as-is (no matching)
#                                     and mark it reviewed, so nothing re-matches
#                                     it later
#   media-sync --adopt                register the files in music/ that have no
#                                     row, restore the reviewed markers (rows that
#                                     exist are never touched)
#   media-sync --regroup              album rows for tracks that carry a release
#                                     id but have none (changes no file)
#   media-sync --pin '<query>' --id <release> [--dry-run]
#                                     give the files a beets query selects one
#                                     MusicBrainz release, into one album row
#   media-sync --complete [--dry-run] finish partly matched albums: pin their
#                                     bare tracks to the release the rest found
#   media-sync --settle               stamp the library as older than the 4-week
#                                     "recent" window (after a rebuild, so --retag
#                                     does not re-match all of it); DB only
#   media-sync --plan                 what --maintenance would face; changes nothing
#   media-sync --maintenance [--from <1-8>]
#                                     the one-time routine for an existing library:
#                                     adopt, prune, upgrade, adopt, regroup,
#                                     complete, settle, backfill - with a checkpoint
#                                     and a resume point (media-maintenance)
#   media-sync --backfill             one-time: lyrics + ReplayGain for adopted
#                                     tracks (slow - run it under tmux)
#   media-sync --interactive [<dir>]  both passes, the singleton one asking per
#                                     track (this is what `media-import` runs)
#   media-sync --review [<dir>]       a full session: the release pass asking per
#                                     file first (accept a near miss by number, or
#                                     dismiss it), then the singleton pass
#   media-sync --singles [<dir>]      just the judging pass - what you want in the
#                                     morning after a nightly run, instead of
#                                     waiting through a release pass that would
#                                     find nothing new
#   media-sync --release [<dir>]      the RELEASE pass asking per track - for the
#                                     near misses automatic matching refuses
#
# The interactive modes need a terminal; run them through `media-import`.
# Ctrl-C stops any mode cleanly and says so: an unattended run (no terminal) also
# sends one ntfy, a manual one just prints (see on_interrupt).
set -euo pipefail

MODE="${1:-sync}"
# The shared module (constants, beets invocation, library operations) sits beside
# this script; readlink -f because the command in PATH is a symlink to it.
# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/media-lib.sh"
# shellcheck source=/dev/null
. "$(dirname "$(readlink -f "$0")")/media-maintenance.sh"

# After the mode: a directory (or, for --upgrade, a beets query), --id <release>
# for the two release modes, --from <step> for --maintenance.
[ "$#" -eq 0 ] || shift
DIR="" ALBUM_ID="" FROM=1 DRY=0 ARGS=()
# FROM is read by media-maintenance, DRY by --complete and --pin.
# shellcheck disable=SC2034
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1; shift ;;
        --id | --from)
            [ "$#" -ge 2 ] || { echo "media-sync $1 needs a value" >&2; exit 2; }
            if [ "$1" = --id ]; then ALBUM_ID="$2"; else FROM="$2"; fi
            shift 2 ;;
        *) DIR="$1"; ARGS+=("$1"); shift ;;
    esac
done
# A release id is typed by a person and ends up in a beets command line: only a
# UUID gets that far, and only for the modes that import a release.
if [ -n "$ALBUM_ID" ]; then
    case "$MODE" in --albums | --release | --pin) ;; *) echo "--id only applies to --albums, --release and --pin" >&2; exit 2 ;; esac
    [[ "$ALBUM_ID" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
        { echo "--id wants a MusicBrainz release id (a UUID), got: $ALBUM_ID" >&2; exit 2; }
fi
case "$MODE" in
    --pin)
        [ -n "$DIR" ] || { echo "usage: media-sync --pin '<beets query>' --id <release> [--dry-run]" >&2; exit 2; }
        [ -n "$ALBUM_ID" ] || { echo "media-sync --pin needs --id <release>" >&2; exit 2; } ;;
esac

# ALBUM (release) pass, one FILE at a time. downloads/ is a playlist dump, so
# many files can share one (or the wrong) album tag; a group like that holds
# tracks the release does not have, which beets scores badly - and rightly so.
# Judging each file on its own lets the release that actually CONTAINS the track
# win, so it gets the album year, release ID, track number and Cover Art Archive
# art (fetchart only runs for releases, so a singleton never gets it). A track
# whose "album" does not contain it is refused and falls through.
# WALK THE WHOLE TREE: downloads/ is not necessarily flat. A per-artist or
# per-playlist subdirectory (older yt-dlp templates, a hand-dropped album) with a
# top-level glob hands this pass NOTHING, and every nested file then falls to the
# singleton pass - which by design can never carry a release. find -exec keeps
# the one-file-at-a-time property, needs no shell loop and survives odd
# filenames; `! -name ".*"` keeps the old glob's habit of ignoring hidden files
# (a half-written .part or thumbnail).
release_pass() {  # [<dir>] [<overlay>] [tty]
    # `tty` hands beets a terminal so it can ask (used by --review); the default
    # is unattended, where only strong matches are applied and the rest are
    # printed as "Skipping.".
    local run=(-T)
    if [ "${3:-}" = tty ]; then
        run=(-it)
    fi
    # Stoppable by one ^C, which needs care: `sh -c` with a single command execs
    # it (so find would be PID 1, and PID 1 has no default signal dispositions -
    # that is why every ^C used to kill only the current beets child while find
    # marched on to the next file), and a trap on its own is not enough either,
    # because a shell defers traps until its foreground child exits. Background
    # the loop and wait: wait is interruptible, so the trap fires immediately,
    # kills find and the container goes with PID 1.
    "${COMPOSE[@]}" run "${run[@]}" --rm -e PYTHONUNBUFFERED=1 --entrypoint /bin/sh beets -c '
        trap "kill \$pid 2>/dev/null; exit 130" INT TERM
        find "$1" -type f ! -name ".*" \
            -exec /lsiopy/bin/beet --config "$2" import {} \; &
        pid=$!
        wait $pid' \
        release-pass "${1:-/downloads}" "${2:-/config/album.yaml}"
}

# Run beets interactively and keep this shell alive to catch Ctrl-C: `exec` would
# replace the shell (and its traps) with beets, so the subshell takes the exec
# instead. The subshell is still a proper child, so the terminal is handed over,
# yt-dlp/beets/compose clean up their own containers and an interrupt surfaces
# through on_interrupt as something a human can read.
interactive_pass() {  # <beets args...>
    local status=0
    ( exec "${BEET_TTY[@]}" "$@" ) || status=$?
    exit "$status"
}

# Give already-imported bare tracks their release. beets only applies RELEASE
# metadata during an album import, and `beet import -L` re-imports the library
# item as whatever it already is - a singleton stays a singleton, so the track
# match is a no-op (beets' own SingletonImportTask: "a single track that is not
# associated to an album"). So hand the FILES to the importer instead: drop the
# rows (no -d, the files stay on disk), then import those paths in album mode.
# `reviewed::^$` leaves the reviewer's decisions alone: a track they chose to
# keep as-is is never given a release behind their back (the marker is written
# by reviewed.py, see interactive.yaml). Anything that finds no release stays
# untracked but keeps playing; re-register it with `media-sync --adopt`.
# Optional beets query as "$@".
upgrade_releases() {
    local files
    # sort -u: the library can hold SEVERAL rows for the SAME path (a legacy
    # import artifact - this one has 1112 such paths, 1909 redundant rows). beets
    # imports the first copy of a path by MOVING the file, so the next task for
    # that path then cannot open it: chroma's fingerprint stage raises
    # FileNotFoundError out of run_parallel and kills the whole session mid-pass
    # (seen twice, ~900 tasks in). One task per path removes that entirely.
    mapfile -t files < <("${BEET[@]}" ls -f '$path' 'mb_albumid::^$' 'reviewed::^$' "$@" | sort -u)
    [ -n "${files[*]:-}" ] || return 0
    "${BEET[@]}" remove -f 'mb_albumid::^$' 'reviewed::^$' "$@"
    # upgrade.yaml = album.yaml + `lastgenre: auto: no`: re-matching the existing
    # library must not re-derive (and replace) genres for every file it re-imports.
    # See the overlay's own header.
    "${BEET[@]}" --config /config/upgrade.yaml import "${files[@]}"
}

# upgrade_releases plus the numbers worth reporting. A track that finds no release
# loses its row (see above), so "bare rows left" is not "tracks that failed" - the
# ones that failed are gone from the count. Count what gained a release and what
# vanished instead; sets UPG_BEFORE, UPG_GOT and UPG_DROPPED.
upgrade_report() {  # [<beets query>...]
    local rel_before rel_after bare_after
    UPG_BEFORE="$(count 'mb_albumid::^$' 'reviewed::^$' "$@")"
    rel_before="$(count 'mb_albumid::.' 'reviewed::^$' "$@")"
    upgrade_releases "$@"
    bare_after="$(count 'mb_albumid::^$' 'reviewed::^$' "$@")"
    rel_after="$(count 'mb_albumid::.' 'reviewed::^$' "$@")"
    UPG_GOT=$((rel_after - rel_before))
    UPG_DROPPED=$((UPG_BEFORE - bare_after - UPG_GOT))
}

exec 9>"$LIB/logs/.media-sync.lock"
# One writer at a time, interactive sessions included - an interactive run can
# hold this for an hour, so a skipped nightly sync says so instead of staying
# silent (no lock, no beets writes while a reviewer is answering prompts).
flock -n 9 || {
    echo "media-sync already running; skipping this run"
    notify "needs a look" "another media-sync run is in progress; this run skipped." default warning
    exit 0
}

# Ctrl-C / SIGTERM: stop and say so. An unattended run interrupted at 02:00 must
# not just vanish - hence the ntfy when there is no terminal - while a manual one
# should say plainly that it stopped. Nothing needs unwinding: flock drops the
# lock with the process, and yt-dlp's archive file means a re-run skips what was
# already downloaded. A file interrupted mid-move is either already renamed
# (downloads/ and music/ are the same filesystem) or still in downloads/, so the
# worst case is a track sitting in music/ that beets has not registered yet -
# `media-sync --adopt` picks it up.
on_interrupt() {
    echo "media-sync ${MODE#--} interrupted; stopping."
    if [ ! -t 0 ]; then
        notify "interrupted" "stopped before finishing - re-run when you can. See $LIB/logs/media-sync.log." default warning
    fi
    exit 130
}
trap on_interrupt INT TERM
trap 'notify failed "Line $LINENO. See $LIB/logs/media-sync.log." high rotating_light,error' ERR

# The interactive modes are for a human at a terminal. Refuse to run without one,
# before anything else happens: the cron only ever runs `sync` and `--retag`, and
# while media-import checks this too, the engine is the place that must never sit
# on a prompt nobody can answer.
case "$MODE" in
    --interactive | --review | --singles | --release)
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            echo "media-sync ${MODE#--} needs an interactive terminal - run it from a shell (or use media-import)." >&2
            exit 2
        fi
        ;;
esac

# Watchtower never sees this short-lived container, so pull here; a failed pull keeps the cached image.
"${COMPOSE[@]}" --profile tools pull -q beets || echo "beets pull failed; using the cached image"

case "$MODE" in
    --retag)
        # `reviewed::^$` here too: a track the reviewer kept as-is carries no
        # MusicBrainz ids, so without it this would re-match it and overwrite the
        # tags they chose to keep.
        before="$(count 'mb_trackid::^$' 'reviewed::^$' added:-4w..)"
        "${BEET[@]}" import -L 'mb_trackid::^$' 'reviewed::^$' added:-4w..
        after="$(count 'mb_trackid::^$' 'reviewed::^$' added:-4w..)"
        # A track match can never carry the release (year, release ID, cover
        # art), so give the recent matches their release too. Same window.
        upgrade_report added:-4w..
        notify "done" "$((before - after)) of $before recent as-is track(s) matched MusicBrainz; $UPG_GOT of $UPG_BEFORE got a release, $UPG_DROPPED found none and need 'media-sync --adopt'."
        exit 0 ;;
    --upgrade)
        # The release half of --retag, on demand: give tracks that were imported
        # as bare tracks their release (year, release ID, label, track numbers,
        # Cover Art Archive art). Narrow it with a beets query, or pass `all`.
        case "$DIR" in
            all) scope=() ;;
            '') scope=(added:-4w..) ;;
            *) scope=("$DIR") ;;
        esac
        upgrade_report "${scope[@]}"
        notify "done" "$UPG_GOT of $UPG_BEFORE track(s) got a release; $UPG_DROPPED found none and lost their row until 'media-sync --adopt' registers them again."
        exit 0 ;;
    --albums)
        # Release pass only, GROUPED: beets sees the directory as album tasks, so
        # a complete album (or a ripped CD) is matched as a whole. The nightly run
        # makes the opposite trade-off - every file judged on its own - because a
        # playlist dump cannot be trusted to group correctly; see release_pass.
        #
        # --id pins the release: a pressing that is on MusicBrainz but whose
        # track list or credits differ from the files (a ripped compilation, a
        # reissue) scores below the strong threshold and would be skipped, so the
        # `pinned` overlay accepts the one candidate a person chose.
        if [ -n "$ALBUM_ID" ]; then
            overlay pinned
            exec "${COMPOSE[@]}" run --rm -T -e PYTHONUNBUFFERED=1 \
                --entrypoint /lsiopy/bin/beet beets \
                -c /config/.run.yaml import -S "$ALBUM_ID" "${DIR:-/downloads}"
        fi
        exec "${COMPOSE[@]}" run --rm -T -e PYTHONUNBUFFERED=1 \
            --entrypoint /lsiopy/bin/beet beets \
            --config /config/album.yaml import "${DIR:-/downloads}" ;;
    --keep)
        # "I know what this is and I want it as it is": register the files with
        # beets without matching them (adopt.yaml), move them into music/ so the
        # nightly run stops retrying them, and let reviewed.py mark them - the
        # marker is what keeps --upgrade and --retag away from them later.
        overlay keep
        before="$(count)"
        register_new /config/.run.yaml "${DIR:-/downloads}"
        after="$(count)"
        notify "done" "$((after - before)) new track(s) registered as-is and marked reviewed."
        exit 0 ;;
    --adopt)
        adopt_library
        notify "done" "beets now tracks $(count) track(s) in music/, $(count 'reviewed::.') of them marked reviewed."
        exit 0 ;;
    --backfill)
        backfill
        notify "done" "$(count 'lyrics::.') of $(count) track(s) now carry lyrics; ReplayGain written."
        exit 0 ;;
    --regroup)
        # Album rows for tracks that carry a release id but no album row: what
        # as-is registration and older library damage leave behind. Changes no file.
        result="$(regroup_albums)"
        echo "$result"
        notify "done" "$result"
        exit 0 ;;
    --pin)
        # Give the files a beets query selects a MusicBrainz release, chosen by a
        # person (--id): for an album the per-file release pass could not place,
        # a ripped CD whose release is on MusicBrainz, or tracks spread over
        # several folders (a folder import cannot group those). They end up in one
        # album row. Rows only are replaced, never files; a file the release does
        # not fit stays registered as it was. --dry-run lists the files and stops.
        # Several words make several query terms: --pin 'album:X' 'track:1..5'.
        files="$(files_for_query "${ARGS[@]}")"
        [ -n "$files" ] || { echo "no track matches: ${ARGS[*]}" >&2; exit 1; }
        echo "$(printf '%s\n' "$files" | wc -l) file(s) match: ${ARGS[*]}"
        printf '%s\n' "$files" | head -5
        if [ "$DRY" -eq 1 ]; then
            echo "dry run: nothing changed."
            exit 0
        fi
        before="$(count "mb_albumid:$ALBUM_ID")"
        echo "checkpoint: $(checkpoint)"
        printf '%s\n' "$files" | pin_files "$ALBUM_ID"
        after="$(count "mb_albumid:$ALBUM_ID")"
        notify "done" "$((after - before)) of $(printf '%s\n' "$files" | wc -l) track(s) pinned to release ${ALBUM_ID%%-*}; the rest stayed registered as they were."
        exit 0 ;;
    --complete)
        # Finish partly matched albums: where most tracks found their release and
        # a few did not, pin the rest to the same release - but only the tracks
        # whose title is on that release (complete_plan). --dry-run prints the
        # plan and stops. Run --regroup first, so the matched tracks already
        # share one album row for the others to join.
        plan="$(complete_plan)"
        [ -n "$plan" ] || { echo "nothing to complete"; notify "done" "no partly matched album found."; exit 0; }
        printf '%s\n' "$plan" | awk -F'\t' '{k = $2 "  (" $1 ")"; n[k]++} END {for (k in n) print n[k] " track(s) -> " k}'
        if [ "$DRY" -eq 1 ]; then
            echo "dry run: nothing changed."
            exit 0
        fi
        echo "checkpoint: $(checkpoint)"
        total=0
        for id in $(printf '%s\n' "$plan" | cut -f1 | sort -u); do
            printf '%s\n' "$plan" | awk -F'\t' -v id="$id" '$1 == id {print $3}' | pin_files "$id"
            total=$((total + $(printf '%s\n' "$plan" | awk -F'\t' -v id="$id" '$1 == id' | wc -l)))
        done
        notify "done" "$total track(s) of $(printf '%s\n' "$plan" | cut -f1 | sort -u | wc -l) album(s) given their release."
        exit 0 ;;
    --settle)
        # A rebuilt library is "added now" row by row, and the weekly --retag then
        # re-matches all of it. See settle_library.
        echo "checkpoint: $(checkpoint)"
        result="$(settle_library)"
        echo "$result"
        notify "done" "$result"
        exit 0 ;;
    --plan)
        # What --maintenance would face, changing nothing.
        maintenance_plan || exit 1
        exit 0 ;;
    --maintenance)
        # The one-time routine for an existing library, with a checkpoint and a
        # resume point; see media-maintenance.
        maintenance
        exit 0 ;;
    --review)
        # A full review session: the release pass WITH prompts, so a near miss the
        # automatic run refuses can be accepted by number or dismissed, followed by
        # the singleton pass per track. Releases first on purpose - a release
        # carries the year, release id, track numbers and Cover Art Archive art
        # that a track match can never supply, and the singleton pass is the one
        # that can no longer reach an album afterwards.
        overlay release
        echo "== media-import: album (release) pass, asking =="
        release_pass "${DIR:-/downloads}" /config/.run.yaml tty || true
        echo "== media-import: singleton pass =="
        interactive_pass --config /config/interactive.yaml import "${DIR:-/downloads}" ;;
    --singles)
        # The judging half on its own. After a nightly run the release pass has
        # already had its say and left its leftovers, so `media-import --singles`
        # goes straight to the per-track decisions instead of waiting through a
        # release pass that would find nothing new.
        interactive_pass --config /config/interactive.yaml import "${DIR:-/downloads}" ;;
    --interactive)
        # Both passes, the singleton one interactive (what `media-import` runs).
        echo "== media-import: album (release) pass =="
        release_pass "${DIR:-/downloads}" /config/album.yaml || true
        echo "== media-import: singleton pass =="
        interactive_pass --config /config/interactive.yaml import "${DIR:-/downloads}" ;;
    --release)
        # The release pass WITH prompts, for the near misses automatic matching
        # refuses (verified: a correct release can score 0.05 against the 0.04
        # strong_rec_thresh and be skipped). Answering as-is marks the track.
        overlay release
        if [ -n "$ALBUM_ID" ]; then
            interactive_pass -c /config/.run.yaml import -S "$ALBUM_ID" "${DIR:-/downloads}"
        fi
        interactive_pass -c /config/.run.yaml import "${DIR:-/downloads}" ;;
    sync) ;;
    *)
        echo "usage: media-sync [--retag|--upgrade [all|<query>]|--albums [<dir>] [--id <release>]|--keep [<dir>]|--adopt|--regroup|--settle|--pin '<query>' --id <release> [--dry-run]|--complete [--dry-run]|--backfill|--plan|--maintenance [--from <1-8>]|--interactive [<dir>]|--review [<dir>]|--singles [<dir>]|--release [<dir>] [--id <release>]]"
        exit 2 ;;
esac

mapfile -t playlists < <(grep -v '^\s*$' "{{ media_home }}/config/playlists.txt")

# yt-dlp exits non-zero when a single video is gone; that is expected, other errors alert.
run_log="$(mktemp)"
trap 'rm -f "$run_log"' EXIT
for url in "${playlists[@]}"; do
    yt-dlp --config-location "{{ media_home }}/config/yt-dlp.conf" "$url" 2>&1 | tee -a "$run_log" || true
done
errors="$(grep '^ERROR:' "$run_log" \
    | grep -cvE 'Video unavailable|Private video|video has been removed|not available in your country|members-only' \
    || true)"

new="$(find "$LIB/downloads" -type f | wc -l)"
if [ "$new" -gt 0 ]; then
    # Release pass, one file at a time (see release_pass), then a singleton pass
    # for whatever is left.
    release_pass /downloads /config/album.yaml
    # SINGLETON pass: per-track MusicBrainz match for whatever is left. A track
    # lookup carries no album-level metadata by design, so this is the fallback.
    "${BEET[@]}" import /downloads
fi
left="$(find "$LIB/downloads" -type f | wc -l)"

summary="$(grep -cv '^\s*$' "{{ media_home }}/config/playlists.txt") playlist(s): $((new - left)) track(s) imported, $left left in downloads/, $errors unexpected yt-dlp error(s)."
if [ "$errors" -gt 0 ] || [ "$left" -gt 0 ]; then
    notify "needs a look" \
        "$summary Run 'media-import' to resolve what is left, interactively. See $LIB/logs/media-sync.log." \
        default warning
else
    notify "done" "$summary"
fi
