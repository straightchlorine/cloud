import:
    autotag: no
    move: no
    copy: no
    write: no
    # Skip files already in the library: adopt walks all of music/, and
    # config.yaml's `keep` would run the import-event plugins on every known file.
    duplicate_action: skip
lyrics:
    auto: no
replaygain:
    auto: no
# Adopt registers what is there and changes nothing: lastgenre would otherwise
# re-derive genres from Last.fm (`force: yes` in config.yaml) for every file touched.
lastgenre:
    auto: no
