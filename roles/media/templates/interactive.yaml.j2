# Merged over config.yaml by `media-import` (via `beet --config`): beets prints the
# MusicBrainz candidates and asks per track instead of skipping unmatched files.
import:
    quiet: no

# "Use as-is" is a decision: reviewed.py marks those tracks so `--upgrade` and
# `--retag` leave them alone.
reviewed:
    mark: yes
