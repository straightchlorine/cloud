#!/usr/bin/env bash
# beet - run beets in the stack's container from the host shell. /config is the
# container's config dir, so queries and plugins match what the pipeline uses.
#
#   beet ls -f '$title | $comments' 'reviewed::.'
#   beet ls 'mb_albumid::^$' 'reviewed::^$' added:-4w..   # what --upgrade touches
#   beet stats
#
# `beet modify` and `beet remove` change the library. From a script pass `< /dev/null`:
# `docker compose run` otherwise swallows the script's stdin.
set -euo pipefail

exec docker compose -f "{{ media_home }}/docker-compose.yml" run --rm -T \
    --entrypoint /lsiopy/bin/beet beets "$@"
