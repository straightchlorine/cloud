#!/usr/bin/env bash
# media-import-album - ALBUM (release) import for a full ripped CD, or for
# albums (and single tracks) sitting in downloads/. It matches each group of
# files to a MusicBrainz release and imports the strong matches, leaving
# whatever finds no release in place for the singleton path (`media-sync` /
# `media-import`).
#
#   media-import-album            process /downloads
#   media-import-album <dir>      process another directory
set -euo pipefail

COMPOSE=(docker compose -f "{{ media_home }}/docker-compose.yml")

exec "${COMPOSE[@]}" run --rm -T --entrypoint /lsiopy/bin/beet beets \
    --config /config/album.yaml import "${1:-/downloads}"
