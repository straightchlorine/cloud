# {{ ansible_managed }}
# Restic reads this file through -o sftp.args="-F /etc/restic/ssh_config".
# Repository URLs name the hetzner-storage alias, which this file resolves.
Host hetzner-storage
    HostName {{ restic_storage_host }}
    User {{ restic_storage_user }}
    Port {{ restic_storage_port }}
    IdentityFile /etc/ssh/restic_storage_key
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /etc/restic/known_hosts
    GlobalKnownHostsFile /dev/null
    ConnectTimeout 30
    ServerAliveInterval 30
    ServerAliveCountMax 6
