# {{ ansible_managed }}
RESTIC_REPOSITORY={{ restic_job_cfg.repository | quote }}
RESTIC_PASSWORD_FILE=/etc/restic/{{ restic_job_cfg.name }}.password
RESTIC_CACHE_DIR={{ restic_cache_dir }}
# Set here and not in the unit, so that cron runs and a root-run restic-job exec stage pack files off tmpfs too.
TMPDIR={{ restic_cache_dir }}/tmp
# The Go runtime collects harder before a cgroup limit kills it; a cron host has no cgroup, so this is its only limit.
GOMEMLIMIT={{ (restic_job_cfg.memory_max_mib * 4) // 5 }}MiB
RESTIC_JOB_HOST={{ restic_job_cfg.host | quote }}
RESTIC_JOB_TAGS='{{ restic_job_cfg.tags | join(' ') }}'
RESTIC_JOB_KEEP='{{ restic_job_keep }}'
RESTIC_JOB_FRESH='{{ restic_job_fresh }}'
RESTIC_JOB_MAX_AGE_HOURS={{ restic_job_cfg.max_age_hours }}
# GNU timeout takes m, not min; only the cron wrapper reads this.
RESTIC_JOB_TIMEOUT={{ restic_job_cfg.timeout | regex_replace('min$', 'm') }}
RESTIC_JOB_MIN_FREE_PERCENT={{ restic_storage_min_free_percent }}
RESTIC_JOB_SKIP_METERED={{ 1 if restic_job_cfg.skip_metered else 0 }}
RESTIC_JOB_SKIP_ON_BATTERY={{ 1 if restic_job_cfg.skip_on_battery else 0 }}
RESTIC_JOB_IGNORE_INODE={{ 1 if restic_job_cfg.ignore_inode else 0 }}
