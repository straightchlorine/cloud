[Unit]
Description=restic backup job %i
Documentation=file:///etc/restic/%i.env
Wants=network-online.target
After=network-online.target time-sync.target
# The notification runs in a separate root unit, so a 226/NAMESPACE, dependency or timeout failure here
# cannot take it down. One handler instance per job and outcome lets systemd pass the MONITOR_* variables
# (systemd 251 or later).
OnSuccess=restic-notify@ok-%i.service
OnFailure=restic-notify@fail-%i.service

[Service]
Type=oneshot
User=restic
Group=restic
ExecStart=/usr/local/libexec/restic/restic-job run %i
# Exit 3 means the snapshot was saved but some files were unreadable, which counts as success with a warning ntfy.
SuccessExitStatus=3
# The stop and timeout signal goes to restic-job only, which relays SIGINT to
# restic while ssh is still alive, so restic can delete its lock.
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5min
StateDirectory=restic
StateDirectoryMode=0755
UMask=0077
Nice=19
IOSchedulingClass=idle
# The job reads everything and writes only the state directory, the cache directory (the drop-in names it)
# and a local repository path.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Other users' processes (a concurrent root notifier) stay invisible.
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# AF_NETLINK is needed by glibc getaddrinfo in the ssh child.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
