# Generated by Ansible - the upstream GPU image with CUDA's forward-compatibility
# libraries removed (see roles/gpu-qp/defaults/main.yml, gpu_qp_strip_cuda_compat).
FROM {{ gpu_qp_upstream_image }}

# The stock image ships forward-compatibility libcuda under /usr/local/cuda-*/compat
# and ldconfig resolves it before the driver's own library. Forward compatibility
# is only supported on datacenter (Tesla) GPUs; on a GeForce card the compat
# libcuda makes cuInit return CUDA_ERROR_COMPAT_NOT_SUPPORTED_ON_DEVICE (804),
# which qiskit-aer reports as "No CUDA device available!" - even though nvidia-smi
# works, because NVML does not go through libcuda. Removing the compat libraries
# (and their ld.so.conf entry) lets the driver's libcuda, mounted at
# /usr/lib/x86_64-linux-gnu/nvidia/current, be resolved instead.
RUN rm -rf /usr/local/cuda/compat /usr/local/cuda-*/compat \
 && rm -f /etc/ld.so.conf.d/*compat* \
 && ldconfig
