#!/usr/bin/env bash
# gpu-qp-phase.sh <phase>
#
# Drives one phase of the rerun (brief 5.2). Per-lane stdout goes to <phase>/<lane>.driver.log;
# the per-cell container output is already tee'd into <phase>/<lane>/<mol>_seed<S>.log.
#
#   A: cpu-aer + gpu1 + gpu2 concurrently, then analytic.
#   B: each lane alone, in order analytic, gpu1, gpu2, cpu-aer.
#   C: cpu-aer + gpu1 + gpu2 concurrently (H2, cc-pvdz).
set -u

BENCH=${GPU_QP_BENCH:-{{ gpu_qp_home }}/bench}
# Sibling scripts live beside this file; GPU_QP_BENCH may point at a data-only tree.
HERE=$(cd "$(dirname "$0")" && pwd)
PHASE=${1:-}
LOG=$BENCH/$PHASE/phase.log
mkdir -p "$BENCH/$PHASE"

lane() { bash "$HERE/gpu-qp-lane.sh" "$PHASE" "$1" >> "$BENCH/$PHASE/$1.driver.log" 2>&1; }

case "$PHASE" in
  A|A2)
    for L in cpu-aer gpu1 gpu2; do lane "$L" & done
    wait
    lane analytic
    ;;
  B)
    for L in analytic gpu1 gpu2 cpu-aer; do lane "$L"; done
    ;;
  C)
    for L in cpu-aer gpu1 gpu2; do lane "$L" & done
    wait
    ;;
  H|S)
    lane analytic
    [ "$PHASE" = S ] && for L in cpu-aer gpu1 gpu2; do lane "$L"; done
    ;;
  *) echo "usage: $0 <A|A2|B|C|H|S>" >&2; exit 2 ;;
esac

echo "PHASE_DONE $PHASE $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$LOG"
