#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# Host tool for the gpu-qp stack: keep the source checkout current, build the GPU
# image from it, prove the image runs on the GPU, and run simulations with it.
# The deploy uses the same commands, so a by-hand build or check is the deployed one.

set -euo pipefail

STACK_HOME="{{ gpu_qp_home }}"
COMPOSE_FILE="$STACK_HOME/docker-compose.yml"
SERVICE="quantum-pipeline-gpu"
SOURCE="{{ gpu_qp_source_path }}"
IMAGE="{{ gpu_qp_image_name }}"
GEN_DIR="{{ gpu_qp_gen_path }}"
LOG_DIR="{{ gpu_qp_log_path }}"
FINGERPRINT_FILE="{{ gpu_qp_build_fingerprint_file }}"
TRIVY_IMAGE="{{ gpu_qp_trivy_image }}"
TRIVY_CACHE="{{ gpu_qp_home }}/.cache/trivy"
# Present while the checkout carries a `gpu-qp patch`; holds a hash of the patches.
PATCH_MARKER="$SOURCE/.git/gpu-qp-patch"
BENCH_SCRIPT="scripts/benchmark_fast_path.py"
CONTAINER_ROOT="/usr/src/quantum_pipeline"

# Reach docker/Dockerfile.gpu as build args - the Dockerfile is never rewritten.
BUILD_ARGS=(
  CUDA_VERSION="{{ gpu_qp_cuda_version }}"
  CUDA_ARCH="{{ gpu_qp_cuda_arch }}"
  AER_VERSION="{{ gpu_qp_aer_version }}"
)

# Every run starts with these; arguments given to `run` are appended, so the
# solver's argparse lets them override a default with the same name. `run` adds
# --gpu (unless --cpu) and --optimizer (unless the caller passes one) itself.
RUN_DEFAULTS=(
  --file "{{ gpu_qp_container_molecules_path }}"
  --basis "{{ gpu_qp_basis }}"
  --max-iterations "{{ gpu_qp_max_iterations }}"
  --report
)
DEFAULT_OPTIMIZER="{{ gpu_qp_optimizer }}"

usage() {
  cat <<EOF
Usage: gpu-qp <command> [options]

Commands:
  pull [--reset] [BRANCH]
      Fetch the source checkout's origin and fast-forward it, switching to
      BRANCH first. Without BRANCH, updates the branch that is checked out.
      --reset  hard-reset to origin instead of fast-forwarding - for a branch
               that was rebased or amended upstream
      Checkout: $SOURCE

  patch [--reset]
      Apply a unified diff read from stdin to the checkout (git apply --index,
      so new files are included) to test uncommitted workstation changes. The
      build revision becomes <sha>+patched-<hash>, so 'gpu-qp build' rebuilds.
      Refuses empty input. Patches stack until reset; 'pull' needs --reset
      while one is applied.
      --reset  first drop everything uncommitted in the checkout (git reset
               --hard + git clean -fd), i.e. the previous patch
      e.g.  (git diff HEAD; git ls-files -o --exclude-standard -z |
             xargs -0 -n1 git diff --no-index /dev/null) | ssh gpu 'gpu-qp patch --reset'

  build [--force]
      Build $IMAGE from docker/Dockerfile.gpu with:
$(printf '        %s\n' "${BUILD_ARGS[@]}")
      Skipped while neither these nor the source revision changed since the
      last successful build. App-code changes rebuild fast: Docker reuses every
      cached layer before the source copy.
      --force  build even when nothing changed
      Logs: $LOG_DIR/build-<UTC timestamp>.log (build-latest.log is the newest)

  check
      Prove the image runs on the GPU, inside the worker container:
        - Aer's available_devices() lists GPU
        - a Bell circuit executed with device="GPU", which cannot quietly fall
          back to the CPU - the CUDA controller raises instead
        - ldd resolves every one of Aer's shared objects
      Also prints the image size, the driver and the cards' compute capability.

  run [--cpu] [SOLVER-OPTION]...
      One VQE simulation, on the GPU unless --cpu. Every run starts with
        ${RUN_DEFAULTS[*]} --optimizer $DEFAULT_OPTIMIZER --gpu
      and appends the options given here, which override those by name.
      --cpu  omit --gpu (CPU / fast-path cases); consumed here, not passed on
      --optimizer given here replaces the default one instead of being added to it
      Writes $GEN_DIR/<UTC timestamp>/:
        run.log   the combined output, teed live
        run.json  arguments, exit status, image id, source revision, driver
        the report and the convergence plots
      e.g.  gpu-qp run --molecule-index 1 --basis cc-pvdz --max-iterations 250

  bench [ARG]...
      Run $BENCH_SCRIPT from the checkout inside the image, as the calling
      user, passing ARG through. The checkout's scripts/ (read-only) and data/
      (read-only, so data/molecules.thesis.json is there) are mounted; benchmarks/
      is writable under the run directory. Defaults to --output <run dir>/bench.json
      (an ARG --output overrides it). Writes $GEN_DIR/<UTC timestamp>/bench.log
      and bench.json. Prints what is missing if the script is not in the checkout.

  scan [--all] [IMAGE]
      Scan IMAGE (default $IMAGE) for vulnerabilities with Trivy, filtered the
      way CI uploads them: HIGH and CRITICAL with a fix available, minus the
      checkout's .trivyignore. Prints a summary by severity, source and package.
      --all  every severity, fixed or not, no ignore file
      Report: $LOG_DIR/scan-<UTC timestamp>.json   Scanner: $TRIVY_IMAGE

  help
      Show this message. Every command also takes -h/--help.

Copy runs back from your workstation: scripts/gpu-qp/collect.sh (cloud repo)
EOF
}

die() {
  echo "[FAIL] $*" >&2
  exit 1
}

bad_usage() {
  echo "gpu-qp: $*" >&2
  echo "Run 'gpu-qp help' for usage." >&2
  exit 2
}

# safe.directory: the deploy clones as the stack user, and this may run as root
# - without it git refuses the checkout as "dubious ownership".
git_src() {
  git -c "safe.directory=$SOURCE" -C "$SOURCE" "$@"
}

require_checkout() {
  [ -d "$SOURCE/.git" ] || die "no git checkout at $SOURCE - deploy the role first"
}

require_image() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 \
    || die "image $IMAGE is not present - run: gpu-qp build"
}

# HEAD, plus +patched-<hash> while a patch is applied - what build fingerprints.
source_revision() {
  local sha
  sha="$(git_src rev-parse HEAD)"
  if [ -e "$PATCH_MARKER" ]; then
    echo "$sha+patched-$(cat "$PATCH_MARKER")"
  else
    echo "$sha"
  fi
}

cmd_patch() {
  local reset=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --reset) reset=true ;;
      *) bad_usage "patch: unknown argument $1" ;;
    esac
    shift
  done
  require_checkout
  [ ! -t 0 ] || die "patch reads a unified diff from stdin - pipe one in (see: gpu-qp help)"

  local diff
  diff="$(mktemp)"
  # Expanded now: a single-quoted trap would read the function-local $diff at
  # script exit, after it is gone (set -u: "diff: unbound variable", exit 1).
  trap "rm -f '$diff'" EXIT
  cat >"$diff"
  [ -s "$diff" ] || die "empty diff on stdin - nothing to apply (is the workstation tree clean?)"

  if [ "$reset" = true ]; then
    git_src reset --hard -q
    git_src clean -fdq
    rm -f "$PATCH_MARKER"
  fi
  git_src apply --check "$diff" \
    || die "the diff does not apply to $(git_src rev-parse --short HEAD) - same base commit as the workstation? previous patch still applied? try --reset"
  git_src apply --index "$diff"

  local previous=""
  [ ! -e "$PATCH_MARKER" ] || previous="$(cat "$PATCH_MARKER")"
  { echo "$previous"; cat "$diff"; } | sha256sum | cut -c1-12 >"$PATCH_MARKER"

  git_src --no-pager diff --cached --stat
  echo "[OK] patched $(git_src rev-parse --short HEAD) -> $(source_revision | cut -c1-40) - run: gpu-qp build"
}

cmd_pull() {
  local reset=false branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --reset) reset=true ;;
      -*) bad_usage "pull: unknown option $1" ;;
      *) [ -z "$branch" ] || bad_usage "pull: one branch at most"; branch="$1" ;;
    esac
    shift
  done
  require_checkout
  if [ -e "$PATCH_MARKER" ] && [ "$reset" = false ]; then
    die "the checkout carries a patch - use: gpu-qp pull --reset [BRANCH]"
  fi

  # A shallow or single-branch clone cannot check out another branch, so complete
  # it and widen the refspec first. Both are no-ops on a complete clone.
  if [ -f "$SOURCE/.git/shallow" ]; then
    git_src fetch --unshallow
  fi
  git_src config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  git_src fetch --prune --tags origin

  local current
  current="$(git_src rev-parse --abbrev-ref HEAD)"
  branch="${branch:-$current}"
  if [ "$current" != "$branch" ]; then
    git_src checkout "$branch"
  fi

  if [ "$reset" = true ]; then
    git_src reset --hard "origin/$branch"
    git_src clean -fdq
    rm -f "$PATCH_MARKER"
  else
    git_src pull --ff-only
  fi
  echo "[OK] $branch at $(git_src --no-pager log --oneline -1)"
}

cmd_build() {
  local force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --force) force=true ;;
      *) bad_usage "build: unknown argument $1" ;;
    esac
    shift
  done
  require_checkout

  local dockerfile="$SOURCE/docker/Dockerfile.gpu"
  [ -f "$dockerfile" ] || die "no docker/Dockerfile.gpu in $SOURCE"
  # An older Dockerfile.gpu ignores the build args and ships CUDA's forward-compat
  # libcuda, which fails on GeForce cards (error 804).
  grep -q "^ARG CUDA_VERSION=" "$dockerfile" \
    || die "docker/Dockerfile.gpu at this revision has no ARG CUDA_VERSION - gpu-qp pull a newer branch"

  local revision fingerprint
  revision="$(source_revision)"
  fingerprint="${BUILD_ARGS[*]} $revision"
  if [ "$force" = false ] \
     && docker image inspect "$IMAGE" >/dev/null 2>&1 \
     && [ "$(cat "$FINGERPRINT_FILE" 2>/dev/null)" = "$fingerprint" ]; then
    echo "[OK] $IMAGE is up to date (${revision:0:12})"
    return
  fi

  mkdir -p "$LOG_DIR"
  local log
  log="$LOG_DIR/build-$(date -u +%Y%m%dT%H%M%SZ).log"
  ln -sfn "$(basename "$log")" "$LOG_DIR/build-latest.log"
  echo "building $IMAGE at ${revision:0:12} - log: $log"

  if ! docker build --progress=plain \
       -f "$dockerfile" \
       "${BUILD_ARGS[@]/#/--build-arg=}" \
       -t "$IMAGE" \
       "$SOURCE" >"$log" 2>&1; then
    tail -n 30 "$log" >&2
    die "build failed - full log: $log"
  fi

  # Written only after a successful build, so a failed one is retried next time.
  echo "$fingerprint" >"$FINGERPRINT_FILE"
  echo "[OK] built $IMAGE at ${revision:0:12}"
}

cmd_check() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) bad_usage "check takes no arguments" ;;
  esac
  require_image

  echo "== gpu-qp check =="
  echo "-- image --"
  echo "  $IMAGE $(docker image inspect "$IMAGE" --format '{% raw %}{{ .Size }}{% endraw %}' | numfmt --to=iec-i --suffix=B)"
  echo "-- host GPU --"
  nvidia-smi --query-gpu=index,name,driver_version,compute_cap --format=csv,noheader | sed 's/^/  /'
  echo "-- container --"
  docker compose -f "$COMPOSE_FILE" run --rm -T --entrypoint bash "$SERVICE" -s <<'INNER'
set -euo pipefail

python - <<'PY'
import sys
from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator

devices = AerSimulator().available_devices()
print(f"  available_devices(): {devices}")
if "GPU" not in devices:
    sys.exit("  [FAIL] Aer advertises no GPU - this build is CPU-only, or cuInit failed")
print("  [OK]   Aer advertises GPU")

circuit = QuantumCircuit(2)
circuit.h(0)
circuit.cx(0, 1)
circuit.measure_all()

simulator = AerSimulator(device="GPU", method="statevector", seed_simulator=1234)
try:
    counts = simulator.run(transpile(circuit, simulator), shots=256).result().get_counts()
except Exception as exc:
    sys.exit(f"  [FAIL] GPU execution raised: {exc}")
if set(counts) - {"00", "11"}:
    sys.exit(f"  [FAIL] Bell state produced unexpected counts: {counts}")
print(f"  [OK]   GPU execution produced a Bell distribution: {counts}")
PY

aer_dir="$(python -c 'import os, qiskit_aer; print(os.path.dirname(qiskit_aer.__file__))')"
unresolved="$(find "$aer_dir" -name '*.so' -exec ldd {} + 2>/dev/null | grep 'not found' | sort -u || true)"
if [ -n "$unresolved" ]; then
  echo "  [FAIL] unresolved shared objects:"
  printf '%s\n' "$unresolved" | sed 's/^/    /'
  exit 1
fi
echo "  [OK]   every Aer shared object resolves"
INNER
}

cmd_run() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
  esac
  require_image

  local cpu=false have_optimizer=false args=() arg
  for arg in "$@"; do
    case "$arg" in
      --cpu) cpu=true; continue ;;
      --optimizer|--optimizer=*) have_optimizer=true ;;
    esac
    args+=("$arg")
  done
  local defaults=("${RUN_DEFAULTS[@]}")
  [ "$have_optimizer" = true ] || defaults+=(--optimizer "$DEFAULT_OPTIMIZER")
  [ "$cpu" = true ] || defaults+=(--gpu)

  local run_id run_dir status
  run_id="$(date -u +%Y%m%dT%H%M%SZ)"
  run_dir="$GEN_DIR/$run_id"
  mkdir -p "$run_dir/run_configs"

  # As the calling user, so the run directory stays theirs; HOME and the
  # matplotlib cache point at /tmp because that user has no home in the image.
  # The solver writes gen/ and run_configs/ relative to its root-owned working
  # directory, so both are mounted from the run directory.
  set +e
  docker compose -f "$COMPOSE_FILE" run --rm -T \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
    -v "$run_dir:/usr/src/quantum_pipeline/gen" \
    -v "$run_dir/run_configs:/usr/src/quantum_pipeline/run_configs" \
    "$SERVICE" "${defaults[@]}" ${args[@]+"${args[@]}"} 2>&1 | tee "$run_dir/run.log"
  status=${PIPESTATUS[0]}
  set -e

  GPU_QP_RUN_ID="$run_id" GPU_QP_STATUS="$status" GPU_QP_ARGS="${defaults[*]} ${args[*]-}" \
  GPU_QP_IMAGE="$IMAGE" \
  GPU_QP_IMAGE_ID="$(docker image inspect "$IMAGE" --format '{% raw %}{{ .Id }}{% endraw %}')" \
  GPU_QP_GIT_SHA="$(source_revision 2>/dev/null || echo unknown)" \
  GPU_QP_DRIVER="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 || true)" \
  python3 - "$run_dir/run.json" <<'PY'
import json
import os
import sys

json.dump(
    {
        "run": os.environ["GPU_QP_RUN_ID"],
        "exit_status": int(os.environ["GPU_QP_STATUS"]),
        "host": os.uname().nodename,
        "arguments": os.environ["GPU_QP_ARGS"],
        "image": {"name": os.environ["GPU_QP_IMAGE"], "id": os.environ["GPU_QP_IMAGE_ID"]},
        "git_sha": os.environ["GPU_QP_GIT_SHA"],
        "driver_version": os.environ["GPU_QP_DRIVER"],
    },
    open(sys.argv[1], "w"),
    indent=2,
    sort_keys=True,
)
PY

  echo
  echo "run directory: $run_dir"
  return "$status"
}

cmd_bench() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
  esac
  require_checkout
  [ -f "$SOURCE/$BENCH_SCRIPT" ] \
    || die "no $BENCH_SCRIPT in $SOURCE - gpu-qp pull a branch that has it, or gpu-qp patch it in"
  require_image

  local run_id run_dir status
  run_id="$(date -u +%Y%m%dT%H%M%SZ)"
  run_dir="$GEN_DIR/$run_id"
  mkdir -p "$run_dir/benchmarks"

  # Like `run`: calling user, HOME and matplotlib cache in /tmp, run directory as
  # gen/. scripts/ and data/ come from the checkout (read-only) so a patched script
  # or data file runs without a rebuild; the installed package is still the image's.
  # The stack's rendered molecules.json replaces the checkout's, as in `run`.
  # (userns_mode: host is set in the compose file; `compose run` has no flag for it.)
  local mounts=()
  if [ -f "$STACK_HOME/data/molecules.json" ] && [ -f "$SOURCE/data/molecules.json" ]; then
    mounts=(-v "$STACK_HOME/data/molecules.json:$CONTAINER_ROOT/data/molecules.json:ro")
  fi
  set +e
  docker compose -f "$COMPOSE_FILE" run --rm -T \
    --user "$(id -u):$(id -g)" \
    -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
    -v "$run_dir:$CONTAINER_ROOT/gen" \
    -v "$run_dir/benchmarks:$CONTAINER_ROOT/benchmarks" \
    -v "$SOURCE/scripts:$CONTAINER_ROOT/scripts:ro" \
    -v "$SOURCE/data:$CONTAINER_ROOT/data:ro" \
    ${mounts[@]+"${mounts[@]}"} \
    --entrypoint python "$SERVICE" \
    "$BENCH_SCRIPT" --output "$CONTAINER_ROOT/gen/bench.json" "$@" 2>&1 | tee "$run_dir/bench.log"
  status=${PIPESTATUS[0]}
  set -e

  echo
  echo "run directory: $run_dir"
  return "$status"
}

cmd_scan() {
  local all=false image=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --all) all=true ;;
      -*) bad_usage "scan: unknown option $1" ;;
      *) [ -z "$image" ] || bad_usage "scan: one image at most"; image="$1" ;;
    esac
    shift
  done
  image="${image:-$IMAGE}"
  docker image inspect "$image" >/dev/null 2>&1 || die "image $image is not present"

  # Trivy exports the image into its container, i.e. into Docker's data root:
  # short of the image's size there, it fills the disk mid-scan and breaks
  # whatever else is running.
  # The remapped data root (userns-remap) is not stat-able by the caller; its
  # parent sits on the same filesystem.
  local need have root
  need="$(docker image inspect "$image" --format '{% raw %}{{ .Size }}{% endraw %}')"
  root="$(docker info --format '{% raw %}{{ .DockerRootDir }}{% endraw %}')"
  have="$(df --output=avail -B1 "$root" 2>/dev/null || df --output=avail -B1 "$(dirname "$root")")"
  have="$(tail -n 1 <<<"$have")"
  [ "$have" -gt "$need" ] \
    || die "scanning $image needs $(numfmt --to=iec-i --suffix=B "$need") free for Docker, $(numfmt --to=iec-i --suffix=B "$have") available"

  local filters=() mounts=()
  if [ "$all" = false ]; then
    filters=(--severity "HIGH,CRITICAL" --ignore-unfixed)
    if [ -f "$SOURCE/.trivyignore" ]; then
      mounts=(-v "$SOURCE/.trivyignore:/trivyignore:ro")
      filters+=(--ignorefile /trivyignore)
    fi
  fi

  mkdir -p "$LOG_DIR" "$TRIVY_CACHE"
  local name
  name="scan-$(date -u +%Y%m%dT%H%M%SZ).json"
  echo "scanning $image ($([ "$all" = true ] && echo "all findings" || echo "HIGH,CRITICAL fixable"))..."

  # Reads the image through the Docker socket; the vulnerability DB is cached
  # under the stack home, so only the first scan of a day downloads it.
  # --userns=host: the daemon remaps user namespaces, which would make the
  # cache and report directories unwritable for the calling user.
  docker run --rm --userns=host \
    --user "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" \
    -e HOME=/tmp \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$TRIVY_CACHE:/cache" \
    -v "$LOG_DIR:/out" \
    "${mounts[@]}" \
    "$TRIVY_IMAGE" image --quiet --cache-dir /cache --scanners vuln --timeout 40m \
    "${filters[@]}" --format json --output "/out/$name" "$image" \
    || die "trivy failed"

  python3 - "$LOG_DIR/$name" <<'PY'
import collections
import json
import sys

report = json.load(open(sys.argv[1]))
found = [
    (result.get("Type", "?"), vuln)
    for result in report.get("Results") or []
    for vuln in result.get("Vulnerabilities") or []
]
severities = collections.Counter(vuln["Severity"] for _, vuln in found)
order = ("CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN")
print(f"  {len(found)} findings" + "".join(f", {severities[s]} {s}" for s in order if severities[s]))
if not found:
    sys.exit()

print("  -- by source --")
for source, count in collections.Counter(kind for kind, _ in found).most_common():
    print(f"  {count:6}  {source}")

print("  -- top packages --")
packages = collections.Counter(
    (vuln["PkgName"], vuln.get("InstalledVersion", "?"), vuln.get("FixedVersion") or "no fix")
    for _, vuln in found
)
for (name, installed, fixed), count in packages.most_common(10):
    print(f"  {count:6}  {name} {installed} -> {fixed}")
PY
  echo "report: $LOG_DIR/$name"
}

command="${1:-}"
[ $# -eq 0 ] || shift
case "$command" in
  pull|patch|build|check|run|bench|scan) "cmd_$command" "$@" ;;
  help|-h|--help) usage ;;
  "") usage >&2; exit 2 ;;
  *) bad_usage "unknown command: $command" ;;
esac
