#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# Lean status of the gpu-qp worker. Read-only and safe at any time. Candidate
# `gpu-qp status` subcommand.
#
# Sections (equal-width [ NAME ] blocks):
#   HOST    cores / load / mem / disk / per-GPU utilisation
#   IMAGE   the role's image and its build fingerprint
#   STACK   the role's own compose stack
#   BENCH   the benchmark phases, when a bench/ tree is present (see notes/BENCH-NEXT.md)
#   GEN     the solver's gen/ tree and the undelivered spool
#   LOGS    the newest build log line
#
#   gpu-qp-status.sh [phase...]     # default: A B C
set -u

STACK_HOME="{{ gpu_qp_home }}"
SOURCE="{{ gpu_qp_source_path }}"
GEN="{{ gpu_qp_gen_path }}"
LOG_DIR="{{ gpu_qp_log_path }}"
IMAGE="{{ gpu_qp_image_name }}"
FINGERPRINT="{{ gpu_qp_build_fingerprint_file }}"
COMPOSE_FILE="$STACK_HOME/docker-compose.yml"
EXPORTER_PORT="{{ gpu_qp_gpu_exporter_port }}"
BENCH="$STACK_HOME/bench"

LANES=(cpu-aer gpu1 gpu2 analytic)
PHASES=("$@")
[ ${#PHASES[@]} -eq 0 ] && PHASES=(A B C)
declare -A EXPECT=([A]=18 [B]=6 [C]=1 [S]=1)

IW=9
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[0m'
  CY=$'\033[36m'; GR=$'\033[32m'; YE=$'\033[33m'; RE=$'\033[31m'
else
  B=; D=; R=; CY=; GR=; YE=; RE=
fi
hdr() {
  local n=$1 p l r inner
  p=$((IW - ${#n})); [ "$p" -lt 2 ] && p=2
  l=$((p / 2)); r=$((p - l))
  printf -v inner '%*s%s%*s' "$l" '' "$n" "$r" ''
  printf '\n%s[%s]%s\n' "$B$CY" "$inner" "$R"
}
# kv <label> <value> [colour]
kv() {
  local label=$1 value=$2 colour=${3:-}
  if [ -n "$colour" ]; then
    printf '  %s%-16s%s%s%s%s\n' "$D" "$label" "$R" "$colour" "$value" "$R"
  else
    printf '  %s%-16s%s%s\n' "$D" "$label" "$R" "$value"
  fi
}

printf '%sgpu-qp status%s  %s  %s\n' "$B" "$R" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(hostname)"

hdr HOST
printf '  cores %s   load %s   mem %s free   disk %s free (%s)\n' \
  "$(nproc)" "$(awk '{print $1,$2,$3}' /proc/loadavg)" \
  "$(free -h | awk 'NR==2{print $7}')" \
  "$(df -h / | awk 'NR==2{print $4}')" "$(df -h / | awk 'NR==2{print $5}')"
nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used --format=csv,noheader \
  | awk -F', ' '{printf "  gpu%s  %-18s %-4s %s\n", $1, $2, $3, $4}'

hdr IMAGE
kv image "$IMAGE"
if [ -f "$FINGERPRINT" ]; then
  kv build "$(cat "$FINGERPRINT")"
else
  kv build "(no build fingerprint)" "$D"
fi
kv exporter ":$EXPORTER_PORT"

hdr STACK
if [ -f "$COMPOSE_FILE" ]; then
  docker compose -f "$COMPOSE_FILE" ps --format '{{.Name}} {{.Status}}' 2>/dev/null \
    | sed 's/^/  /' || printf '  (compose unavailable)\n'
else
  printf '  (no %s)\n' "$COMPOSE_FILE"
fi

hdr BENCH
if [ -d "$BENCH" ]; then
  ps -eo args > /tmp/.gs.$$
  printf '  supervisor %s   driver %s   lanes %s   sampler %s\n' \
    "$(grep -c '[g]pu-qp-supervise.sh' /tmp/.gs.$$)" \
    "$(grep -c '[g]pu-qp-phase.sh' /tmp/.gs.$$)" \
    "$(grep -c '[g]pu-qp-lane.sh' /tmp/.gs.$$)" \
    "$(grep -c '[g]pu-qp-sample.sh run' /tmp/.gs.$$)"
  rm -f /tmp/.gs.$$
  for p in "${PHASES[@]}"; do
    s=$BENCH/$p/state.tsv
    if [ ! -f "$s" ]; then printf '  %s  not started\n' "$p"; continue; fi
    row=""
    for lane in "${LANES[@]}"; do
      read -r dn fa < <(awk -F'\t' -v l="$lane" \
        '$1==l{if($4=="done"||$4=="done-unstreamed")d++; if($4=="failed")f++} END{print d+0, f+0}' "$s")
      row="$row$lane $dn/${EXPECT[$p]:-?}"
      [ "$fa" -gt 0 ] && row="$row+$fa!"
      row="$row  "
    done
    printf '  %s  %s\n' "$p" "${row% }"
  done
  [ -f "$BENCH/out/runs.csv" ] && \
    printf '  extracted  %s runs\n' "$(($(wc -l < "$BENCH/out/runs.csv") - 1))"
  [ -f "$BENCH/supervise.done" ] && printf '  %s\n' "$(cat "$BENCH/supervise.done")"
else
  printf '  (no bench/ tree)\n'
fi

# Per-cell spools: one line per phase/lane, "<phase>/<lane>  <files> file(s)  <cell>(<n>) ...".
# Read-only; prints nothing when no cell spooled.
cell_spools() {
  local d n rel ph ln cell
  for d in "$BENCH"/*/*/*.gen/undelivered; do
    [ -d "$d" ] || continue
    n=$(ls -A "$d" 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] || continue
    rel=${d#"$BENCH"/}
    IFS=/ read -r ph ln cell _ <<< "$rel"
    printf '%s/%s\t%s\t%s\n' "$ph" "$ln" "${cell%.gen}" "$n"
  done | awk -F'\t' '{t[$1]+=$3; c[$1]=c[$1] " " $2 "(" $3 ")"; if(!($1 in o)){o[$1]=++k; key[k]=$1}}
    END{for(i=1;i<=k;i++) printf "%s  %d file(s) in%s\n", key[i], t[key[i]], c[key[i]]}'
}

hdr GEN
printf '  %s\n' "$GEN"
[ -d "$GEN/undelivered" ] && printf '  undelivered %s\n' "$(ls -A "$GEN/undelivered" 2>/dev/null | wc -l)"
cell_spools | while read -r l; do printf '  undelivered %s\n' "$l"; done
for f in "$GEN"/performance_metrics/*.jsonl; do
  [ -f "$f" ] && printf '  %s  %s lines\n' "$(basename "$f")" "$(wc -l < "$f")"
done

hdr LOGS
if [ -f "$LOG_DIR/build-latest.log" ]; then
  printf '  %s\n' "$(tail -1 "$LOG_DIR/build-latest.log")"
else
  printf '  (no build log in %s)\n' "$LOG_DIR"
fi
