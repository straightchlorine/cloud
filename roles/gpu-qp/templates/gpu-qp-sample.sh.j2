#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# Samples GPU utilisation and load average every 30 s into <bench>/<phase>/nvidia.csv and
# loadavg.csv. Idempotent start/stop via <bench>/<phase>/sampler.pid.
#
# GPU_QP_BENCH selects the bench root, so a second run (e.g. the convergence run in bench/conv)
# samples into its own tree. Candidate `gpu-qp sample start|stop <phase>` subcommand.
set -u

BENCH=${GPU_QP_BENCH:-{{ gpu_qp_home }}/bench}
ACTION=${1:-start}
PHASE=${2:-A}
DIR=$BENCH/$PHASE
PIDF=$DIR/sampler.pid
mkdir -p "$DIR"

loop() {
  echo 'ts,gpu_index,util_pct,mem_used_mib' > "$DIR/nvidia.csv"
  echo 'ts,load1,load5,load15' > "$DIR/loadavg.csv"
  while :; do
    ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    nvidia-smi --query-gpu=index,utilization.gpu,memory.used \
      --format=csv,noheader,nounits 2>/dev/null | sed "s/^/$ts,/" >> "$DIR/nvidia.csv"
    printf '%s,%s\n' "$ts" "$(awk '{print $1","$2","$3}' /proc/loadavg)" >> "$DIR/loadavg.csv"
    sleep 30
  done
}

case "$ACTION" in
  run) loop ;;
  start)
    if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; then
      echo "sampler already running (pid $(cat "$PIDF"))"
      exit 0
    fi
    setsid nohup "$0" run "$PHASE" >/dev/null 2>&1 < /dev/null &
    echo $! > "$PIDF"
    echo "sampler started (pid $(cat "$PIDF"), dir $DIR)"
    ;;
  stop)
    if [ -f "$PIDF" ]; then
      kill "$(cat "$PIDF")" 2>/dev/null && echo "sampler stopped (pid $(cat "$PIDF"))"
      rm -f "$PIDF"
    else
      echo "sampler not running"
    fi
    ;;
  *) echo "usage: $0 start|stop [phase]" >&2; exit 2 ;;
esac
