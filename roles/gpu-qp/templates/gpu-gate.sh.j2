#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# GPU readiness gate for the ML stack: six numbered steps, one evidence file each, exit on the
# first failure. Run it before a long benchmark. Writes to <evidence-dir> (default
# {{ gpu_qp_home }}/bench/gpu-gate).
#
#   gpu-gate.sh [evidence-dir]
#
# Steps:
#   1  gpu-qp check                      driver + toolkit + the built image
#   2  role path, device 1               2-evaluation H2 run with NVIDIA_VISIBLE_DEVICES=1
#   3  stack path, device 0              2-evaluation H2 run via the ML stack's gpu1 service
#   4  stack path, device 1              same with gpu2
#   5  CPU image via the stack           --no-analytic; must log 'Using exact Aer estimator'
#   6  Kafka + Garage                    undelivered empty, topic has records
#
# Known outcomes on gpu-station 2026-10 (see notes/BENCH-NEXT.md):
#   step 2 FAILS - the role compose reserves `devices: count: all`, so NVIDIA_VISIBLE_DEVICES=1
#     is ignored and the process touches both cards. The lanes do not use this path.
#   steps 3-5 need the compose override (userns_mode: host) or `runtime: nvidia` is refused.
set -u

STACK_HOME="{{ gpu_qp_home }}"
SOURCE="{{ gpu_qp_source_path }}"
OUT=${1:-$STACK_HOME/bench/gpu-gate}
mkdir -p "$OUT"

step() { printf '\n[ %s ] %s\n' "$1" "$2"; }
die() { echo "GATE FAILED: $*" >&2; exit 1; }

step 1 "gpu-qp check"
gpu-qp check > "$OUT/01-role-check.txt" 2>&1 || die "step 1 (gpu-qp check) - see $OUT/01-role-check.txt"
grep -q '\[OK\]' "$OUT/01-role-check.txt" || die "step 1 produced no [OK] lines"

step 2 "role path, device 1 (expected to fail on gpu-station: role reserves count: all)"
docker compose -f "$STACK_HOME/docker-compose.yml" run --rm -T \
  --user "$(id -u):$(id -g)" -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
  -e NVIDIA_VISIBLE_DEVICES=1 quantum-pipeline-gpu \
  --file data/molecules.json --molecule-index 0 --basis sto3g --max-iterations 2 --gpu \
  > "$OUT/02-role-dev1.txt" 2>&1 || echo "  (step 2 exited non-zero; that is the known outcome)"

step 3 "stack path, device 0"
cd "$SOURCE" || die "no checkout at $SOURCE"
docker compose -p ml --env-file .env -f compose/docker-compose.ml.yaml \
  -f "$STACK_HOME/bench/override.yml" --profile batch run --rm -T \
  --user "$(id -u):$(id -g)" -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
  quantum-pipeline-gpu1 --file data/molecules.thesis.json --molecule-index 0 --basis sto3g \
  --max-iterations 2 --gpu > "$OUT/03-stack-gpu1.txt" 2>&1 \
  || die "step 3 (stack device 0) - see $OUT/03-stack-gpu1.txt"

step 4 "stack path, device 1"
docker compose -p ml --env-file .env -f compose/docker-compose.ml.yaml \
  -f "$STACK_HOME/bench/override.yml" --profile batch run --rm -T \
  --user "$(id -u):$(id -g)" -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
  quantum-pipeline-gpu2 --file data/molecules.thesis.json --molecule-index 0 --basis sto3g \
  --max-iterations 2 --gpu > "$OUT/04-stack-gpu2.txt" 2>&1 \
  || die "step 4 (stack device 1) - see $OUT/04-stack-gpu2.txt"

step 5 "CPU image via the stack (--no-analytic)"
docker compose -p ml --env-file .env -f compose/docker-compose.ml.yaml \
  -f "$STACK_HOME/bench/override.yml" --profile batch run --rm -T \
  --user "$(id -u):$(id -g)" -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
  quantum-pipeline-cpu --file data/molecules.thesis.json --molecule-index 0 --basis sto3g \
  --max-iterations 2 --no-analytic > "$OUT/05-stack-cpu.txt" 2>&1 \
  || die "step 5 (CPU via stack) - see $OUT/05-stack-cpu.txt"
grep -q 'Using exact Aer estimator' "$OUT/05-stack-cpu.txt" \
  || die "step 5: CPU lane did not use the exact Aer estimator"
grep -q 'Analytic-gradient' "$OUT/05-stack-cpu.txt" \
  && die "step 5: --no-analytic did not take effect"

step 6 "Kafka + Garage"
ls -A "{{ gpu_qp_gen_path }}/undelivered" > "$OUT/06-undelivered.txt" 2>/dev/null || true
[ -s "$OUT/06-undelivered.txt" ] && die "step 6: gen/undelivered is not empty"
docker exec ml-kafka /opt/kafka/bin/kafka-console-consumer.sh \
  --bootstrap-server kafka:9092 --topic experiment.vqe --from-beginning --max-messages 3 \
  --timeout-ms 8000 > "$OUT/06-topic.txt" 2>/dev/null || true
[ -s "$OUT/06-topic.txt" ] || die "step 6: no records on experiment.vqe"

printf '\nGATE PASSED - evidence in %s\n' "$OUT"
