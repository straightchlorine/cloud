#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# Build the GPU image from the source checkout. The deploy runs this too, so a
# by-hand build and a deployed one are the same build.
#
# The Dockerfile actually built is a composed copy of the upstream one: the CUDA
# base pinned to the role's version, plus the forward-compat strip. It is written
# outside the checkout, so gpu-qp-pull always finds a clean tree.

set -euo pipefail

SOURCE="{{ gpu_qp_source_path }}"
IMAGE="{{ gpu_qp_image_name }}"
DOCKERFILE="{{ gpu_qp_pinned_dockerfile }}"
FINGERPRINT_FILE="{{ gpu_qp_build_fingerprint_file }}"
LOG_DIR="{{ gpu_qp_log_path }}"
CUDA_VERSION="{{ gpu_qp_cuda_version }}"
CUDA_ARCH="{{ gpu_qp_cuda_arch }}"
AER_VERSION="{{ gpu_qp_aer_version }}"

FORCE=false
DRY_RUN=false
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      cat <<EOF
Usage: gpu-qp-build [--force] [--dry-run]

Builds $IMAGE from $SOURCE.

The build is skipped when nothing that defines it changed since the last
successful one: the composed Dockerfile, CUDA_ARCH, AER_VERSION and the source
revision. A rebuild after an app-code change is fast - Docker reuses every
cached layer before the source copy.

  --force    build even when the fingerprint matches
  --dry-run  write the composed Dockerfile and stop

Composed Dockerfile: $DOCKERFILE
Logs:                $LOG_DIR/build-<UTC timestamp>.log (build-latest.log links the newest)
CUDA $CUDA_VERSION, arch $CUDA_ARCH, aer $AER_VERSION
EOF
      exit 0
      ;;
    --force) FORCE=true ;;
    --dry-run) DRY_RUN=true ;;
    *) echo "unknown argument: $arg (see --help)" >&2; exit 2 ;;
  esac
done

if [ ! -f "$SOURCE/docker/Dockerfile.gpu" ]; then
  echo "[FAIL] no docker/Dockerfile.gpu under $SOURCE - deploy the role first" >&2
  exit 1
fi

# Every FROM gets the pinned version, so a multi-stage file stays consistent.
sed -E "s#nvidia/cuda:[0-9][0-9.]*-cudnn-#nvidia/cuda:${CUDA_VERSION}-cudnn-#g" \
  "$SOURCE/docker/Dockerfile.gpu" > "$DOCKERFILE"
{% if gpu_qp_strip_cuda_compat %}
# Appended, so it lands in the final (runtime) stage.
cat >> "$DOCKERFILE" <<'STRIP'
{{ gpu_qp_compat_strip_block }}
STRIP
{% endif %}

if [ "$DRY_RUN" = true ]; then
  echo "[OK] composed $DOCKERFILE"
  exit 0
fi

# safe.directory: the deploy clones as the stack user, and this may run as root.
revision="$(git -c "safe.directory=$SOURCE" -C "$SOURCE" rev-parse HEAD)"
fingerprint="$( { cat "$DOCKERFILE"; echo "$CUDA_ARCH $AER_VERSION $revision"; } | sha1sum | cut -d' ' -f1)"

if [ "$FORCE" = false ] \
   && docker image inspect "$IMAGE" >/dev/null 2>&1 \
   && [ "$(cat "$FINGERPRINT_FILE" 2>/dev/null)" = "$fingerprint" ]; then
  echo "[OK] $IMAGE is up to date (${revision:0:12})"
  exit 0
fi

mkdir -p "$LOG_DIR"
log="$LOG_DIR/build-$(date -u +%Y%m%dT%H%M%SZ).log"
ln -sfn "$(basename "$log")" "$LOG_DIR/build-latest.log"
echo "building $IMAGE at ${revision:0:12} - log: $log"

if ! docker build --progress=plain \
     -f "$DOCKERFILE" \
     --build-arg CUDA_ARCH="$CUDA_ARCH" \
     --build-arg AER_VERSION="$AER_VERSION" \
     -t "$IMAGE" \
     "$SOURCE" > "$log" 2>&1; then
  tail -n 30 "$log" >&2
  echo "[FAIL] build failed - full log: $log" >&2
  exit 1
fi

# Written only after a successful build, so a failed one is retried next time.
echo "$fingerprint" > "$FINGERPRINT_FILE"
echo "[OK] built $IMAGE at ${revision:0:12} - log: $log"
