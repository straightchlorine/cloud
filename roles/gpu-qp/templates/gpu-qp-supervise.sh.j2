#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# Runs the given phases back to back, each with its own sampler and extraction, then writes
# <bench>/supervise.done. With no arguments: A B C.
#
# Launch detached, e.g.:
#   setsid nohup bash gpu-qp-supervise.sh A >/dev/null 2>&1 </dev/null &
# and for the convergence run into a separate tree:
#   GPU_QP_BENCH=~/gpu-qp/bench/conv setsid nohup bash gpu-qp-supervise.sh A2 ...
#
# Stop with: pkill -f gpu-qp-supervise.sh   (the running lane is left alone and can be resumed,
# because gpu-qp-lane.sh skips cells marked `done`).
#
# NOTE: nothing here self-schedules. An agent does not wake on its own; if you want to be notified
# when a phase finishes, poll for <bench>/supervise.done or <bench>/<phase>/phase.log from a
# background job.
set -u

BENCH=${GPU_QP_BENCH:-{{ gpu_qp_home }}/bench}
# Sibling scripts live beside this file, not in the bench tree: GPU_QP_BENCH may point at a
# second tree (e.g. bench/conv) that holds only data.
HERE=$(cd "$(dirname "$0")" && pwd)
OUT=$BENCH/out
PHASES=("$@")
[ ${#PHASES[@]} -eq 0 ] && PHASES=(A B C)
mkdir -p "$OUT"

extract() {
  python3 "$HERE/bench-extract.py" "$BENCH" "$OUT" > "$BENCH/$1/extract.log" 2>&1
  echo "[supervise] extracted after $1 -> $OUT/runs.csv" >> "$BENCH/supervise.log"
}

run_phase() {
  local p=$1
  echo "[supervise] phase $p start $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$BENCH/supervise.log"
  "$HERE/gpu-qp-sample.sh" start "$p" >/dev/null 2>&1
  bash "$HERE/gpu-qp-phase.sh" "$p"
  "$HERE/gpu-qp-sample.sh" stop "$p" >/dev/null 2>&1
  extract "$p"
  echo "[supervise] phase $p done $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$BENCH/supervise.log"
}

echo "[supervise] start $(date -u +%Y-%m-%dT%H:%M:%SZ) phases=${PHASES[*]} bench=$BENCH" \
  >> "$BENCH/supervise.log"

for p in "${PHASES[@]}"; do
  run_phase "$p"
done

echo "SUPERVISE_DONE $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$BENCH/supervise.done"
