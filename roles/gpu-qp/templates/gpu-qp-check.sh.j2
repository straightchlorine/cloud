#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# Prove the GPU image can actually run on the GPU. A simulation that falls back
# to the CPU still exits 0, so this checks the GPU path itself instead of
# trusting an exit code.
#
# The GPU-side checks run inside the worker container, so they see exactly the
# image and the device a simulation gets.

set -euo pipefail

STACK_HOME="{{ gpu_qp_home }}"
COMPOSE_FILE="$STACK_HOME/docker-compose.yml"
SERVICE="quantum-pipeline-gpu"
IMAGE="{{ gpu_qp_image_name }}"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<EOF
Usage: gpu-qp-check

Proves the built image runs on the GPU, by running inside the worker container:
  - Aer's available_devices() lists GPU
  - a Bell circuit executed with device="GPU" - which cannot quietly fall back
    to the CPU, the CUDA controller raises instead
  - ldd resolves every one of Aer's shared objects

Exits non-zero on the first failure. Also prints the image size, the driver
version and the cards' compute capability. The role's post-deploy validation
runs this.

Image: $IMAGE
EOF
  exit 0
fi

echo "== gpu-qp-check =="

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "[FAIL] image $IMAGE is not present - deploy the stack first" >&2
  exit 1
fi

echo "-- image --"
echo "  $IMAGE $(docker image inspect "$IMAGE" --format '{% raw %}{{ .Size }}{% endraw %}' | numfmt --to=iec-i --suffix=B)"

echo "-- host GPU --"
nvidia-smi --query-gpu=name,driver_version,compute_cap --format=csv,noheader | sed 's/^/  /'

echo "-- container --"
docker compose -f "$COMPOSE_FILE" run --rm -T --entrypoint bash "$SERVICE" -s <<'INNER'
set -euo pipefail

python - <<'PY'
import sys
from qiskit_aer import AerSimulator

devices = AerSimulator().available_devices()
print(f"  available_devices(): {devices}")
if "GPU" not in devices:
    sys.exit("  [FAIL] Aer advertises no GPU - this build is CPU-only")
print("  [OK]   Aer advertises GPU")
PY

python - <<'PY'
import sys
from qiskit import QuantumCircuit, transpile
from qiskit_aer import AerSimulator

circuit = QuantumCircuit(2)
circuit.h(0)
circuit.cx(0, 1)
circuit.measure_all()

simulator = AerSimulator(device="GPU", method="statevector", seed_simulator=1234)
try:
    counts = simulator.run(transpile(circuit, simulator), shots=256).result().get_counts()
except Exception as exc:
    sys.exit(f"  [FAIL] GPU execution raised: {exc}")

if set(counts) - {"00", "11"}:
    sys.exit(f"  [FAIL] Bell state produced unexpected counts: {counts}")
print(f"  [OK]   GPU execution produced a Bell distribution: {counts}")
PY

aer_dir="$(python -c 'import os, qiskit_aer; print(os.path.dirname(qiskit_aer.__file__))')"
unresolved="$(find "$aer_dir" -name '*.so' -exec ldd {} + 2>/dev/null | grep 'not found' || true)"
if [ -n "$unresolved" ]; then
    echo "  [FAIL] unresolved shared objects:"
    printf '%s\n' "$unresolved" | sed 's/^/    /'
    exit 1
fi
echo "  [OK]   every Aer shared object resolves"
INNER
