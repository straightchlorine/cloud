#!/bin/sh
# GPU VQE run through the gpu-qp stack. Arguments are appended to the CLI, so the
# defaults below can be overridden: gpu-qp-run --basis cc-pvdz
# Reports and plots land in {{ gpu_qp_gen_path }}.
set -eu
exec docker compose -f "{{ gpu_qp_home }}/docker-compose.yml" run --rm \
  quantum-pipeline-gpu \
  --file {{ gpu_qp_container_molecules_path }} \
  --basis {{ gpu_qp_basis }} \
  --max-iterations {{ gpu_qp_max_iterations }} \
  --optimizer {{ gpu_qp_optimizer }} \
  --gpu \
  --report \
  "$@"
