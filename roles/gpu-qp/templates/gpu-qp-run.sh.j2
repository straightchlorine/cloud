#!/usr/bin/env bash
# Managed by Ansible - Do not edit manually
#
# One quantum-pipeline simulation on the GPU: a `docker compose run` of the
# gpu-qp stack's batch worker. Arguments are appended after the defaults below,
# so they override them by name.
#
# Every run gets its own gen/<UTC timestamp>/ directory, so consecutive runs
# never overwrite each other.

set -euo pipefail

STACK_HOME="{{ gpu_qp_home }}"
COMPOSE_FILE="$STACK_HOME/docker-compose.yml"
SERVICE="quantum-pipeline-gpu"
GEN_DIR="{{ gpu_qp_gen_path }}"
SOURCE="{{ gpu_qp_source_path }}"
IMAGE="{{ gpu_qp_image_name }}"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<EOF
Usage: gpu-qp-run [solver-option]...

Runs one quantum-pipeline VQE simulation on the GPU. The worker is a batch
service, so \`docker compose up\` does not start it - this is how it runs.

Every run is prefixed with:
  --file {{ gpu_qp_container_molecules_path }}
  --basis {{ gpu_qp_basis }}
  --max-iterations {{ gpu_qp_max_iterations }}
  --optimizer {{ gpu_qp_optimizer }}
  --gpu --report

Arguments given here are appended after those, so the solver's argparse lets
them override the default with the same name.

Each run writes to its own {{ gpu_qp_gen_path }}/<UTC timestamp>/ directory:
  run.log    the run's combined output, teed live
  run.json   arguments, image id, source git sha and driver version
  the report and convergence plots

Examples:
  gpu-qp-run
  gpu-qp-run --molecule-index 1
  gpu-qp-run --basis cc-pvdz --max-iterations 250

Related:
  gpu-qp-check    prove the image really runs on the GPU
  gpu-qp-pull     update the source checkout this image was built from
  scripts/gpu-qp/collect.sh (run from your workstation)  copy the runs back
EOF
  exit 0
fi

RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
RUN_DIR="$GEN_DIR/$RUN_ID"
mkdir -p "$RUN_DIR"

# --user so the artifacts belong to the invoking account rather than container
# root; matplotlib then needs a writable config dir, which a non-root HOME does
# not give it by default.
set +e
docker compose -f "$COMPOSE_FILE" run --rm -T \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp -e MPLCONFIGDIR=/tmp/matplotlib \
  -v "$RUN_DIR:/usr/src/quantum_pipeline/gen" \
  "$SERVICE" \
  --file {{ gpu_qp_container_molecules_path }} \
  --basis {{ gpu_qp_basis }} \
  --max-iterations {{ gpu_qp_max_iterations }} \
  --optimizer {{ gpu_qp_optimizer }} \
  --gpu \
  --report \
  "$@" 2>&1 | tee "$RUN_DIR/run.log"
status=${PIPESTATUS[0]}
set -e

GPU_QP_RUN_ID="$RUN_ID" GPU_QP_STATUS="$status" GPU_QP_ARGS="$*" \
GPU_QP_IMAGE="$IMAGE" GPU_QP_IMAGE_ID="$(docker image inspect "$IMAGE" --format '{% raw %}{{ .Id }}{% endraw %}')" \
GPU_QP_GIT_SHA="$(git -C "$SOURCE" rev-parse HEAD 2>/dev/null || echo unknown)" \
GPU_QP_DRIVER="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 || true)" \
python3 - "$RUN_DIR/run.json" <<'PY'
import json
import os
import sys

json.dump(
    {
        'run': os.environ['GPU_QP_RUN_ID'],
        'exit_status': int(os.environ['GPU_QP_STATUS']),
        'host': os.uname().nodename,
        'arguments': os.environ['GPU_QP_ARGS'],
        'image': {
            'name': os.environ['GPU_QP_IMAGE'],
            'id': os.environ['GPU_QP_IMAGE_ID'],
        },
        'git_sha': os.environ['GPU_QP_GIT_SHA'],
        'driver_version': os.environ['GPU_QP_DRIVER'],
    },
    open(sys.argv[1], 'w'),
    indent=2,
    sort_keys=True,
)
PY

echo
echo "run directory: $RUN_DIR"
exit "$status"
