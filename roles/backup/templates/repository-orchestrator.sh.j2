#!/bin/bash
# Repository Orchestrator
# {{ ansible_managed }}
# Orchestrates backup operations across repositories

set -euo pipefail

# Configuration
BACKUP_BASE="{{ backup_base_path }}"
LOG_FILE="${BACKUP_BASE}/logs/orchestrator-$(date +%Y%m%d).log"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "$LOG_FILE"
}

error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
    log "ERROR: $1"
}

success() {
    echo -e "${GREEN}[OK] $1${NC}"
    log "SUCCESS: $1"
}

orchestrate() {
    log "Starting backup orchestration..."

    # Use coordinator to manage backups
    if [[ -x "${BACKUP_BASE}/scripts/backup-coordinator.sh" ]]; then
        "${BACKUP_BASE}/scripts/backup-coordinator.sh" request "{{ device_role }}"
    else
        error "Backup coordinator not found"
        return 1
    fi

    success "Backup orchestration completed"
}

show_help() {
    cat << EOF
Repository Orchestrator

Usage: $0 [options]

Options:
  --orchestrate    Start backup orchestration (default)
  --help          Show this help

EOF
}

main() {
    case "${1:---orchestrate}" in
        "--orchestrate")
            orchestrate
            ;;
        "--help")
            show_help
            ;;
        *)
            show_help
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi