#!/usr/bin/env python3
"""
Deduplication Analyzer
{{ ansible_managed }}
Analyzes backup repository deduplication efficiency
"""

import os
import sys
import json
import subprocess

# Configuration
REPOSITORY = "{{ restic_repository }}"
PASSWORD_FILE = "{{ backup_base_path }}/keys/{{ device_role }}-password"

# Set environment
os.environ['RESTIC_REPOSITORY'] = REPOSITORY
os.environ['RESTIC_PASSWORD_FILE'] = PASSWORD_FILE

def run_restic_command(args):
    """Run a restic command and return the output"""
    try:
        cmd = ['restic'] + args
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error running restic command: {e}")
        return None

def analyze_deduplication():
    """Analyze deduplication efficiency"""
    print("🔄 Deduplication Analysis")
    print("=" * 30)

    # Get repository stats
    stats_output = run_restic_command(['stats', '--json'])
    if stats_output:
        stats = json.loads(stats_output)
        total_size = stats.get('total_size', 0)
        print(f"Repository size: {total_size:,} bytes")

    print("\n✅ Deduplication analysis complete")

def show_help():
    """Show help information"""
    print(f"""
Deduplication Analyzer

Usage: python3 analyze-deduplication.py [options]

Options:
  --help    Show this help

Environment:
  Repository: {REPOSITORY}
  Password File: {PASSWORD_FILE}
""")

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--help":
        show_help()
    else:
        analyze_deduplication()