#!/bin/bash
# Encryption Key Management Script
# {{ ansible_managed }}
# Manages encryption keys for backup repositories

set -euo pipefail

# Configuration
BACKUP_BASE="{{ backup_base_path }}"
KEYS_DIR="${BACKUP_BASE}/keys"
SERVICE="{{ device_role }}"
KEY_FILE="${KEYS_DIR}/${SERVICE}-password"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
    log "ERROR: $1"
}

success() {
    echo -e "${GREEN}[OK] $1${NC}"
    log "SUCCESS: $1"
}

warning() {
    echo -e "${YELLOW}[WARN]  $1${NC}"
    log "WARNING: $1"
}

# Check key file
check_key() {
    log "Checking encryption key for service: ${SERVICE}"

    if [[ -f "$KEY_FILE" ]]; then
        local perms=$(stat -c "%a" "$KEY_FILE")
        if [[ "$perms" == "600" ]]; then
            success "Key file exists with correct permissions"
        else
            warning "Key file permissions are $perms, should be 600"
            chmod 600 "$KEY_FILE"
            success "Fixed key file permissions"
        fi
    else
        error "Key file not found: $KEY_FILE"
        return 1
    fi
}

# Rotate key (placeholder - requires manual intervention)
rotate_key() {
    warning "Key rotation requires manual intervention and repository migration"
    echo "Current key file: $KEY_FILE"
    echo "To rotate key:"
    echo "1. Create new repository with new key"
    echo "2. Transfer all snapshots to new repository"
    echo "3. Update configuration to use new repository"
    echo "4. Remove old repository"
}

# Show key info
show_info() {
    log "Encryption key information for service: ${SERVICE}"
    echo "Key file: $KEY_FILE"
    if [[ -f "$KEY_FILE" ]]; then
        echo "Permissions: $(stat -c "%a %U:%G" "$KEY_FILE")"
        echo "Size: $(stat -c "%s" "$KEY_FILE") bytes"
        echo "Modified: $(stat -c "%y" "$KEY_FILE")"
    else
        error "Key file not found"
    fi
}

show_help() {
    cat << EOF
Encryption Key Management Script

Usage: $0 <command>

Commands:
  check     Check key file existence and permissions
  info      Show key file information
  rotate    Show key rotation instructions
  help      Show this help

Environment:
  Service: ${SERVICE}
  Key File: ${KEY_FILE}

EOF
}

main() {
    case "${1:-help}" in
        "check")
            check_key
            ;;
        "info")
            show_info
            ;;
        "rotate")
            rotate_key
            ;;
        "help"|*)
            show_help
            ;;
    esac
}

# Script execution
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi