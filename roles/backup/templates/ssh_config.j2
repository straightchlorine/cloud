# SSH Config for Backup Operations
# Managed by Ansible - Do not edit manually

# Global SSH settings for all connections
Host *
    # Keep-alive settings for unreliable networks
    ServerAliveInterval 30
    # Allow 10 missed keep-alives before giving up
    ServerAliveCountMax 10
    # Enable TCP keep-alive at the socket level
    TCPKeepAlive yes

    # Strict host key checking
    StrictHostKeyChecking accept-new

    # Connection timeout
    ConnectTimeout 30

# Hetzner Storage Box Configuration
Host hetzner-storage
    HostName {{ vault_backup_storage_host }}
    User {{ vault_backup_storage_user }}
    Port {{ vault_backup_storage_port }}
    IdentityFile {{ backup_base_path }}/.ssh/hetzner
    BatchMode yes
    PasswordAuthentication no

    # Compression helps reduce bandwidth usage during large transfers
    Compression yes

    # Aggressive keep-alive for Hetzner
    ServerAliveInterval 20
    ServerAliveCountMax 10
    TCPKeepAlive yes

{% if backup_role == "coordinator" %}
# Coordinator Target Hosts
{% for target in coordinator_targets %}
Host {{ target.hostname }}
    HostName {{ target.hostname }}
    User {{ target.ssh_user }}
    IdentityFile {{ target.ssh_key }}
    BatchMode yes
    PasswordAuthentication no
    StrictHostKeyChecking accept-new
    Compression yes

    # Keep-alive for SSHFS mounts
    ServerAliveInterval 30
    ServerAliveCountMax 10
    TCPKeepAlive yes

{% endfor %}
{% endif %}
