#!/bin/bash
# Repository Health Check Script
# {{ ansible_managed }}
# Performs health checks on backup repositories

set -euo pipefail

# Configuration
BACKUP_BASE="{{ backup_base_path }}"
RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ backup_base_path }}/keys/{{ device_role }}-password"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Logging
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
    log "ERROR: $1"
}

success() {
    echo -e "${GREEN}✅ $1${NC}"
    log "SUCCESS: $1"
}

warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
    log "WARNING: $1"
}

# Check repository connectivity
check_connectivity() {
    log "Checking repository connectivity..."

    if restic snapshots --quiet >/dev/null 2>&1; then
        success "Repository is accessible"
        return 0
    else
        error "Cannot connect to repository"
        return 1
    fi
}

# Check repository integrity
check_integrity() {
    log "Performing repository integrity check..."

    if restic check --quiet; then
        success "Repository integrity check passed"
        return 0
    else
        error "Repository integrity check failed"
        return 1
    fi
}

# Quick health check
quick_check() {
    local exit_code=0

    log "Performing quick health check..."

    check_connectivity || exit_code=1

    # Basic repository stats
    if restic stats --quiet >/dev/null 2>&1; then
        success "Repository statistics accessible"
    else
        warning "Cannot retrieve repository statistics"
        exit_code=1
    fi

    return $exit_code
}

# Full health check
full_check() {
    local exit_code=0

    log "Performing full health check..."

    check_connectivity || exit_code=1
    check_integrity || exit_code=1

    return $exit_code
}

# Show help
show_help() {
    cat << EOF
Repository Health Check Script

Usage: $0 [options]

Options:
  --repository <type>  Repository type (critical, services, system)
  --quick-check        Perform quick connectivity check
  --full-check         Perform full integrity check (default)
  --help               Show this help

Environment:
  Repository: ${RESTIC_REPOSITORY}
  Password File: ${RESTIC_PASSWORD_FILE}

Examples:
  $0 --repository critical --quick-check
  $0 --repository services --full-check
  $0 --help

EOF
}

# Main function
main() {
    local action="full"
    local repo_type=""

    # Parse command line arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --repository)
                repo_type="$2"
                shift 2
                ;;
            --quick-check)
                action="quick"
                shift
                ;;
            --full-check)
                action="full"
                shift
                ;;
            --help)
                show_help
                exit 0
                ;;
            *)
                echo "Unknown argument: $1" >&2
                show_help
                exit 1
                ;;
        esac
    done

    # Set repository URL based on type
    if [[ -n "$repo_type" ]]; then
        export RESTIC_REPOSITORY="{{ restic_repository }}-${repo_type}"
    fi

    # Execute the appropriate health check
    case "$action" in
        "quick")
            quick_check
            ;;
        "full")
            full_check
            ;;
        *)
            show_help
            exit 1
            ;;
    esac
}

# Script execution
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi