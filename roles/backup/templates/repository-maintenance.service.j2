[Unit]
Description=Repository Maintenance Service
After=network.target

[Service]
Type=oneshot
User={{ backup_user }}
Group={{ backup_group }}
WorkingDirectory={{ backup_base_path }}
ExecStart={{ backup_base_path }}/scripts/repository-health-check.sh --full-check
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target