#!/usr/bin/env python3
"""
Repository Performance Analyzer
{{ ansible_managed }}
Analyzes backup repository performance metrics
"""

import os
import sys
import json
import subprocess
from datetime import datetime, timedelta

# Configuration
BACKUP_BASE = "{{ backup_base_path }}"
REPOSITORY = "{{ restic_repository }}"
PASSWORD_FILE = "{{ backup_base_path }}/keys/{{ device_role }}-password"

# Set environment
os.environ['RESTIC_REPOSITORY'] = REPOSITORY
os.environ['RESTIC_PASSWORD_FILE'] = PASSWORD_FILE

def run_restic_command(args):
    """Run a restic command and return the output"""
    try:
        cmd = ['restic'] + args
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"Error running restic command: {e}")
        return None

def analyze_performance():
    """Analyze repository performance"""
    print("📊 Repository Performance Analysis")
    print("=" * 50)

    # Get repository stats
    stats_output = run_restic_command(['stats', '--json'])
    if stats_output:
        stats = json.loads(stats_output)
        print(f"Total size: {stats.get('total_size', 0):,} bytes")
        print(f"Total files: {stats.get('total_file_count', 0):,}")

    # Get recent snapshots
    snapshots_output = run_restic_command(['snapshots', '--json'])
    if snapshots_output:
        snapshots = json.loads(snapshots_output)
        print(f"Total snapshots: {len(snapshots)}")

        if snapshots:
            latest = snapshots[-1]
            print(f"Latest snapshot: {latest.get('time', 'Unknown')}")

    print("\n✅ Performance analysis complete")

def show_help():
    """Show help information"""
    print("""
Repository Performance Analyzer

Usage: python3 repository-performance.py [options]

Options:
  --help    Show this help

Environment:
  Repository: {REPOSITORY}
  Password File: {PASSWORD_FILE}
""".format(REPOSITORY=REPOSITORY, PASSWORD_FILE=PASSWORD_FILE))

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--help":
        show_help()
    else:
        analyze_performance()