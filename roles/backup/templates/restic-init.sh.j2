#!/bin/bash
# Unified Restic Repository Initialization Script
# {{ ansible_managed }}
# Service: {{ common_backup_service_name }}

set -euo pipefail

export RESTIC_REPOSITORY="{{ backup_restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ common_backup_password_file }}"
export RESTIC_CACHE_DIR="{{ backup_base_path }}/cache"
export RESTIC_SFTP_COMMAND="ssh -F {{ backup_base_path }}/.ssh/config hetzner-storage -s sftp"

LOG_FILE="{{ backup_base_path }}/logs/init-{{ common_backup_service_name }}-$(date +%Y%m%d_%H%M%S).log"

echo "$(date): Initializing restic repository for {{ common_backup_service_name }}..." | tee -a "$LOG_FILE"
echo "Repository: $RESTIC_REPOSITORY" | tee -a "$LOG_FILE"

# Test SSH connection first
echo "$(date): Testing SSH connection..." | tee -a "$LOG_FILE"
if ssh -F {{ backup_base_path }}/.ssh/config hetzner-storage exit "echo 'SSH connection successful'" >> "$LOG_FILE" 2>&1; then
    echo "$(date): SSH connection test passed" | tee -a "$LOG_FILE"
else
    echo "$(date): ERROR: SSH connection failed. Check SSH key configuration." | tee -a "$LOG_FILE"
    echo "$(date): Ensure your SSH public key is in Hetzner Storage Box authorized_keys" | tee -a "$LOG_FILE"
    exit 1
fi

# Extract repository path and create remote directory
REPO_PATH="${RESTIC_REPOSITORY#sftp:hetzner-storage:}"
echo "$(date): Creating repository directory on remote storage: $REPO_PATH" | tee -a "$LOG_FILE"
if ssh -F {{ backup_base_path }}/.ssh/config hetzner-storage mkdir -p "$REPO_PATH" >> "$LOG_FILE" 2>&1; then
    echo "$(date): Remote directory created successfully" | tee -a "$LOG_FILE"
else
    echo "$(date): WARNING: Could not create remote directory (may already exist)" | tee -a "$LOG_FILE"
fi

# Initialize repository
echo "$(date): Initializing restic repository..." | tee -a "$LOG_FILE"
if restic -o sftp.command="$RESTIC_SFTP_COMMAND" init >> "$LOG_FILE" 2>&1; then
    echo "$(date): Repository initialized successfully" | tee -a "$LOG_FILE"
elif restic -o sftp.command="$RESTIC_SFTP_COMMAND" snapshots >> "$LOG_FILE" 2>&1; then
    echo "$(date): Repository already exists and is accessible" | tee -a "$LOG_FILE"
else
    echo "$(date): ERROR: Failed to initialize or access repository" | tee -a "$LOG_FILE"
    exit 1
fi

echo "$(date): Repository initialization completed successfully for {{ common_backup_service_name }}" | tee -a "$LOG_FILE"
