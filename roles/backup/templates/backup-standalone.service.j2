[Unit]
Description=Standalone Backup for {{ inventory_hostname }}
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ backup_user }}
Group={{ backup_group }}

# Execute backup script
ExecStart={{ backup_base_path }}/scripts/backup-{{ inventory_hostname }}.sh

# Resource limits
{% if restic_memory_limit is defined %}
MemoryMax={{ restic_memory_limit }}
{% endif %}
CPUQuota={{ restic_optimization.cpu_quota | default('100%') }}
IOSchedulingClass=idle
Nice=19

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ backup_base_path }}

# Timeout
TimeoutStartSec={{ backup_timeout }}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backup-{{ inventory_hostname }}

[Install]
WantedBy=multi-user.target
