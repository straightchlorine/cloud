# YouTube Playlist Configuration
# Playlist URLs are configured via vault.

{% if youtube_playlists is defined and youtube_playlists is iterable and youtube_playlists | length > 0 %}
# All playlist URLs are colon-separated.
YOUTUBE_PLAYLISTS="{{ youtube_playlists | join(':') }}"
{% else %}
# No playlists configured in vault.
#
# Example:
# vault_youtube_playlists:
#   - "https://www.youtube.com/playlist?list=PLrAXheLQNhHhF4a7OtZKzCzLF9LhzPm_H"
#   - "https://www.youtube.com/playlist?list=PLrAXheLQNhHhF4a7OtZKzCzLF9LhzPm_M"
YOUTUBE_PLAYLISTS=""
{% endif %}

# Enable/disable YouTube sync (true/false)
YOUTUBE_SYNC_ENABLED={{ youtube_sync_enabled | lower }}
