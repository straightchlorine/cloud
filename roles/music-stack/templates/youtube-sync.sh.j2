#!/bin/bash
# YouTube Playlist Download Script
# Downloads playlists from YOUTUBE_PLAYLISTS environment variable
# Focused on reliable downloading only - no post-processing

set -euo pipefail

# Configuration
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly MUSIC_STACK_HOME="{{ music_stack_home }}"
readonly DOWNLOAD_DIR="{{ music_library_path }}/downloads"
readonly CONFIG_FILE="$MUSIC_STACK_HOME/config/yt-dlp.conf"
readonly LOG_FILE="{{ music_library_path }}/logs/youtube-sync.log"
readonly YTDLP_BINARY="/usr/local/bin/yt-dlp"
readonly LOCK_FILE="/tmp/youtube-sync.lock"

# Global variables
YTDLP_EXIT_CODE=0
TOTAL_PLAYLISTS=0
FAILED_PLAYLISTS=0

# Logging function
log() {
    local message="$1"
    local level="${2:-INFO}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $message" | tee -a "$LOG_FILE"
}

# Cleanup function
cleanup() {
    local exit_code=$?
    [[ -f "$LOCK_FILE" ]] && rm -f "$LOCK_FILE"
    if [[ $exit_code -ne 0 ]]; then
        log "Script exited with error code: $exit_code" "ERROR"
    fi
    exit $exit_code
}

# Setup function
setup() {
    trap cleanup EXIT INT TERM

    # Check for existing lock file
    if [[ -f "$LOCK_FILE" ]]; then
        log "Another instance is already running (lock file: $LOCK_FILE)" "ERROR"
        exit 1
    fi

    echo $$ > "$LOCK_FILE"
    mkdir -p "$(dirname "$LOG_FILE")" "$DOWNLOAD_DIR"
}

# Validate dependencies and environment
validate_environment() {
    if [[ ! -x "$YTDLP_BINARY" ]]; then
        log "yt-dlp binary not found at $YTDLP_BINARY" "ERROR"
        exit 1
    fi

    if [[ -z "${YOUTUBE_PLAYLISTS:-}" ]]; then
        log "YOUTUBE_PLAYLISTS environment variable not set" "ERROR"
        log "Configure vault_youtube_playlists in your host_vars" "ERROR"
        exit 1
    fi

    log "yt-dlp version: $($YTDLP_BINARY --version)" "INFO"
}

# Check disk space
check_disk_space() {
    local available_space
    available_space=$(df "$DOWNLOAD_DIR" | awk 'NR==2 {print $4}')

    if [[ $available_space -lt 1048576 ]]; then  # 1GB in KB
        log "Low disk space available: $(($available_space / 1024))MB" "WARN"
    fi
}

# Validate YouTube URL format
validate_url() {
    local url="$1"
    [[ "$url" =~ ^https?://(www\.)?(youtube\.com|youtu\.be)/ ]]
}

# Download single playlist
download_playlist() {
    local playlist_url="$1"

    log "Downloading playlist: $playlist_url" "INFO"

    if "$YTDLP_BINARY" --config-location "$CONFIG_FILE" "$playlist_url" 2>&1 | tee -a "$LOG_FILE"; then
        log "Successfully downloaded: $playlist_url" "INFO"
        return 0
    else
        log "Download failed: $playlist_url" "ERROR"
        return 1
    fi
}

# Process all playlists
process_playlists() {
    log "Processing playlists: $YOUTUBE_PLAYLISTS" "INFO"

    IFS=':' read -ra PLAYLIST_ARRAY <<< "$YOUTUBE_PLAYLISTS"

    for playlist_url in "${PLAYLIST_ARRAY[@]}"; do
        [[ -z "$playlist_url" ]] && continue

        TOTAL_PLAYLISTS=$((TOTAL_PLAYLISTS + 1))

        if ! validate_url "$playlist_url"; then
            log "Invalid YouTube URL format: $playlist_url" "ERROR"
            FAILED_PLAYLISTS=$((FAILED_PLAYLISTS + 1))
            continue
        fi

        if ! download_playlist "$playlist_url"; then
            FAILED_PLAYLISTS=$((FAILED_PLAYLISTS + 1))
            YTDLP_EXIT_CODE=1
        fi
    done

    if [[ $FAILED_PLAYLISTS -eq 0 ]]; then
        log "All $TOTAL_PLAYLISTS playlists downloaded successfully" "INFO"
    else
        log "$FAILED_PLAYLISTS out of $TOTAL_PLAYLISTS playlists failed" "WARN"
    fi
}

# Generate reports
generate_reports() {
    local download_count
    download_count=$(find "$DOWNLOAD_DIR" -type f \( -name "*.opus" -o -name "*.m4a" -o -name "*.mp3" -o -name "*.ogg" -o -name "*.flac" \) 2>/dev/null | wc -l)

    log "Total files in downloads directory: $download_count" "INFO"

    local total_usage
    total_usage=$(du -sh "$MUSIC_STACK_HOME" 2>/dev/null | cut -f1)
    log "Total music stack disk usage: $total_usage" "INFO"
}

# Update yt-dlp using built-in updater
update_ytdlp() {
    log "Checking for yt-dlp updates..." "INFO"
    if "$YTDLP_BINARY" -U 2>&1 | tee -a "$LOG_FILE"; then
        log "yt-dlp update check completed" "INFO"
    else
        log "yt-dlp update check failed" "WARN"
    fi
}

# Cleanup logs and archives
cleanup_old_files() {
    # Keep last 500 log lines
    if [[ -f "$LOG_FILE" ]]; then
        tail -n 500 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
    fi

    # Remove old archives (7+ days)
    find "{{ music_library_path }}/archive" -type d -mtime +7 -exec rm -rf {} + 2>/dev/null || true
}

# Main execution
main() {
    setup
    validate_environment
    check_disk_space
    update_ytdlp
    process_playlists
    generate_reports
    cleanup_old_files

    log "YouTube playlist download completed" "INFO"

    if [[ $YTDLP_EXIT_CODE -eq 0 ]]; then
        log "Script completed successfully - processed $TOTAL_PLAYLISTS playlists" "INFO"
        exit 0
    else
        log "Script completed with errors - $FAILED_PLAYLISTS out of $TOTAL_PLAYLISTS playlists failed" "WARN"
        exit $YTDLP_EXIT_CODE
    fi
}

# Run main function
main "$@"
