# yt-dlp configuration for music downloads optimized for maximum audio quality

# Use aria2 for multi-connection downloads
--downloader aria2c

# prefer YouTube Music for better metadata
--default-search "ytsearchmusic"

# Extract audio only with best available quality
-x
--format "bestaudio/best"
--format-sort "abr,asr,+size"

# Keep original format
--audio-format best
--audio-quality 0

# Metadata embedding
--add-metadata
--embed-metadata
--embed-thumbnail
--convert-thumbnails png

# If no artist tag - set it to uplaoder
--parse-metadata "uploader:(?P<artist>.*)"

# Clean up noisy suffixes in titles
--replace-in-metadata title "\s*\((?i:(official|lyrics|video|audio|visualizer)[^)]*)\)" ""
--replace-in-metadata title "\s*\[(?i:(hd|4k|8k|mv|music\s*video)[^\]]*)\]" ""

# Normalize whitespace in titles
--replace-in-metadata title "\s{2,}" " "
--replace-in-metadata title "^\s+|\s+$" ""

# Remove redundant dashes/spaces
--replace-in-metadata title "-{2,}" "-"
--replace-in-metadata title "[-\s]+$" ""

# Clean up noisy suffixes in uploader names
--replace-in-metadata uploader "\s*\b(?i:official)\b\s*" ""
--replace-in-metadata uploader "\s*\b(?i:topic)\b\s*" ""
--replace-in-metadata uploader "\s*\b(?i:vevo)\b\s*" ""
--replace-in-metadata uploader "\s{2,}" " "
--replace-in-metadata uploader "^\s+|\s+$" ""

# Output template - artist/songs structure
--output "{{ music_library_path }}/downloads/%(artist|Unknown Artist).100s/%(title).200s.%(ext)s"
--output-na-placeholder "Unknown"

# Restrict filename characters to ASCII only
--restrict-filenames

# Download archive and error handling
--download-archive "{{ music_library_path }}/youtube-archive.txt"
--cache-dir "{{ music_library_path }}/cache"
--ignore-errors
--continue
--no-abort-on-error

# Network and performance optimization
--force-ipv4
--concurrent-fragments 40
--retries 3
--fragment-retries 3
--file-access-retries 3
--sleep-requests 0
--sleep-interval 0
--max-sleep-interval 0

# Rate limiting to be respectful
--limit-rate 2M
--throttled-rate 100K

--no-write-description
--no-write-comments
--no-write-annotations

# Sponsorship and unwanted content filtering
--sponsorblock-mark all
--sponsorblock-remove sponsor,selfpromo,interaction,intro,outro
