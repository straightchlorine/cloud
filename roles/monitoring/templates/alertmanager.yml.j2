# Alertmanager configuration for unified alerting
# Handles alerts from Prometheus (metrics) and Loki (logs)

global:
{% if alertmanager_smtp_smarthost %}
  smtp_smarthost: '{{ alertmanager_smtp_smarthost }}'
  smtp_from: '{{ alertmanager_smtp_from }}'
{% endif %}
  smtp_require_tls: true

# Route configuration
route:
  group_by: ['alertname', 'cluster', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  receiver: 'default'
  routes:
    # Critical alerts - immediate notification
    - match:
        severity: critical
      receiver: 'critical-alerts'
      group_wait: 10s
      repeat_interval: 5m

    # Infrastructure alerts
    - match:
        category: infrastructure
      receiver: 'infrastructure-alerts'
      group_interval: 2m

    # Service-specific routing
    - match:
        service: 'dns'
      receiver: 'dns-alerts'

    - match:
        service: 'automation'
      receiver: 'automation-alerts'

    - match:
        service: 'music'
      receiver: 'music-alerts'

    # Log-based alerts
    - match:
        source: 'loki'
      receiver: 'log-alerts'
      group_interval: 1m

# Inhibition rules (prevent spam)
inhibit_rules:
  # If instance is down, don't alert on individual services
  - source_match:
      alertname: 'InstanceDown'
    target_match_re:
      service: '.*'
    equal: ['instance']

  # If service is down, don't alert on high response time
  - source_match:
      alertname: 'ServiceDown'
    target_match:
      alertname: 'HighResponseTime'
    equal: ['instance', 'service']

# Receiver configurations
receivers:
  # Default receiver
  - name: 'default'
    webhook_configs:
{% if alertmanager_webhook_url %}
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        http_config:
          proxy_url: ''
        title: '🔔 Infrastructure Alert'
        text: |
          {{ range .Alerts }}
          **Alert:** {{ .Annotations.summary }}
          **Description:** {{ .Annotations.description }}
          **Severity:** {{ .Labels.severity }}
          **Instance:** {{ .Labels.instance }}
          **Service:** {{ .Labels.service }}
          {{ end }}
{% endif %}

  # Critical alerts - multiple channels
  - name: 'critical-alerts'
{% if alertmanager_smtp_smarthost %}
    email_configs:
      - to: '{{ alertmanager_smtp_from }}'
        subject: '🚨 CRITICAL: {{ .GroupLabels.alertname }} on {{ .GroupLabels.instance }}'
        body: |
          🚨 **CRITICAL ALERT**

          {{ range .Alerts }}
          **Alert:** {{ .Annotations.summary }}
          **Description:** {{ .Annotations.description }}
          **Instance:** {{ .Labels.instance }}
          **Service:** {{ .Labels.service }}
          **Started:** {{ .StartsAt.Format "2006-01-02 15:04:05" }}
          {{ if .EndsAt }}**Ended:** {{ .EndsAt.Format "2006-01-02 15:04:05" }}{{ end }}
          {{ end }}

          Please investigate immediately.
{% endif %}
{% if alertmanager_webhook_url %}
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        title: '🚨 CRITICAL Infrastructure Alert'
        text: |
          {{ range .Alerts }}
          🚨 **{{ .Annotations.summary }}**

          **Description:** {{ .Annotations.description }}
          **Instance:** {{ .Labels.instance }}
          **Service:** {{ .Labels.service }}
          **Severity:** {{ .Labels.severity }}
          {{ end }}
{% endif %}

  # Infrastructure alerts
  - name: 'infrastructure-alerts'
{% if alertmanager_webhook_url %}
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        title: '🏗️ Infrastructure Alert'
        text: |
          {{ range .Alerts }}
          **{{ .Annotations.summary }}**

          **Instance:** {{ .Labels.instance }}
          **Details:** {{ .Annotations.description }}
          {{ end }}
{% endif %}

  # Service-specific receivers
  - name: 'dns-alerts'
{% if alertmanager_webhook_url %}
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        title: '🌐 DNS Service Alert'
        text: |
          {{ range .Alerts }}
          **DNS Alert:** {{ .Annotations.summary }}

          **Pi-hole Instance:** {{ .Labels.instance }}
          **Details:** {{ .Annotations.description }}
          {{ end }}
{% endif %}

  - name: 'automation-alerts'
{% if alertmanager_webhook_url %}
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        title: '🤖 Automation Stack Alert'
        text: |
          {{ range .Alerts }}
          **Automation Alert:** {{ .Annotations.summary }}

          **Service:** {{ .Labels.service }}
          **Instance:** {{ .Labels.instance }}
          **Details:** {{ .Annotations.description }}
          {{ end }}
{% endif %}

  - name: 'music-alerts'
{% if alertmanager_webhook_url %}
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        title: '🎵 Music Stack Alert'
        text: |
          {{ range .Alerts }}
          **Music Alert:** {{ .Annotations.summary }}

          **Service:** {{ .Labels.service }}
          **Instance:** {{ .Labels.instance }}
          **Details:** {{ .Annotations.description }}
          {{ end }}
{% endif %}

  - name: 'log-alerts'
{% if alertmanager_webhook_url %}
    webhook_configs:
      - url: '{{ alertmanager_webhook_url }}'
        send_resolved: true
        title: '[NOTE] Log-based Alert'
        text: |
          {{ range .Alerts }}
          **Log Alert:** {{ .Annotations.summary }}

          **Source:** {{ .Labels.filename }}
          **Instance:** {{ .Labels.instance }}
          **Log Entry:** {{ .Annotations.log_message }}
          {{ end }}
{% endif %}

# Templates for custom messages
templates:
  - '/etc/alertmanager/templates/*.tmpl'
