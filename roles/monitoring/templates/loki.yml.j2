# Loki configuration for centralized log aggregation
# Receives logs from Promtail agents on all service machines

auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: info

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2020-10-24
      store: boltdb-shipper
      object_store: filesystem
      schema: v11
      index:
        prefix: index_
        period: 24h

ruler:
  alertmanager_url: http://localhost:{{ alertmanager_port }}

# Retention and storage limits
limits_config:
  enforce_metric_name: false
  reject_old_samples: true
  reject_old_samples_max_age: 168h  # 1 week
  ingestion_rate_mb: 16
  ingestion_burst_size_mb: 32
  per_stream_rate_limit: 3MB
  per_stream_rate_limit_burst: 15MB
  max_streams_per_user: 10000
  max_global_streams_per_user: 5000
  retention_period: {{ loki_retention_period }}

# Chunk and index configuration
chunk_store_config:
  max_look_back_period: {{ loki_retention_period }}

table_manager:
  retention_deletes_enabled: true
  retention_period: {{ loki_retention_period }}

# Ingester configuration
ingester:
  max_chunk_age: {{ loki_max_chunk_age }}
  chunk_idle_period: {{ loki_chunk_idle_period }}
  max_transfer_retries: {{ loki_max_transfer_retries }}
  lifecycler:
    address: 127.0.0.1
    ring:
      kvstore:
        store: inmemory
      replication_factor: 1
    final_sleep: 0s
  chunk_encoding: snappy

# Analytics and usage stats (disabled for privacy)
analytics:
  reporting_enabled: false
