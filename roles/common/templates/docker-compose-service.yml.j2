# Common Docker Compose Service Template
# Standardized service definition to eliminate template duplication
# Usage: Include this template with service-specific parameters

{% if service_config is defined %}
{% for service_name, config in service_config.items() %}
  {{ service_name }}:
    image: {{ config.image }}
    container_name: {{ config.container_name }}
    restart: {{ config.restart }}
    {% if config.user is defined %}
    user: "{{ config.user }}"
    {% endif %}
    {% if config.command is defined %}
    {% if config.command is string %}
    command: {{ config.command }}
    {% else %}
    command:
      {% for cmd in config.command %}
      - {{ cmd }}
      {% endfor %}
    {% endif %}
    {% endif %}
    deploy:
      resources:
        limits:
          memory: {{ config.resources.memory }}
          cpus: '{{ config.resources.cpus }}'
        reservations:
          memory: {{ config.resources.memory_reservation }}
          cpus: '{{ config.resources.cpus_reservation }}'
    {% if config.ports is defined %}
    ports:
      {% for port in config.ports %}
      {% if port.bind_to_localhost is defined and port.bind_to_localhost %}
      - "127.0.0.1:{{ port.host }}:{{ port.container }}"
      {% else %}
      - "{{ port.host }}:{{ port.container }}"
      {% endif %}
      {% endfor %}
    {% endif %}
    {% if config.volumes is defined %}
    volumes:
      {% for volume in config.volumes %}
      - {{ volume }}
      {% endfor %}
    {% endif %}
    {% if config.environment is defined %}
    environment:
      {% for env_var in config.environment %}
      {% if env_var is mapping %}
      {% for key, value in env_var.items() %}
      {{ key }}: {{ value }}
      {% endfor %}
      {% else %}
      - {{ env_var }}
      {% endif %}
      {% endfor %}
    {% endif %}
    {% if config.networks is defined %}
    networks:
      {% for network in config.networks %}
      - {{ network }}
      {% endfor %}
    {% endif %}
    {% if config.labels is defined %}
    labels:
      {% for label in config.labels %}
      - "{{ label }}"
      {% endfor %}
    {% endif %}
    {% if config.healthcheck is defined %}
    healthcheck:
      test: {{ config.healthcheck.test }}
      interval: {{ config.healthcheck.interval }}
      timeout: {{ config.healthcheck.timeout }}
      retries: {{ config.healthcheck.retries }}
      start_period: {{ config.healthcheck.start_period }}
    {% endif %}
    {% if config.depends_on is defined %}
    depends_on:
      {% for dep in config.depends_on %}
      - {{ dep }}
      {% endfor %}
    {% endif %}
    {% if config.profiles is defined %}
    profiles:
      {% for profile in config.profiles %}
      - {{ profile }}
      {% endfor %}
    {% endif %}

{% endfor %}
{% endif %}

{% if networks is defined %}
networks:
  {% for network_name, network_config in networks.items() %}
  {{ network_name }}:
    {% if network_config.external is defined %}
    external: {{ network_config.external }}
    {% endif %}
    {% if network_config.driver is defined %}
    driver: {{ network_config.driver }}
    {% endif %}
  {% endfor %}
{% endif %}

{% if volumes is defined %}
volumes:
  {% for volume_name, volume_config in volumes.items() %}
  {{ volume_name }}:
    {% if volume_config.external is defined %}
    external: {{ volume_config.external }}
    {% endif %}
    {% if volume_config.driver is defined %}
    driver: {{ volume_config.driver }}
    {% endif %}
  {% endfor %}
{% endif %}