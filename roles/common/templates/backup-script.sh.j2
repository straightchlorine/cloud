#!/bin/bash
# Managed by Ansible - Do not edit manually
# Generated for: {{ common_backup_service_name }}

set -euo pipefail

# Configuration - Set explicitly since systemd+sudo environment inheritance is unreliable
export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ common_backup_password_file }}"
export RESTIC_CACHE_DIR="{{ common_backup_cache_dir }}"
# Matches restic-init.sh.j2 and the systemd unit's own Environment= exactly -
# a hand-reconstructed command here (raw -i/-o flags, no -F) previously
# bypassed ssh_config.j2's shared settings (UserKnownHostsFile, ControlMaster)
# entirely and silently drifted out of sync with them.
export RESTIC_SFTP_COMMAND="ssh -F {{ common_backup_base_path }}/.ssh/config hetzner-storage -s sftp"

# Service-specific configuration
SERVICE_NAME="{{ common_backup_service_name }}"
LOG_FILE="{{ common_backup_log_dir }}/backup-${SERVICE_NAME}-$(date +%Y%m%d_%H%M%S).log"
BACKUP_PATHS=(
{% for path in common_backup_directories %}
    "{{ path }}"
{% endfor %}
)

# Optional pre-backup commands
PRE_BACKUP_COMMANDS=(
{% if pre_backup_commands is defined %}
{% for cmd in pre_backup_commands %}
    "{{ cmd }}"
{% endfor %}
{% endif %}
)

# Optional post-backup commands
POST_BACKUP_COMMANDS=(
{% if post_backup_commands is defined %}
{% for cmd in post_backup_commands %}
    "{{ cmd }}"
{% endfor %}
{% endif %}
)

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${SERVICE_NAME}] $*" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    exit "${2:-1}"
}

check_prerequisites() {
    log "Checking backup prerequisites..."

    # Check restic is available
    if ! command -v restic >/dev/null 2>&1; then
        error_exit "restic is not installed or not in PATH"
    fi

    # Check password file exists
    if [[ ! -f "$RESTIC_PASSWORD_FILE" ]]; then
        error_exit "Password file not found: $RESTIC_PASSWORD_FILE"
    fi

    # Check backup paths exist
    for path in "${BACKUP_PATHS[@]}"; do
        if [[ ! -e "$path" ]]; then
            log "WARNING: Backup path does not exist: $path"
        fi
    done

    log "Prerequisites check completed"
}

{% if backup_ssh_config is defined %}
test_connectivity() {
    log "Testing repository connectivity..."

    # Hetzner Storage Box (and similar backup-only SSH endpoints) allow only
    # the SFTP subsystem - no general shell, so a plain command-exec test
    # (e.g. `ssh host echo hi`) is refused even when the box is perfectly
    # reachable. -b /dev/null connects, reads zero batch commands (immediate
    # EOF), and exits cleanly - a real SFTP-native connectivity probe using
    # the same shared config/alias restic itself connects through.
    if sftp -F {{ common_backup_base_path }}/.ssh/config -b /dev/null hetzner-storage >/dev/null 2>&1; then
        log "Repository connectivity test passed"
    else
        error_exit "Cannot connect to backup repository"
    fi
}
{% endif %}

run_pre_backup_commands() {
    if [[ ${{ '{#' }}PRE_BACKUP_COMMANDS[@]} -gt 0 ]]; then
        log "Running pre-backup commands..."
        for cmd in "${PRE_BACKUP_COMMANDS[@]}"; do
            log "Executing: $cmd"
            if eval "$cmd"; then
                log "Pre-backup command succeeded: $cmd"
            else
                log "WARNING: Pre-backup command failed: $cmd"
            fi
        done
    fi
}

run_post_backup_commands() {
    if [[ ${{ '{#' }}POST_BACKUP_COMMANDS[@]} -gt 0 ]]; then
        log "Running post-backup commands..."
        for cmd in "${POST_BACKUP_COMMANDS[@]}"; do
            log "Executing: $cmd"
            if eval "$cmd"; then
                log "Post-backup command succeeded: $cmd"
            else
                log "WARNING: Post-backup command failed: $cmd"
            fi
        done
    fi
}

perform_backup() {
    log "Starting backup for ${SERVICE_NAME}..."

    # Build backup command with sudo to read protected files
    # Environment variables are preserved via systemd service configuration
    # -o sftp.command explicitly, not just the exported env var: env_keep
    # correctly preserves RESTIC_SFTP_COMMAND across the root escalation
    # (verified via `sudo -l`), but restic still fell back to its bare
    # default ssh invocation (wrong port) under sudo in practice - passing
    # it as a literal CLI flag has no environment-propagation dependency at
    # all, matching the already-proven-working pattern in
    # roles/backup/templates/backup-coordinator-target.sh.j2.
    local backup_cmd="sudo --preserve-env=RESTIC_REPOSITORY,RESTIC_PASSWORD_FILE,RESTIC_CACHE_DIR,RESTIC_SFTP_COMMAND restic backup -o sftp.command=\"$RESTIC_SFTP_COMMAND\""

    # Add paths
    for path in "${BACKUP_PATHS[@]}"; do
        backup_cmd="$backup_cmd \"$path\""
    done

    # Add tags
    backup_cmd="$backup_cmd --tag ${SERVICE_NAME}"
    backup_cmd="$backup_cmd --tag $(hostname)"
    backup_cmd="$backup_cmd --tag $(date +%Y-%m-%d)"

    # Memory optimization flags
{% if restic_pack_size is defined %}
    backup_cmd="$backup_cmd --pack-size {{ restic_pack_size }}"
{% endif %}
{% if restic_read_concurrency is defined %}
    backup_cmd="$backup_cmd --read-concurrency {{ restic_read_concurrency }}"
{% endif %}
{% if restic_compression is defined %}
    backup_cmd="$backup_cmd --compression {{ restic_compression }}"
{% endif %}

    # Add excludes
{% if backup_exclude_patterns is defined %}
{% for exclude in backup_exclude_patterns %}
    backup_cmd="$backup_cmd --exclude '{{ exclude }}'"
{% endfor %}
{% endif %}

    # Execute backup
    log "Executing: $backup_cmd"
    eval "$backup_cmd" >> "$LOG_FILE" 2>&1
    local backup_exit_code=$?

    if [[ $backup_exit_code -eq 0 ]]; then
        log "Backup completed successfully"
    elif [[ $backup_exit_code -eq 1 ]]; then
        log "Backup completed with warnings (some files had permission issues, but backup succeeded)"
    else
        error_exit "Backup failed with exit code $backup_exit_code"
    fi
}

cleanup_old_snapshots() {
    log "Cleaning up old snapshots..."

    local cleanup_cmd="sudo --preserve-env=RESTIC_REPOSITORY,RESTIC_PASSWORD_FILE,RESTIC_CACHE_DIR,RESTIC_SFTP_COMMAND restic forget -o sftp.command=\"$RESTIC_SFTP_COMMAND\""
    cleanup_cmd="$cleanup_cmd --tag ${SERVICE_NAME}"
{% if retention_policy is defined %}
    cleanup_cmd="$cleanup_cmd --keep-daily {{ retention_policy.daily }}"
    cleanup_cmd="$cleanup_cmd --keep-weekly {{ retention_policy.weekly }}"
    cleanup_cmd="$cleanup_cmd --keep-monthly {{ retention_policy.monthly }}"
    cleanup_cmd="$cleanup_cmd --keep-yearly {{ retention_policy.yearly }}"
{% else %}
    cleanup_cmd="$cleanup_cmd --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --keep-yearly 1"
{% endif %}
    cleanup_cmd="$cleanup_cmd --prune"

    log "Executing: $cleanup_cmd"
    if eval "$cleanup_cmd" >> "$LOG_FILE" 2>&1; then
        log "Cleanup completed successfully"
    else
        log "WARNING: Cleanup failed but backup was successful"
    fi
}

get_backup_stats() {
    log "Getting backup statistics..."

    if sudo --preserve-env=RESTIC_REPOSITORY,RESTIC_PASSWORD_FILE,RESTIC_CACHE_DIR,RESTIC_SFTP_COMMAND restic snapshots -o sftp.command="$RESTIC_SFTP_COMMAND" --tag "${SERVICE_NAME}" --json > /tmp/snapshots.json 2>>"$LOG_FILE"; then
        local snapshot_count=$(jq length /tmp/snapshots.json 2>/dev/null || echo "unknown")
        log "Total snapshots for ${SERVICE_NAME}: $snapshot_count"
        rm -f /tmp/snapshots.json
    else
        log "Could not retrieve backup statistics"
    fi
}

# Main execution
main() {
    log "=== Starting backup for ${SERVICE_NAME} ==="

    check_prerequisites
{% if backup_ssh_config is defined %}
    test_connectivity
{% endif %}
    run_pre_backup_commands
    perform_backup
    cleanup_old_snapshots
    get_backup_stats
    run_post_backup_commands

    log "=== Backup completed for ${SERVICE_NAME} ==="
}

# Error handling
trap 'error_exit "Script interrupted"' INT TERM

# Execute main function
main "$@"
