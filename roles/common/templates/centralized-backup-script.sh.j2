#!/bin/bash
# Enhanced Enterprise Centralized Backup Script
# Backs up {{ backup_target.service_name }} from {{ backup_target.target_host }}
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ backup_password_file }}"
export RESTIC_CACHE_DIR="{{ backup_cache_dir }}"

# Service configuration
SERVICE_NAME="{{ backup_service_name }}"
RCLONE_REMOTE="{{ rclone_remote }}"
RCLONE_CONFIG="{{ rclone_config }}"
STAGING_DIR="/tmp/backup-staging-${SERVICE_NAME}"
LOG_FILE="{{ backup_log_dir }}/backup-${SERVICE_NAME}-$(date +%Y%m%d_%H%M%S).log"
METRICS_FILE="{{ backup_log_dir }}/metrics-${SERVICE_NAME}.json"

# Enhanced configuration
{% if backup_target.network_optimization is defined and backup_target.network_optimization %}
NETWORK_OPTIMIZATION=true
BANDWIDTH_LIMIT="{{ backup_target.bandwidth_limit_mbps | default(0) }}"
CONCURRENT_TRANSFERS="{{ backup_target.concurrent_transfers | default(3) }}"
COMPRESSION_LEVEL="{{ backup_target.compression_level | default('auto') }}"
{% else %}
NETWORK_OPTIMIZATION=false
{% endif %}

{% if backup_target.backup_method is defined and backup_target.backup_method == "hybrid_enhanced" %}
BACKUP_METHOD="hybrid_enhanced"
{% else %}
BACKUP_METHOD="standard"
{% endif %}

# Backup paths
BACKUP_PATHS=(
{% for path in backup_paths %}
    "{{ path }}"
{% endfor %}
)

# Exclude patterns
EXCLUDE_PATTERNS=(
{% if backup_target.exclude_patterns is defined %}
{% for pattern in backup_target.exclude_patterns %}
    "{{ pattern }}"
{% endfor %}
{% else %}
    "*.tmp"
    "*.log.1*"
    "**/logs/*"
    "**/cache/*"
    "**/.cache/*"
    "**/tmp/*"
{% endif %}
)

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${SERVICE_NAME}] $*" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    cleanup_staging
    exit "${2:-1}"
}

cleanup_staging() {
    if [[ -d "$STAGING_DIR" ]]; then
        log "Cleaning up staging directory: $STAGING_DIR"
        rm -rf "$STAGING_DIR"
    fi
}

check_prerequisites() {
    log "Checking prerequisites..."

    # Check rclone
    if ! command -v rclone >/dev/null 2>&1; then
        error_exit "rclone is not installed or not in PATH"
    fi

    # Check restic
    if ! command -v restic >/dev/null 2>&1; then
        error_exit "restic is not installed or not in PATH"
    fi

    # Check password file
    if [[ ! -f "$RESTIC_PASSWORD_FILE" ]]; then
        error_exit "Password file not found: $RESTIC_PASSWORD_FILE"
    fi

    # Check rclone config
    if [[ ! -f "$RCLONE_CONFIG" ]]; then
        error_exit "Rclone config not found: $RCLONE_CONFIG"
    fi

    log "Prerequisites check completed"
}

test_connectivity() {
    log "Testing connectivity to $RCLONE_REMOTE..."

    if rclone --config "$RCLONE_CONFIG" lsd "$RCLONE_REMOTE:/" >/dev/null 2>&1; then
        log "Connectivity test passed"
    else
        error_exit "Cannot connect to remote host via rclone"
    fi
}

sync_remote_files() {
    log "Starting enhanced file synchronization from $RCLONE_REMOTE..."

    # Create staging directory
    mkdir -p "$STAGING_DIR"

    # Build base rclone arguments
    local rclone_args=(--config "$RCLONE_CONFIG")

    # Memory optimization flags for low-memory systems
    rclone_args+=(--buffer-size 16M)
    rclone_args+=(--max-backlog 200000)
    rclone_args+=(--checkers 2)
    rclone_args+=(--transfers 1)

    if [[ "$NETWORK_OPTIMIZATION" == "true" ]]; then
        if [[ "$BANDWIDTH_LIMIT" != "0" ]]; then
            rclone_args+=(--bwlimit "${BANDWIDTH_LIMIT}M")
        fi
        # Override for low-memory: reduce concurrency
        rclone_args+=(--retries 3)
        rclone_args+=(--low-level-retries 10)
    fi

    # Sync each backup path
    for path in "${BACKUP_PATHS[@]}"; do
        log "Syncing $path with network optimization..."

        # Build exclude arguments
        local exclude_args=()
        for pattern in "${EXCLUDE_PATTERNS[@]}"; do
            exclude_args+=(--exclude "$pattern")
        done

        # Enhanced sync with rclone
        local sync_start=$(date +%s)
        if rclone sync \
            "$RCLONE_REMOTE:$path" "$STAGING_DIR$path" \
            "${rclone_args[@]}" \
            "${exclude_args[@]}" \
            --progress \
            --stats 30s \
            --stats-file-name-length 0 \
            >> "$LOG_FILE" 2>&1; then
            local sync_end=$(date +%s)
            local sync_duration=$((sync_end - sync_start))
            log "Successfully synced $path in ${sync_duration}s"
            record_sync_metrics "$path" "$sync_duration" "success"
        else
            local sync_end=$(date +%s)
            local sync_duration=$((sync_end - sync_start))
            log "WARNING: Failed to sync $path (may not exist on remote)"
            record_sync_metrics "$path" "$sync_duration" "warning"
        fi
    done

    log "Enhanced file synchronization completed"
}

perform_backup() {
    log "Starting enhanced restic backup..."

    # Check if staging directory has content
    if [[ ! -d "$STAGING_DIR" ]] || [[ -z "$(ls -A "$STAGING_DIR" 2>/dev/null)" ]]; then
        error_exit "No files to backup - staging directory is empty"
    fi

    local backup_start=$(date +%s)

    # Build enhanced backup command
    local backup_args=(
        backup
        "$STAGING_DIR"
        --tag "${SERVICE_NAME}"
        --tag "$(hostname)"
        --tag "$(date +%Y-%m-%d)"
        --tag "backup_method:$BACKUP_METHOD"
    )

    if [[ "$BACKUP_METHOD" == "hybrid_enhanced" ]]; then
        backup_args+=(--compression "$COMPRESSION_LEVEL")
        if [[ "$NETWORK_OPTIMIZATION" == "true" ]]; then
            backup_args+=(--read-concurrency 4)
        fi
    fi

    # Execute enhanced backup
    log "Executing enhanced backup with method: $BACKUP_METHOD"
    if restic "${backup_args[@]}" >> "$LOG_FILE" 2>&1; then
        local backup_exit_code=$?
        local backup_end=$(date +%s)
        local backup_duration=$((backup_end - backup_start))

        if [[ $backup_exit_code -eq 0 ]]; then
            log "Backup completed successfully in ${backup_duration}s"
            record_backup_metrics "backup" "$backup_duration" "success"
        elif [[ $backup_exit_code -eq 1 ]]; then
            log "Backup completed with warnings in ${backup_duration}s"
            record_backup_metrics "backup" "$backup_duration" "warning"
        else
            record_backup_metrics "backup" "$backup_duration" "failed"
            error_exit "Backup failed with exit code $backup_exit_code"
        fi
    else
        local backup_end=$(date +%s)
        local backup_duration=$((backup_end - backup_start))
        record_backup_metrics "backup" "$backup_duration" "failed"
        error_exit "Backup command failed"
    fi
}

cleanup_old_snapshots() {
    log "Cleaning up old snapshots..."

    local cleanup_cmd="restic forget"
    cleanup_cmd="$cleanup_cmd --tag ${SERVICE_NAME}"
{% if backup_target.retention_policy is defined %}
    cleanup_cmd="$cleanup_cmd --keep-daily {{ backup_target.retention_policy.daily }}"
    cleanup_cmd="$cleanup_cmd --keep-weekly {{ backup_target.retention_policy.weekly }}"
    cleanup_cmd="$cleanup_cmd --keep-monthly {{ backup_target.retention_policy.monthly }}"
    cleanup_cmd="$cleanup_cmd --keep-yearly {{ backup_target.retention_policy.yearly }}"
{% else %}
    cleanup_cmd="$cleanup_cmd --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --keep-yearly 1"
{% endif %}
    cleanup_cmd="$cleanup_cmd --prune"

    log "Executing: $cleanup_cmd"
    if eval "$cleanup_cmd" >> "$LOG_FILE" 2>&1; then
        log "Cleanup completed successfully"
    else
        log "WARNING: Cleanup failed but backup was successful"
    fi
}

record_sync_metrics() {
    local path="$1"
    local duration="$2"
    local status="$3"

    if command -v jq >/dev/null 2>&1; then
        local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        echo "{\"timestamp\":\"$timestamp\",\"service\":\"$SERVICE_NAME\",\"path\":\"$path\",\"duration\":$duration,\"status\":\"$status\"}" >> "$METRICS_FILE"
    fi
}

record_backup_metrics() {
    local operation="$1"
    local duration="$2"
    local status="$3"
    local size="${4:-0}"

    if command -v jq >/dev/null 2>&1; then
        local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        echo "{\"timestamp\":\"$timestamp\",\"service\":\"$SERVICE_NAME\",\"operation\":\"$operation\",\"duration\":$duration,\"status\":\"$status\",\"size\":$size}" >> "$METRICS_FILE"
    fi
}

get_backup_stats() {
    log "Getting enhanced backup statistics..."

    if restic snapshots --tag "${SERVICE_NAME}" --json > /tmp/snapshots.json 2>>"$LOG_FILE"; then
        local snapshot_count=$(jq length /tmp/snapshots.json 2>/dev/null || echo "unknown")
        log "Total snapshots for ${SERVICE_NAME}: $snapshot_count"

        if command -v jq >/dev/null 2>&1 && [[ "$snapshot_count" != "unknown" && "$snapshot_count" -gt 0 ]]; then
            local latest_snapshot=$(jq -r '.[0].id' /tmp/snapshots.json 2>/dev/null || echo "unknown")
            local latest_time=$(jq -r '.[0].time' /tmp/snapshots.json 2>/dev/null || echo "unknown")
            log "Latest snapshot: $latest_snapshot at $latest_time"

            # Get repository stats
            if restic stats --json > /tmp/stats.json 2>>"$LOG_FILE"; then
                local total_size=$(jq -r '.total_size' /tmp/stats.json 2>/dev/null || echo "unknown")
                local total_file_count=$(jq -r '.total_file_count' /tmp/stats.json 2>/dev/null || echo "unknown")
                log "Repository stats: $total_file_count files, $total_size bytes"
                rm -f /tmp/stats.json
            fi
        fi

        rm -f /tmp/snapshots.json
    else
        log "Could not retrieve backup statistics"
    fi
}

# Main execution
main() {
    log "=== Starting centralized backup for ${SERVICE_NAME} ==="

    # Set up cleanup trap
    trap cleanup_staging EXIT

    check_prerequisites
    test_connectivity
    sync_remote_files
    perform_backup
    cleanup_old_snapshots
    get_backup_stats

    log "=== Backup completed for ${SERVICE_NAME} ==="
}

# Execute main function
main "$@"
