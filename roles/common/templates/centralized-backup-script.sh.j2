#!/bin/bash
# Centralized Rclone Backup Script
# Backs up {{ backup_target.service_name }} from {{ backup_target.target_host }}
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{ backup_password_file }}"
export RESTIC_CACHE_DIR="{{ backup_cache_dir }}"

# Service configuration
SERVICE_NAME="{{ backup_service_name }}"
RCLONE_REMOTE="{{ rclone_remote }}"
RCLONE_CONFIG="{{ rclone_config }}"
STAGING_DIR="/tmp/backup-staging-${SERVICE_NAME}"
LOG_FILE="{{ backup_log_dir }}/backup-${SERVICE_NAME}-$(date +%Y%m%d_%H%M%S).log"

# Backup paths
BACKUP_PATHS=(
{% for path in backup_paths %}
    "{{ path }}"
{% endfor %}
)

# Exclude patterns
EXCLUDE_PATTERNS=(
{% if backup_target.exclude_patterns is defined %}
{% for pattern in backup_target.exclude_patterns %}
    "{{ pattern }}"
{% endfor %}
{% else %}
    "*.tmp"
    "*.log.1*"
    "**/logs/*"
    "**/cache/*"
    "**/.cache/*"
    "**/tmp/*"
{% endif %}
)

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [${SERVICE_NAME}] $*" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    cleanup_staging
    exit "${2:-1}"
}

cleanup_staging() {
    if [[ -d "$STAGING_DIR" ]]; then
        log "Cleaning up staging directory: $STAGING_DIR"
        rm -rf "$STAGING_DIR"
    fi
}

check_prerequisites() {
    log "Checking prerequisites..."

    # Check rclone
    if ! command -v rclone >/dev/null 2>&1; then
        error_exit "rclone is not installed or not in PATH"
    fi

    # Check restic
    if ! command -v restic >/dev/null 2>&1; then
        error_exit "restic is not installed or not in PATH"
    fi

    # Check password file
    if [[ ! -f "$RESTIC_PASSWORD_FILE" ]]; then
        error_exit "Password file not found: $RESTIC_PASSWORD_FILE"
    fi

    # Check rclone config
    if [[ ! -f "$RCLONE_CONFIG" ]]; then
        error_exit "Rclone config not found: $RCLONE_CONFIG"
    fi

    log "Prerequisites check completed"
}

test_connectivity() {
    log "Testing connectivity to $RCLONE_REMOTE..."

    if rclone --config "$RCLONE_CONFIG" lsd "$RCLONE_REMOTE:/" >/dev/null 2>&1; then
        log "Connectivity test passed"
    else
        error_exit "Cannot connect to remote host via rclone"
    fi
}

sync_remote_files() {
    log "Starting file synchronization from $RCLONE_REMOTE..."

    # Create staging directory
    mkdir -p "$STAGING_DIR"

    # Sync each backup path
    for path in "${BACKUP_PATHS[@]}"; do
        log "Syncing $path..."

        # Build exclude arguments
        local exclude_args=()
        for pattern in "${EXCLUDE_PATTERNS[@]}"; do
            exclude_args+=(--exclude "$pattern")
        done

        # Sync with rclone
        if rclone --config "$RCLONE_CONFIG" sync \
            "$RCLONE_REMOTE:$path" "$STAGING_DIR$path" \
            "${exclude_args[@]}" \
            --progress \
            --stats 30s \
            >> "$LOG_FILE" 2>&1; then
            log "Successfully synced $path"
        else
            log "WARNING: Failed to sync $path (may not exist on remote)"
        fi
    done

    log "File synchronization completed"
}

perform_backup() {
    log "Starting restic backup..."

    # Check if staging directory has content
    if [[ ! -d "$STAGING_DIR" ]] || [[ -z "$(ls -A "$STAGING_DIR" 2>/dev/null)" ]]; then
        error_exit "No files to backup - staging directory is empty"
    fi

    # Build backup command
    local backup_cmd="restic backup"
    backup_cmd="$backup_cmd \"$STAGING_DIR\""
    backup_cmd="$backup_cmd --tag ${SERVICE_NAME}"
    backup_cmd="$backup_cmd --tag $(hostname)"
    backup_cmd="$backup_cmd --tag $(date +%Y-%m-%d)"

    # Execute backup
    log "Executing: $backup_cmd"
    if eval "$backup_cmd" >> "$LOG_FILE" 2>&1; then
        local backup_exit_code=$?

        if [[ $backup_exit_code -eq 0 ]]; then
            log "Backup completed successfully"
        elif [[ $backup_exit_code -eq 1 ]]; then
            log "Backup completed with warnings"
        else
            error_exit "Backup failed with exit code $backup_exit_code"
        fi
    else
        error_exit "Backup command failed"
    fi
}

cleanup_old_snapshots() {
    log "Cleaning up old snapshots..."

    local cleanup_cmd="restic forget"
    cleanup_cmd="$cleanup_cmd --tag ${SERVICE_NAME}"
{% if backup_target.retention_policy is defined %}
    cleanup_cmd="$cleanup_cmd --keep-daily {{ backup_target.retention_policy.daily }}"
    cleanup_cmd="$cleanup_cmd --keep-weekly {{ backup_target.retention_policy.weekly }}"
    cleanup_cmd="$cleanup_cmd --keep-monthly {{ backup_target.retention_policy.monthly }}"
    cleanup_cmd="$cleanup_cmd --keep-yearly {{ backup_target.retention_policy.yearly }}"
{% else %}
    cleanup_cmd="$cleanup_cmd --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --keep-yearly 1"
{% endif %}
    cleanup_cmd="$cleanup_cmd --prune"

    log "Executing: $cleanup_cmd"
    if eval "$cleanup_cmd" >> "$LOG_FILE" 2>&1; then
        log "Cleanup completed successfully"
    else
        log "WARNING: Cleanup failed but backup was successful"
    fi
}

get_backup_stats() {
    log "Getting backup statistics..."

    if restic snapshots --tag "${SERVICE_NAME}" --json > /tmp/snapshots.json 2>>"$LOG_FILE"; then
        local snapshot_count=$(jq length /tmp/snapshots.json 2>/dev/null || echo "unknown")
        log "Total snapshots for ${SERVICE_NAME}: $snapshot_count"
        rm -f /tmp/snapshots.json
    else
        log "Could not retrieve backup statistics"
    fi
}

# Main execution
main() {
    log "=== Starting centralized backup for ${SERVICE_NAME} ==="

    # Set up cleanup trap
    trap cleanup_staging EXIT

    check_prerequisites
    test_connectivity
    sync_remote_files
    perform_backup
    cleanup_old_snapshots
    get_backup_stats

    log "=== Backup completed for ${SERVICE_NAME} ==="
}

# Execute main function
main "$@"