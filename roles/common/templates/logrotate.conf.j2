# Only the logs this repo's cron jobs write: Debian packages rotate their own /var/log files, and logrotate
# rejects the whole file when a pattern matches a log another config already rotates.
/var/log/*-syncthing-backup.log {
    daily
    rotate {{ common_log_rotation_days }}
    {% if common_log_compression %}
    compress
    delaycompress
    {% endif %}
    missingok
    notifempty
    create 0644 root root
}
