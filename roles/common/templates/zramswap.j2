# Sourced by zramswap.service as a shell fragment, so keys are plain shell assignments.

# zstd compresses best; worth the CPU on low-RAM boards.
ALGO={{ common_zram_algorithm }}

# A cap, not a reservation: RAM is only used as compressed pages are stored.
PERCENT={{ common_zram_percent }}

# Above the default swap file's priority, so zram is used before flash swap.
PRIORITY={{ common_zram_priority }}
