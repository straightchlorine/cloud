#!/bin/bash
# Enhanced Enterprise Centralized Restore Script
# Restores {{ backup_target.service_name }} and pushes back to {{ backup_target.target_host }}
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
export RESTIC_REPOSITORY="{{ restic_repository }}"
export RESTIC_PASSWORD_FILE="{{{ common_backup_password_file }}}"
export RESTIC_CACHE_DIR="{{{ common_backup_cache_dir }}}"

# Service configuration
SERVICE_NAME="{{{ common_backup_service_name }}}"
TARGET_HOST="{{ backup_target.target_host }}"
SSH_USER="{{ backup_target.ssh_user | default('backup') }}"
SSH_KEY="{{{ common_backup_base_path }}}/keys/{{{ common_backup_service_name }}}-ssh-key"
RESTORE_DIR="{{{ common_backup_base_path }}}/restore-staging/${SERVICE_NAME}"
LOG_FILE="{{{ common_backup_log_dir }}}/restore-${SERVICE_NAME}-$(date +%Y%m%d_%H%M%S).log"

# Enhanced configuration
{% if backup_target.restore_pushback_enabled is defined and backup_target.restore_pushback_enabled %}
PUSHBACK_ENABLED=true
{% else %}
PUSHBACK_ENABLED=false
{% endif %}

{% if backup_target.network_optimization is defined and backup_target.network_optimization %}
NETWORK_OPTIMIZATION=true
BANDWIDTH_LIMIT="{{ backup_target.bandwidth_limit_mbps | default(0) }}"
CONCURRENT_TRANSFERS="{{ backup_target.concurrent_transfers | default(3) }}"
{% else %}
NETWORK_OPTIMIZATION=false
{% endif %}

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [RESTORE-${SERVICE_NAME}] $*" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    cleanup_restore_staging
    exit "${2:-1}"
}

usage() {
    cat << EOF
Usage: $0 [OPTIONS]
Enhanced Enterprise Restore Script for $SERVICE_NAME

OPTIONS:
    --snapshot-id SNAPSHOT     Restore specific snapshot ID
    --latest                   Restore latest snapshot (default)
    --date YYYY-MM-DD          Restore snapshot from specific date
    --paths PATH1,PATH2        Restore specific paths only
    --target-path PATH         Restore to specific path on target
    --dry-run                  Show what would be restored without executing
    --verify-only              Verify restore integrity without push-back
    --force                    Force overwrite existing files on target
    --help                     Show this help message

EXAMPLES:
    $0 --latest
    $0 --snapshot-id a1b2c3d4
    $0 --date 2024-01-15
    $0 --paths "/etc,/home" --target-path "/restore"
    $0 --dry-run --latest
EOF
}

cleanup_restore_staging() {
    if [[ -d "$RESTORE_DIR" ]]; then
        log "Cleaning up restore staging directory: $RESTORE_DIR"
        rm -rf "$RESTORE_DIR"
    fi
}

check_prerequisites() {
    log "Checking restore prerequisites..."

    # Check restic
    if ! command -v restic >/dev/null 2>&1; then
        error_exit "restic is not installed or not in PATH"
    fi

    # Check password file
    if [[ ! -f "$RESTIC_PASSWORD_FILE" ]]; then
        error_exit "Password file not found: $RESTIC_PASSWORD_FILE"
    fi

    # Check SSH key
    if [[ "$PUSHBACK_ENABLED" == "true" && ! -f "$SSH_KEY" ]]; then
        error_exit "SSH key not found: $SSH_KEY"
    fi

    # Check repository accessibility
    if ! restic snapshots >/dev/null 2>&1; then
        error_exit "Cannot access backup repository: $RESTIC_REPOSITORY"
    fi

    log "Prerequisites check completed"
}

list_snapshots() {
    log "Available snapshots for $SERVICE_NAME:"
    restic snapshots --tag "$SERVICE_NAME" --compact
}

get_snapshot_id() {
    local selection="$1"

    case "$selection" in
        latest)
            restic snapshots --tag "$SERVICE_NAME" --json | jq -r '.[0].id' 2>/dev/null
            ;;
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
            restic snapshots --tag "$SERVICE_NAME" --json | jq -r ".[] | select(.time | startswith(\"$selection\")) | .id" | head -1
            ;;
        *)
            echo "$selection"
            ;;
    esac
}

perform_restore() {
    local snapshot_id="$1"
    local restore_paths="${2:-}"
    local dry_run="${3:-false}"

    log "Starting restore operation..."
    log "Snapshot ID: $snapshot_id"
    log "Restore paths: ${restore_paths:-all}"
    log "Dry run: $dry_run"

    # Create restore staging directory
    mkdir -p "$RESTORE_DIR"

    local restore_start=$(date +%s)
    local restore_args=(restore "$snapshot_id" --target "$RESTORE_DIR")

    # Add specific paths if provided
    if [[ -n "$restore_paths" ]]; then
        IFS=',' read -ra PATHS <<< "$restore_paths"
        for path in "${PATHS[@]}"; do
            restore_args+=(--include "$path")
        done
    fi

    # Execute restore
    if [[ "$dry_run" == "true" ]]; then
        log "DRY RUN: Would execute: restic ${restore_args[*]}"
        log "DRY RUN: Would restore to: $RESTORE_DIR"
        return 0
    fi

    log "Executing restore: restic ${restore_args[*]}"
    if restic "${restore_args[@]}" >> "$LOG_FILE" 2>&1; then
        local restore_end=$(date +%s)
        local restore_duration=$((restore_end - restore_start))
        log "Restore completed successfully in ${restore_duration}s"

        # Verify restored data
        verify_restored_data
        return 0
    else
        local restore_end=$(date +%s)
        local restore_duration=$((restore_end - restore_start))
        error_exit "Restore failed after ${restore_duration}s"
    fi
}

verify_restored_data() {
    log "Verifying restored data integrity..."

    if [[ ! -d "$RESTORE_DIR" ]]; then
        error_exit "Restore directory not found: $RESTORE_DIR"
    fi

    local file_count=$(find "$RESTORE_DIR" -type f | wc -l)
    local dir_count=$(find "$RESTORE_DIR" -type d | wc -l)

    log "Restored: $file_count files, $dir_count directories"

    # Basic integrity checks
    if [[ $file_count -eq 0 ]]; then
        error_exit "No files were restored"
    fi

    log "Data integrity verification completed"
}

test_target_connectivity() {
    log "Testing connectivity to target host $TARGET_HOST..."

    if ssh -i "$SSH_KEY" -o ConnectTimeout=10 -o BatchMode=yes "$SSH_USER@$TARGET_HOST" "echo 'Connection test successful'" >/dev/null 2>&1; then
        log "Target connectivity test passed"
    else
        error_exit "Cannot connect to target host: $SSH_USER@$TARGET_HOST"
    fi
}

push_back_to_target() {
    local target_path="${1:-/}"
    local force_overwrite="${2:-false}"
    local dry_run="${3:-false}"

    log "Starting push-back to target host..."
    log "Target host: $TARGET_HOST"
    log "Target path: $target_path"
    log "Force overwrite: $force_overwrite"

    if [[ "$PUSHBACK_ENABLED" != "true" ]]; then
        log "Push-back is disabled for this service"
        return 0
    fi

    test_target_connectivity

    # Build rsync arguments
    local rsync_args=(
        -avz
        --progress
        --stats
        -e "ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new"
    )

    if [[ "$NETWORK_OPTIMIZATION" == "true" && "$BANDWIDTH_LIMIT" != "0" ]]; then
        rsync_args+=(--bwlimit="${BANDWIDTH_LIMIT}000")
    fi

    if [[ "$force_overwrite" != "true" ]]; then
        rsync_args+=(--ignore-existing)
    fi

    # Add source and destination
    rsync_args+=("$RESTORE_DIR/" "$SSH_USER@$TARGET_HOST:$target_path")

    # Execute push-back
    if [[ "$dry_run" == "true" ]]; then
        log "DRY RUN: Would execute: rsync ${rsync_args[*]}"
        return 0
    fi

    local pushback_start=$(date +%s)
    log "Executing push-back: rsync ${rsync_args[*]}"

    if rsync "${rsync_args[@]}" >> "$LOG_FILE" 2>&1; then
        local pushback_end=$(date +%s)
        local pushback_duration=$((pushback_end - pushback_start))
        log "Push-back completed successfully in ${pushback_duration}s"

        # Verify push-back
        verify_pushback_success "$target_path"
    else
        local pushback_end=$(date +%s)
        local pushback_duration=$((pushback_end - pushback_start))
        error_exit "Push-back failed after ${pushback_duration}s"
    fi
}

verify_pushback_success() {
    local target_path="$1"

    log "Verifying push-back success..."

    # Count files on target
    local remote_file_count=$(ssh -i "$SSH_KEY" "$SSH_USER@$TARGET_HOST" "find '$target_path' -type f 2>/dev/null | wc -l" 2>/dev/null || echo "0")
    local local_file_count=$(find "$RESTORE_DIR" -type f | wc -l)

    log "Local files: $local_file_count, Remote files: $remote_file_count"

    if [[ "$remote_file_count" -gt 0 ]]; then
        log "Push-back verification successful"
    else
        log "WARNING: Push-back verification shows no files on target"
    fi
}

# Main execution
main() {
    local snapshot_selection="latest"
    local restore_paths=""
    local target_path="/"
    local dry_run=false
    local verify_only=false
    local force_overwrite=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --snapshot-id)
                snapshot_selection="$2"
                shift 2
                ;;
            --latest)
                snapshot_selection="latest"
                shift
                ;;
            --date)
                snapshot_selection="$2"
                shift 2
                ;;
            --paths)
                restore_paths="$2"
                shift 2
                ;;
            --target-path)
                target_path="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --verify-only)
                verify_only=true
                shift
                ;;
            --force)
                force_overwrite=true
                shift
                ;;
            --help)
                usage
                exit 0
                ;;
            *)
                log "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done

    log "=== Starting centralized restore for ${SERVICE_NAME} ==="

    # Set up cleanup trap
    trap cleanup_restore_staging EXIT

    check_prerequisites

    # Get snapshot ID
    local snapshot_id=$(get_snapshot_id "$snapshot_selection")
    if [[ -z "$snapshot_id" || "$snapshot_id" == "null" ]]; then
        log "Available snapshots:"
        list_snapshots
        error_exit "No snapshot found for selection: $snapshot_selection"
    fi

    # Perform restore
    perform_restore "$snapshot_id" "$restore_paths" "$dry_run"

    # Push back to target (unless verify-only)
    if [[ "$verify_only" != "true" ]]; then
        push_back_to_target "$target_path" "$force_overwrite" "$dry_run"
    fi

    log "=== Restore operation completed for ${SERVICE_NAME} ==="
}

# Execute main function
main "$@"
