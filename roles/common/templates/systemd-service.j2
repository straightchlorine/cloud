# Common Systemd Service Template
# Standardized service definition with security hardening
# Managed by Ansible - Do not edit manually
#
# Variable naming convention:
#   - common_ prefix: variables with role-level defaults (e.g. common_restart_policy,
#     common_wanted_by, common_enable_security_hardening). These are always available.
#   - No prefix: variables passed by callers only when needed (e.g. service_user,
#     exec_start, working_directory). Guarded by 'is defined' checks.
#
# Known issue: some guards check unprefixed names but render common_ prefixed values
# (e.g. working_directory vs common_working_directory, timeout_start_sec vs
# common_timeout_start_sec, protect_system vs common_protect_system). Callers pass
# the common_ prefixed names, so these sections may not render as intended. Fixing
# requires coordinating all 13+ callers -- tracked for a future refactor.

[Unit]
Description={{ service_description }}
{% if service_requires is defined %}
{% for req in service_requires %}
Requires={{ req }}
{% endfor %}
{% endif %}
{% if service_after is defined %}
{% for after in service_after %}
After={{ after }}
{% endfor %}
{% endif %}
{% if service_wants is defined %}
{% for want in service_wants %}
Wants={{ want }}
{% endfor %}
{% endif %}
{% if service_before is defined %}
{% for before in service_before %}
Before={{ before }}
{% endfor %}
{% endif %}

[Service]
Type={{ service_type }}
{% if service_type == 'oneshot' %}
RemainAfterExit={{ common_remain_after_exit }}
{% endif %}
{% if service_user is defined %}
User={{ service_user }}
{% endif %}
{% if service_group is defined %}
Group={{ service_group }}
{% endif %}
{% if working_directory is defined %}
WorkingDirectory={{ common_working_directory }}
{% endif %}

# Command configuration
{% if exec_start is defined %}
ExecStart={{ exec_start }}
{% endif %}
{% if exec_stop is defined %}
ExecStop={{ exec_stop }}
{% endif %}
{% if exec_reload is defined %}
ExecReload={{ exec_reload }}
{% endif %}
{% if exec_start_pre is defined %}
{% for pre_cmd in exec_start_pre %}
ExecStartPre={{ pre_cmd }}
{% endfor %}
{% endif %}
{% if exec_start_post is defined %}
{% for post_cmd in exec_start_post %}
ExecStartPost={{ post_cmd }}
{% endfor %}
{% endif %}

# Environment variables
{% if service_environment is defined %}
{% for env_var in service_environment %}
Environment="{{ env_var }}"
{% endfor %}
{% endif %}
{% if environment_file is defined %}
EnvironmentFile={{ environment_file }}
{% endif %}

# Logging configuration
StandardOutput={{ common_standard_output }}
StandardError={{ common_standard_error }}
{% if syslog_identifier is defined %}
SyslogIdentifier={{ syslog_identifier }}
{% endif %}

# Restart configuration
Restart={{ common_restart_policy }}
RestartSec={{ common_restart_sec }}
{% if timeout_start_sec is defined %}
TimeoutStartSec={{ common_timeout_start_sec }}
{% endif %}
{% if timeout_stop_sec is defined %}
TimeoutStopSec={{ timeout_stop_sec }}
{% endif %}
{% if kill_mode is defined %}
KillMode={{ kill_mode }}
{% endif %}

# Security hardening (configurable)
{% if common_enable_security_hardening %}
# Process security
NoNewPrivileges={{ common_no_new_privileges }}
{% if protect_system is defined %}
ProtectSystem={{ common_protect_system }}
{% endif %}
{% if protect_home is defined %}
ProtectHome={{ common_protect_home }}
{% endif %}
{% if private_tmp is defined %}
PrivateTmp={{ common_private_tmp }}
{% endif %}
{% if read_only_paths is defined %}
{% for path in read_only_paths %}
ReadOnlyPaths={{ path }}
{% endfor %}
{% endif %}
{% if read_write_paths is defined %}
{% for path in read_write_paths %}
ReadWritePaths={{ path }}
{% endfor %}
{% endif %}

# Network security
{% if private_network is defined %}
PrivateNetwork={{ private_network }}
{% endif %}
{% if restrict_address_families is defined %}
RestrictAddressFamilies={{ restrict_address_families | join(' ') }}
{% endif %}

# Capability restrictions
{% if capability_bounding_set is defined %}
CapabilityBoundingSet={{ capability_bounding_set | join(' ') }}
{% endif %}
{% if ambient_capabilities is defined %}
AmbientCapabilities={{ ambient_capabilities | join(' ') }}
{% endif %}

# Advanced security options
{% if protect_kernel_tunables is defined %}
ProtectKernelTunables={{ protect_kernel_tunables }}
{% endif %}
{% if protect_kernel_modules is defined %}
ProtectKernelModules={{ protect_kernel_modules }}
{% endif %}
{% if protect_control_groups is defined %}
ProtectControlGroups={{ protect_control_groups }}
{% endif %}
{% if restrict_suid_sgid is defined %}
RestrictSUIDSGID={{ restrict_suid_sgid }}
{% endif %}
{% if restrict_realtime is defined %}
RestrictRealtime={{ restrict_realtime }}
{% endif %}
{% if restrict_namespaces is defined %}
RestrictNamespaces={{ restrict_namespaces }}
{% endif %}

# Memory and resource limits
{% if memory_limit is defined %}
MemoryMax={{ memory_limit }}
{% endif %}
{% if memory_max is defined %}
MemoryMax={{ memory_max }}
{% endif %}
{% if memory_high is defined %}
MemoryHigh={{ memory_high }}
{% endif %}
{% if cpu_quota is defined %}
CPUQuota={{ cpu_quota }}
{% endif %}
{% if tasks_max is defined %}
TasksMax={{ tasks_max }}
{% endif %}
{% if limit_nofile is defined %}
LimitNOFILE={{ limit_nofile }}
{% endif %}

# Process priority
{% if nice_level is defined %}
Nice={{ nice_level }}
{% endif %}
{% if io_scheduling_class is defined %}
IOSchedulingClass={{ io_scheduling_class }}
{% endif %}
{% if io_scheduling_priority is defined %}
IOSchedulingPriority={{ io_scheduling_priority }}
{% endif %}

# Start limit configuration
{% if start_limit_burst is defined %}
StartLimitBurst={{ start_limit_burst }}
{% endif %}
{% if start_limit_interval_sec is defined %}
StartLimitIntervalSec={{ start_limit_interval_sec }}
{% endif %}
{% endif %}

[Install]
WantedBy={{ common_wanted_by }}
