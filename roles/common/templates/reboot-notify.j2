#!/bin/bash
# Cron runs this three hours before the scheduled reboot, so a pending reboot is known in advance.
# It notifies only when /var/run/reboot-required exists, which the nightly unattended-upgrades run creates.

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "Usage: reboot-notify"
  echo ""
  echo "Check if a reboot is pending and send a ntfy notification."
  echo "Called by cron three hours before the scheduled auto-reboot."
  exit 0
fi

if [ -f /var/run/reboot-required ]; then
  ntfy-notify "$(hostname): reboot pending" \
    "System will reboot at {{ common_auto_updates_reboot_time }} for pending updates." default warning
fi
