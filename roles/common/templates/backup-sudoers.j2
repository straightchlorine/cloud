# {{ ansible_managed }}
# env_keep passes the RESTIC_* and TMPDIR variables through sudo's env_reset.
Defaults:backup !requiretty
Defaults:backup env_keep += "RESTIC_REPOSITORY RESTIC_PASSWORD_FILE RESTIC_CACHE_DIR RESTIC_SFTP_COMMAND TMPDIR"

backup ALL=(root) NOPASSWD: /usr/bin/restic backup *, /usr/bin/restic snapshots *, /usr/bin/restic forget *, /usr/bin/restic prune *, /usr/bin/restic check *, /usr/bin/restic init *, /usr/bin/restic restore *, /usr/bin/rclone sync *, /usr/bin/rclone copy *, /usr/bin/rclone check *
