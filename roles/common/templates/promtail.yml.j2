# Promtail configuration for {{ inventory_hostname }}
# Ships logs to centralized Loki instance for aggregation

server:
  http_listen_address: 127.0.0.1
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://{{ loki_server }}:{{ loki_port }}/loki/api/v1/push

scrape_configs:
  # System logs
  - job_name: syslog
    static_configs:
      - targets:
          - localhost
        labels:
          job: syslog
          host: {{ inventory_hostname }}
          role: {{ prometheus_role }}
          __path__: /var/log/syslog

  # Authentication logs
  - job_name: auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          host: {{ inventory_hostname }}
          role: {{ prometheus_role }}
          __path__: /var/log/auth.log

  # Kernel logs
  - job_name: kernel
    static_configs:
      - targets:
          - localhost
        labels:
          job: kernel
          host: {{ inventory_hostname }}
          role: {{ prometheus_role }}
          __path__: /var/log/kern.log

{% if prometheus_role == 'dns' %}
  # Pi-hole logs
  - job_name: pihole
    static_configs:
      - targets:
          - localhost
        labels:
          job: pihole
          service: dns
          host: {{ inventory_hostname }}
          role: dns
          __path__: /var/log/pihole.log

  # Pi-hole FTL logs
  - job_name: pihole-ftl
    static_configs:
      - targets:
          - localhost
        labels:
          job: pihole-ftl
          service: dns
          host: {{ inventory_hostname }}
          role: dns
          __path__: /var/log/pihole-FTL.log

  # DNS query logs (if enabled)
  - job_name: dns-queries
    static_configs:
      - targets:
          - localhost
        labels:
          job: dns-queries
          service: dns
          host: {{ inventory_hostname }}
          role: dns
          __path__: /var/log/dnsmasq.log*
{% endif %}

{% if prometheus_role == 'automation' %}
  # Docker container logs
  - job_name: docker-containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        target_label: 'container'
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: 'stream'
    pipeline_stages:
      - json:
          expressions:
            log: log
            timestamp: time
      - timestamp:
          source: timestamp
          format: RFC3339Nano
      - output:
          source: log
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker
          service: automation
          host: {{ inventory_hostname }}
          role: automation

  # Traefik access logs
  - job_name: traefik-access
    static_configs:
      - targets:
          - localhost
        labels:
          job: traefik-access
          service: traefik
          host: {{ inventory_hostname }}
          role: automation
          __path__: {{ automation_stack_home }}/logs/access.log*

  # Traefik application logs
  - job_name: traefik-app
    static_configs:
      - targets:
          - localhost
        labels:
          job: traefik-app
          service: traefik
          host: {{ inventory_hostname }}
          role: automation
          __path__: {{ automation_stack_home }}/logs/traefik.log*
{% endif %}

{% if prometheus_role == 'music' %}
  # Docker container logs for music stack
  - job_name: docker-music
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
        filters:
          - name: label
            values: ["role=music"]
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        target_label: 'container'
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: 'stream'
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker-music
          service: music
          host: {{ inventory_hostname }}
          role: music

  # Navidrome logs
  - job_name: navidrome
    static_configs:
      - targets:
          - localhost
        labels:
          job: navidrome
          service: navidrome
          host: {{ inventory_hostname }}
          role: music
          __path__: {{ music_stack_home }}/logs/navidrome.log*

  # YouTube download logs
  - job_name: youtube-dl
    static_configs:
      - targets:
          - localhost
        labels:
          job: youtube-dl
          service: youtube-sync
          host: {{ inventory_hostname }}
          role: music
          __path__: /opt/backup/logs/youtube-dl.log*
{% endif %}

  # Backup logs for all hosts
  - job_name: backup-logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: backup
          service: backup
          host: {{ inventory_hostname }}
          role: {{ prometheus_role }}
          __path__: /opt/backup/logs/*.log

  # Ansible logs
  - job_name: ansible
    static_configs:
      - targets:
          - localhost
        labels:
          job: ansible
          service: deployment
          host: {{ inventory_hostname }}
          role: {{ prometheus_role }}
          __path__: /var/log/ansible.log

  # Application-specific logs based on role
  - job_name: application
    static_configs:
      - targets:
          - localhost
        labels:
          job: application
          service: {{ prometheus_role }}
          host: {{ inventory_hostname }}
          role: {{ prometheus_role }}
          __path__: /var/log/{{ prometheus_role | default('application') }}/*.log
