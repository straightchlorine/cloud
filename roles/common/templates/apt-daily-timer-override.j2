# {{ ansible_managed }}
# Daytime dpkg runs stall services on small hosts, so move the timers off-hours.
# OnCalendar is a list: the empty assignment clears the packaged times,
# otherwise this schedule would be added to them.
[Timer]
OnCalendar=
OnCalendar=*-*-* {{ common_auto_updates_run_time }}
RandomizedDelaySec=30m
