#!/usr/bin/env bash
# Local {{ common_snapshot_name }} stack -> Syncthing backup: {{ common_snapshot_summary }}
#
# Managed by Ansible.
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo "Usage: {{ common_snapshot_name }}-syncthing-backup"
    echo ""
    echo "Snapshot the {{ common_snapshot_name }} stack ({{ common_snapshot_summary }})"
    echo "into the Syncthing-shared folder. Sends ntfy on success or failure."
    exit 0
fi

trap 'ntfy-notify "$(hostname): {{ common_snapshot_name }} stack backup failed" \
  "Unexpected error at line $LINENO. Check /var/log/{{ common_snapshot_name }}-syncthing-backup.log." high rotating_light,error' ERR

STACK_HOME="{{ common_snapshot_stack_home }}"
DEST="{{ common_snapshot_dest }}"
RETENTION="{{ common_snapshot_retention }}"
OWNER="{{ common_snapshot_owner }}"
STAMP="$(date +%Y-%m-%d_%H-%M-%S)"
# Steps append caveats here; they end up in the success notification.
NOTES=""
# Built next to DEST (same filesystem) so the final mv is atomic: Syncthing
# never sees a half-written snapshot.
WORK="$(mktemp -d "$(dirname "$DEST")/.{{ common_snapshot_name }}-backup.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

cd "$STACK_HOME"

{% for step in common_snapshot_steps %}
{{ step | trim }}

{% endfor %}
# Hand ownership to the Syncthing user before the snapshot becomes visible.
chmod 0750 "$WORK"
chown -R "$OWNER" "$WORK"
mv "$WORK" "$DEST/$STAMP"

# Retention: keep the newest $RETENTION snapshot directories; wipe the rest.
shopt -s nullglob
printf '%s\n' "$DEST"/20* "$DEST"/19* \
    | sort -r \
    | tail -n +"$((RETENTION + 1))" \
    | xargs -r rm -rf
shopt -u nullglob

ntfy-notify "$(hostname): {{ common_snapshot_name }} stack backup successful" \
    "{{ common_snapshot_summary }} replicated to $DEST.$NOTES" default white_check_mark
