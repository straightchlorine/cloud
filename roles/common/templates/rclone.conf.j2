# Rclone Configuration for Centralized Backups
# Generated by Ansible - Do not edit manually

{% for target in centralized_backup_targets %}
[{{ target.service_name }}]
type = sftp
host = {{ target.target_host }}
user = {{ target.ssh_user }}
key_file = {{{ common_backup_base_path }}}/keys/{{ target.service_name }}-ssh-key
use_insecure_cipher = false
disable_hashcheck = false
{% if target.ssh_port is defined %}
port = {{ target.ssh_port }}
{% endif %}
{% if target.ssh_options is defined %}
{% for option in target.ssh_options %}
{{ option }}
{% endfor %}
{% endif %}

{% endfor %}
