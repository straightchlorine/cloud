  {{ service_name }}:
    image: {{ service_image }}
    container_name: {{ service_name }}
    # A service may override the restart policy, for example with "no" for on-demand containers.
    restart: {{ service_restart if service_restart is defined else common_service_restart }}
{% if service_stop_grace_period is defined %}
    stop_grace_period: {{ service_stop_grace_period }}
{% endif %}
{% if service_ports is defined %}
    ports:
{% for port in service_ports %}
{% if port is string %}
      - "{{ port }}"
{% elif port.bind_ip is defined and port.bind_ip | length > 0 %}
      - "{{ port.bind_ip }}:{{ port.host }}:{{ port.container }}"
{% elif port.bind_to_localhost is defined and port.bind_to_localhost %}
      - "127.0.0.1:{{ port.host }}:{{ port.container }}"
{% else %}
      - "{{ port.host }}:{{ port.container }}"
{% endif %}
{% endfor %}
{% endif %}
{% if service_entrypoint is defined %}
    entrypoint: {{ service_entrypoint }}
{% endif %}
{% if service_command is defined %}
    command: {{ service_command }}
{% endif %}
{% if service_user is defined %}
    user: "{{ service_user }}"
{% endif %}
{% if service_userns_mode is defined %}
    userns_mode: "{{ service_userns_mode }}"
{% endif %}
{% if service_env_file is defined %}
    env_file: {{ service_env_file }}
{% endif %}
{% if service_environment is defined %}
    environment:
{% for env_var in service_environment %}
      - "{{ env_var }}"
{% endfor %}
{% endif %}
{% if service_volumes is defined %}
    volumes:
{% for volume in service_volumes %}
      - {{ volume }}
{% endfor %}
{% endif %}
{% if service_networks is defined %}
    networks:
{% for network in service_networks %}
      - {{ network }}
{% endfor %}
{% endif %}
{# Docker otherwise passes the host's resolver list through its embedded DNS.
   Behind a Pi-hole that means one resolver with a short single-attempt timeout, so one hiccup fails every lookup.
   Explicit resolvers avoid that. #}
{% if service_dns is defined %}
    dns:
{% for server in service_dns %}
      - "{{ server }}"
{% endfor %}
{% endif %}
{% if service_profiles is defined %}
    profiles:
{% for profile in service_profiles %}
      - {{ profile }}
{% endfor %}
{% endif %}
{% if service_labels is defined %}
    labels:
{% for label in service_labels %}
      - "{{ label }}"
{% endfor %}
{% endif %}
{% if service_depends_on is defined %}
    depends_on:
{% for dependency in service_depends_on %}
{% if dependency is string %}
      - {{ dependency }}
{% else %}
      {{ dependency.service }}:
        condition: {{ dependency.condition }}
{% endif %}
{% endfor %}
{% endif %}
{% if service_healthcheck is defined %}
{% set healthcheck = common_service_healthcheck_defaults | combine(service_healthcheck) %}
    healthcheck:
      test: {{ healthcheck.test }}
      interval: {{ healthcheck.interval }}
      timeout: {{ healthcheck.timeout }}
      retries: {{ healthcheck.retries }}
      start_period: {{ healthcheck.start_period }}
{% endif %}
{# Docker's default soft nofile limit stays low whatever the daemon's LimitNOFILE says, which only sets the hard limit.
   A long-running service that opens many files needs its own ulimits. #}
{% if service_ulimits is defined %}
    ulimits:
{% for ulimit_name, ulimit_value in service_ulimits.items() %}
      {{ ulimit_name }}:
        soft: {{ ulimit_value.soft }}
        hard: {{ ulimit_value.hard }}
{% endfor %}
{% endif %}
{% if service_resources is defined or service_devices is defined %}
    deploy:
      resources:
{% if service_resources is defined %}
        limits:
          memory: {{ service_resources.limits.memory }}
          cpus: "{{ service_resources.limits.cpus }}"
{% endif %}
        reservations:
{% if service_resources is defined %}
          memory: {{ service_resources.reservations.memory }}
          cpus: "{{ service_resources.reservations.cpus }}"
{% endif %}
{% if service_devices is defined %}
          devices:
{% for device in service_devices %}
            - driver: {{ device.driver }}
{% if device.count is defined %}
              count: {{ device.count }}
{% endif %}
{% if device.device_ids is defined %}
              device_ids: {{ device.device_ids }}
{% endif %}
              capabilities: {{ device.capabilities }}
{% endfor %}
{% endif %}
{% endif %}
