module honeywatch-nnp 1.0;

# Allow systemd units that have NoNewPrivileges=yes to invoke `docker`, which
# type-transitions from unconfined_service_t to container_runtime_t.
#
# Without this, honeywatch-backup.service and honeywatch-mmdb-refresh.service fail
# under Enforcing: NoNewPrivileges blocks the domain transition that docker's
# labelled exec triggers. The blast radius is narrow - this is the only transition
# allowed, every other NNP-protected one still requires explicit policy.
#
# Rebuild from this source with:
#   checkmodule -M -m -o honeywatch-nnp.mod honeywatch-nnp.te
#   semodule_package -o honeywatch-nnp.pp -m honeywatch-nnp.mod

require {
    type container_runtime_t;
    type unconfined_service_t;
    class process2 nnp_transition;
}

#============= unconfined_service_t ==============
allow unconfined_service_t container_runtime_t:process2 nnp_transition;
