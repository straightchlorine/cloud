# {{ ansible_managed }}
#
# rclone reads RCLONE_CONFIG_R2_* from the environment and treats them as a
# remote named "r2", so no rclone config file exists on this host.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ENDPOINT={{ vault_honeypot_r2_endpoint }}
RCLONE_CONFIG_R2_ACCESS_KEY_ID={{ vault_honeypot_r2_access_key_id }}
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY={{ vault_honeypot_r2_secret_access_key }}
# Skip rclone's pre-upload CreateBucket probe: an R2 token scoped to Object
# Read & Write (no bucket-level Create) answers it with 403 and rclone aborts.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

R2_BUCKET={{ vault_honeypot_r2_bucket }}
R2_PREFIX={{ honeypot_backup_r2_prefix }}

# Public age recipient. The private identity stays offline - a compromised host
# can upload new backups but cannot decrypt anything already in R2.
AGE_RECIPIENT_FILE={{ honeypot_backup_age_recipient_file }}

RETENTION_DAYS={{ honeypot_backup_retention_days }}

# pg_dumpall runs inside the container over the Unix socket, which pg_hba.conf
# trusts - no Postgres password is stored on the host.
POSTGRES_CONTAINER={{ honeypot_backup_postgres_container }}
POSTGRES_USER={{ honeypot_backup_postgres_user }}
POSTGRES_DB={{ honeypot_backup_postgres_db }}
