[Unit]
Description=Weekly trigger for Honeywatch MaxMind GeoLite2 refresh
Documentation=https://github.com/straightchlorine/honeywatch

# {{ ansible_managed }}

[Timer]
# The GeoLite licence requires databases no older than 30 days, so a weekly refresh leaves margin.
# The default schedule falls after MaxMind's Tuesday release and clear of the backup.
OnCalendar={{ honeypot_mmdb_schedule }}
RandomizedDelaySec={{ honeypot_mmdb_randomized_delay }}
# Persistent runs a missed refresh on the next boot if the timer elapsed while the host was off.
Persistent=true
Unit=honeywatch-mmdb-refresh.service
AccuracySec=15min

[Install]
WantedBy=timers.target
