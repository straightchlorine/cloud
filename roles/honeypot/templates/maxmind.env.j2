# {{ ansible_managed }}
#
# The MaxMind download endpoint requires both the account id and the license
# key as HTTP Basic auth.
MAXMIND_ACCOUNT_ID={{ vault_honeypot_maxmind_account_id }}
MAXMIND_LICENSE_KEY={{ vault_honeypot_maxmind_license_key }}

# The stack checkout: the refresh unit invokes ${HONEYWATCH_DIR}/scripts/fetch-mmdb.sh.
HONEYWATCH_DIR={{ honeypot_stack_dir }}

GEOIP_VOLUME={{ honeypot_mmdb_geoip_volume }}
INGESTOR_CONTAINER={{ honeypot_mmdb_ingestor_container }}
