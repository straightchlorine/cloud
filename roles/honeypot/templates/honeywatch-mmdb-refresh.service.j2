[Unit]
Description=Honeywatch MaxMind GeoLite2 refresh (City + ASN)
Documentation=https://github.com/straightchlorine/honeywatch
After=docker.service
Requires=docker.service
OnFailure=honeywatch-notify@%n.service

# {{ ansible_managed }}

[Service]
Type=oneshot
User=root
SyslogIdentifier=honeywatch-mmdb-refresh
EnvironmentFile={{ honeypot_config_dir }}/maxmind.env
# Supplies NTFY_URL and NTFY_TOKEN for the success notification.
# The failure side goes through OnFailure above.
EnvironmentFile=-{{ honeypot_config_dir }}/notify.env
ExecStart=/usr/local/sbin/honeywatch-mmdb-refresh
# The run covers the database downloads, the ingestor restart and the IP reclassification.
TimeoutStartSec={{ honeypot_mmdb_timeout_sec }}

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Write access is limited to the geoip volume's mountpoint.
# The local volume driver derives that path from the volume name.
ReadWritePaths=/var/lib/docker/volumes/{{ honeypot_mmdb_geoip_volume }}/_data
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadOnlyPaths={{ honeypot_config_dir }}
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=yes
