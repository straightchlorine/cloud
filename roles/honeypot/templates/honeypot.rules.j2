# {{ ansible_managed }}
#
# Watches paths whose modification could weaken the host security posture.
# Each watch carries a key, so `ausearch -k <key>` finds its events.
# Applied with `augenrules --load`.

# Delete all loaded rules first so a reload does not stack duplicates.
-D

{% for watch in honeypot_audit_watches %}
-w {{ watch.path }} -p {{ watch.perms }} -k {{ watch.key }}
{% endfor %}

# The value 1 enables auditing but keeps the rules changeable. The value 2 locks the audit config until reboot.
-e {{ honeypot_audit_enable_flag }}
