[Unit]
Description=Daily trigger for Honeywatch encrypted Postgres backup
Documentation=https://github.com/straightchlorine/honeywatch

# {{ ansible_managed }}

[Timer]
# The schedule is in UTC so daylight saving shifts do not move the run.
OnCalendar={{ honeypot_backup_schedule }}
# The random delay spreads runs so several honeypots sharing a bucket do not upload at the same second.
RandomizedDelaySec={{ honeypot_backup_randomized_delay }}
# Persistent runs a missed backup on the next boot if the timer elapsed while the host was off.
Persistent=true
Unit=honeywatch-backup.service
AccuracySec=15min

[Install]
WantedBy=timers.target
