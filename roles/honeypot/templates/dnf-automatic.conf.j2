# {{ ansible_managed }}
#
# Applies {{ honeypot_auto_updates_upgrade_type }} updates on the
# dnf-automatic.timer schedule. Output goes to stdio so journald captures it:
# journalctl -u dnf-automatic.service

[commands]
apply_updates = yes
upgrade_type  = {{ honeypot_auto_updates_upgrade_type }}
# Reboot trigger list and schedule: see the README "Automatic updates" section.
reboot = {{ honeypot_auto_updates_reboot }}
reboot_command = "shutdown -r +5 'honeywatch: rebooting after dnf-automatic'"

[emitters]
emit_via = stdio

[base]
# One vendor repo outage (tailscale, docker, grafana, epel) must not abort the
# run and block BaseOS/AppStream kernel fixes; the skipped repo catches up next
# run. Signature failures still fail the run and reach ntfy.
skip_if_unavailable = True
excludepkgs = {{ honeypot_dnf_pinned_packages | join(',') }}
