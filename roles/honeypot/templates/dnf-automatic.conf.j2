# {{ ansible_managed }}
#
# Applies {{ honeypot_auto_updates_upgrade_type }} updates on the
# dnf-automatic.timer schedule. Output goes to stdio so journald captures it:
# journalctl -u dnf-automatic.service

[commands]
apply_updates = yes
upgrade_type  = {{ honeypot_auto_updates_upgrade_type }}
# roles/honeypot/README.md lists the reboot triggers and the schedule under "Automatic updates".
reboot = {{ honeypot_auto_updates_reboot }}
reboot_command = "shutdown -r +5 'honeywatch: rebooting after dnf-automatic'"

[emitters]
emit_via = stdio

[base]
# An outage of one vendor repo (tailscale, docker, grafana, epel) must not abort the run
# and block BaseOS and AppStream kernel fixes. The skipped repo catches up on the next run.
# Signature failures still fail the run and reach ntfy.
skip_if_unavailable = True
excludepkgs = {{ honeypot_dnf_pinned_packages | join(',') }}
