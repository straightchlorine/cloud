[Unit]
Description=Weekly trigger for the Honeywatch old release image prune
Documentation=https://github.com/straightchlorine/honeywatch

# {{ ansible_managed }}

[Timer]
# The schedule keeps clear of the backup and mmdb refresh so the docker daemon
# is not busy with either while it deletes layers.
OnCalendar={{ honeypot_image_prune_schedule }}
RandomizedDelaySec={{ honeypot_image_prune_randomized_delay }}
# Persistent runs a missed prune on the next boot if the timer elapsed while the host was off.
Persistent=true
Unit=honeywatch-image-prune.service
AccuracySec=15min

[Install]
WantedBy=timers.target
