# {{ ansible_managed }}
#
# Read by honeywatch-notify@.service (failure alerts) and by the backup and
# mmdb refresh scripts (success alerts). NTFY_TOKEN is required because the
# fleet ntfy server runs auth-default-access=deny-all.
NTFY_URL={{ honeypot_ntfy_url }}
NTFY_TOKEN={{ vault_honeypot_ntfy_token }}
