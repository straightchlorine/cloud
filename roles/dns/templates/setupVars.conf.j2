# Pi-hole Setup Variables
PIHOLE_INTERFACE={{ dns_pihole_interface }}
IPV4_ADDRESS={{ pihole_ipv4_address }}
IPV6_ADDRESS={{ pihole_ipv6_address }}
{% for dns_server in dns_pihole_dns_servers %}
PIHOLE_DNS_{{ loop.index }}={{ dns_server }}
{% endfor %}
QUERY_LOGGING=true
INSTALL_WEB_SERVER=true
INSTALL_WEB_INTERFACE=true
LIGHTTPD_ENABLED=true
CACHE_SIZE=10000
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSMASQ_LISTENING=single
WEBPASSWORD={{ vault_pihole_webpassword }}
BLOCKING_ENABLED=true
