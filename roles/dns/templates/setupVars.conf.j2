# Pi-hole Setup Variables
# Pre-seeded before the v6 installer runs. `pihole-FTL migrate v6` reads only
# these keys and writes them into /etc/pihole/pihole.toml; the rest of v5's
# setupVars.conf (IP addresses, lighttpd/web-server toggles, cache size,
# webpassword) has no v6 equivalent read by the migration - see
# https://github.com/pi-hole/FTL src/config/setupVars.c.
PIHOLE_INTERFACE={{ dns_pihole_interface }}
{% for dns_server in dns_pihole_dns_servers %}
PIHOLE_DNS_{{ loop.index }}={{ dns_server }}
{% endfor %}
QUERY_LOGGING=true
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSMASQ_LISTENING=single
BLOCKING_ENABLED=true
