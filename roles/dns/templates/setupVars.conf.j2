# v6 migration reads only these keys, writing them into pihole.toml.
# The rest of v5's setupVars.conf has no v6 equivalent - see
# https://github.com/pi-hole/FTL src/config/setupVars.c.
PIHOLE_INTERFACE={{ dns_pihole_interface }}
{% for dns_server in dns_pihole_dns_servers %}
PIHOLE_DNS_{{ loop.index }}={{ dns_server }}
{% endfor %}
QUERY_LOGGING=true
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSMASQ_LISTENING=single
BLOCKING_ENABLED=true
