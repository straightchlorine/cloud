# The Pi-hole v6 migration reads only these keys and writes them into pihole.toml.
# Other setupVars.conf keys have no v6 equivalent, as src/config/setupVars.c in pi-hole/FTL shows.
PIHOLE_INTERFACE={{ dns_pihole_interface }}
{% for dns_server in dns_pihole_dns_servers %}
PIHOLE_DNS_{{ loop.index }}={{ dns_server }}
{% endfor %}
QUERY_LOGGING=true
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSMASQ_LISTENING=single
BLOCKING_ENABLED=true
