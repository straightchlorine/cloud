#!/bin/bash
# No `apt upgrade` here: unattended-upgrades (common role) does that daily,
# fleet-wide - we'd just race it for the apt lock.

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "Usage: pihole-update"
  echo ""
  echo "Run weekly Pi-hole updates (pihole -up/-g). Called by cron."
  echo "Sends ntfy notification on success or failure."
  exit 0
fi

LOG_FILE="/var/log/weekly-updates.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')
FAILED=0

echo "[$DATE] Starting Pi-hole update..." >> $LOG_FILE

echo "[$DATE] Updating Pi-hole..." >> $LOG_FILE
if ! pihole -up >> $LOG_FILE 2>&1; then
  FAILED=1
  echo "[$DATE] pihole -up failed" >> $LOG_FILE
fi

echo "[$DATE] Updating Pi-hole gravity..." >> $LOG_FILE
if ! pihole -g >> $LOG_FILE 2>&1; then
  FAILED=1
  echo "[$DATE] pihole -g failed" >> $LOG_FILE
fi

echo "[$DATE] Restarting Pi-hole services..." >> $LOG_FILE
systemctl restart pihole-FTL >> $LOG_FILE 2>&1

echo "[$DATE] Pi-hole update completed" >> $LOG_FILE
echo "----------------------------------------" >> $LOG_FILE

if [ "$FAILED" -eq 1 ]; then
  ntfy-notify "$(hostname): Pi-hole update failed" \
    "pihole -up or -g reported errors - see /var/log/weekly-updates.log" high rotating_light,error
else
  ntfy-notify "$(hostname): Pi-hole update successful" \
    "Weekly pihole -up/-g completed successfully." default white_check_mark
fi
