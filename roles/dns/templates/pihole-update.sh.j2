#!/bin/bash
# Weekly Pi-hole update script.
# System package updates + reboot-if-required are handled separately and daily
# by unattended-upgrades (see 20auto-upgrades.j2/50unattended-upgrades.j2) -
# running `apt upgrade` here too would just race it for the apt lock.

LOG_FILE="/var/log/weekly-updates.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

echo "[$DATE] Starting Pi-hole update..." >> $LOG_FILE

# Update Pi-hole core
echo "[$DATE] Updating Pi-hole..." >> $LOG_FILE
pihole -up >> $LOG_FILE 2>&1

# Update Pi-hole gravity (blocklists)
echo "[$DATE] Updating Pi-hole gravity..." >> $LOG_FILE
pihole -g >> $LOG_FILE 2>&1

echo "[$DATE] Restarting Pi-hole services..." >> $LOG_FILE
systemctl restart pihole-FTL >> $LOG_FILE 2>&1

echo "[$DATE] Pi-hole update completed" >> $LOG_FILE
echo "----------------------------------------" >> $LOG_FILE
