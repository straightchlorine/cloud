#!/usr/bin/env bash
# Local Pi-hole -> Syncthing backup: Teleporter archive + FTL DB snapshot.
# Primary/off-site backup is restic (see restic_backup.yml). Managed by Ansible.
#
# Pi-hole v6 dropped the `pihole -a -t` Teleporter CLI; it's now REST-API-only
# (GET /api/teleporter with a sid from POST /api/auth). Root-only (0700) since
# this file embeds the web password.
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "Usage: pihole-syncthing-backup"
  echo ""
  echo "Back up Pi-hole (Teleporter archive + FTL DB) to the Syncthing-shared folder."
  echo "Sends ntfy notification on success or failure."
  exit 0
fi

trap 'ntfy-notify "$(hostname): Pi-hole Syncthing backup failed" \
  "Unexpected error at line $LINENO. Check /var/log/pihole-syncthing-backup.log." high rotating_light,error' ERR

DEST="{{ dns_backup_dir }}"
RETENTION="{{ dns_backup_retention }}"
OWNER="{{ dns_backup_owner }}"
FTL_DB="/etc/pihole/pihole-FTL.db"
WEBPASSWORD="{{ vault_pihole_webpassword }}"

mkdir -p "$DEST"

SID=$(jq -n --arg pw "$WEBPASSWORD" '{password:$pw}' \
  | curl -s -X POST http://127.0.0.1/api/auth --data @- \
  | jq -r '.session.sid')

if [ -z "$SID" ] || [ "$SID" = "null" ]; then
  echo "Pi-hole Teleporter backup failed: could not authenticate against the API" >&2
  ntfy-notify "$(hostname): Pi-hole Syncthing backup failed" \
    "Could not authenticate against the Pi-hole API." high rotating_light,error
  exit 1
fi

curl -s -H "X-FTL-SID: $SID" \
  -o "$DEST/pi-hole_$(hostname)_teleporter_$(date +%Y-%m-%d_%H-%M-%S).zip" \
  http://127.0.0.1/api/teleporter

curl -s -X DELETE -H "X-FTL-SID: $SID" http://127.0.0.1/api/auth >/dev/null

# SQLite online backup: safe while FTL is writing; cp can capture a torn write.
if [ -f "$FTL_DB" ]; then
  pihole-FTL sqlite3 "$FTL_DB" ".backup '${DEST}/pihole-FTL.db'"
fi

# Retention: keep newest $RETENTION archives; FTL DB is overwritten in place.
ls -1t "$DEST"/pi-hole_*_teleporter_*.zip 2>/dev/null \
  | tail -n +"$((RETENTION + 1))" \
  | xargs -r rm -f || true

# Hand ownership to the Syncthing user so it can replicate the files.
chown -R "$OWNER" "$DEST"

ntfy-notify "$(hostname): Pi-hole Syncthing backup successful" \
  "Teleporter archive and pihole-FTL.db snapshot written to $DEST." default white_check_mark
