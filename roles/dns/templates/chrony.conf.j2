# Local upstream (VLAN router) - lower latency, no external dependency.
server {{ dns_ntp_upstream_server }} iburst prefer

pool 2.debian.pool.ntp.org iburst maxsources 4
pool 0.debian.pool.ntp.org iburst maxsources 1
pool 1.debian.pool.ntp.org iburst maxsources 1
pool 3.debian.pool.ntp.org iburst maxsources 2
server time.cloudflare.com iburst
server time.google.com iburst

driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync

{% if dns_ntp_server_enabled %}
# Allow NTP client access from these networks
{% for network in dns_ntp_allowed_networks %}
allow {{ network }}
{% endfor %}

# Serve time even when not synchronized to a source.
local stratum 8
{% endif %}

keyfile /etc/chrony/chrony.keys
leapsectz right/UTC
logdir /var/log/chrony
