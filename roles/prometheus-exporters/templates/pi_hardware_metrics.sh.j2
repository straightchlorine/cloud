#!/bin/bash
# Hardware metrics node_exporter lacks (temperature, CPU frequency, memory,
# disk and load come from its own collectors).
set -euo pipefail

TEXTFILE_DIR="{{ prometheus_exporters_node_exporter_textfile_dir }}"
PROM_FILE="$TEXTFILE_DIR/pi_hardware.prom"
TEMP_FILE="$TEXTFILE_DIR/pi_hardware.prom.$$"

mkdir -p "$TEXTFILE_DIR"

# Value from "key=value<unit>", or nothing on error. Missing reads omit the
# series: a fake 0 would look healthy.
vc() {
    vcgencmd "$@" 2>/dev/null | sed -nE '/error/d; s/.*=(0x[0-9a-fA-F]+|[0-9.]+).*/\1/p' || true
}

{
    THROTTLED=""
    if command -v vcgencmd >/dev/null 2>&1; then
        THROTTLED=$(vc get_throttled)
    fi

    echo "# HELP hw_metrics_source_up Whether the hardware source could be read."
    echo "# TYPE hw_metrics_source_up gauge"
    echo "hw_metrics_source_up{source=\"vcgencmd\"} $([ -n "$THROTTLED" ] && echo 1 || echo 0)"

    if [ -n "$THROTTLED" ]; then
        # Bits 0-3: current state; bits 16-19: same flags since boot.
        echo "# HELP hw_throttled Throttling flag, 1 when set."
        echo "# TYPE hw_throttled gauge"
        for entry in 0:under_voltage 1:freq_capped 2:throttled 3:soft_temp_limit; do
            bit=${entry%%:*}
            flag=${entry#*:}
            echo "hw_throttled{flag=\"$flag\",state=\"now\"} $(( (THROTTLED >> bit) & 1 ))"
            echo "hw_throttled{flag=\"$flag\",state=\"since_boot\"} $(( (THROTTLED >> (bit + 16)) & 1 ))"
        done

        CORE_VOLT=$(vc measure_volts core)
        if [ -n "$CORE_VOLT" ]; then
            echo "# HELP hw_voltage_volts Supply voltage per rail."
            echo "# TYPE hw_voltage_volts gauge"
            echo "hw_voltage_volts{rail=\"core\"} $CORE_VOLT"
        fi

        echo "# HELP hw_clock_frequency_hz Non-CPU clock frequency."
        echo "# TYPE hw_clock_frequency_hz gauge"
        for clock in core v3d; do
            FREQ=$(vc measure_clock "$clock")
            if [ -n "$FREQ" ]; then
                echo "hw_clock_frequency_hz{clock=\"$clock\"} $FREQ"
            fi
        done
    fi

    echo "# HELP hw_metrics_last_update_timestamp_seconds Last run of this collector."
    echo "# TYPE hw_metrics_last_update_timestamp_seconds gauge"
    echo "hw_metrics_last_update_timestamp_seconds $(date +%s)"
} > "$TEMP_FILE"

mv "$TEMP_FILE" "$PROM_FILE"
chmod 644 "$PROM_FILE"
