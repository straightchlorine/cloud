#!/bin/bash
# Backup System - Metrics Collector
# Advanced metrics collection and analysis for enterprise backup monitoring
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
BACKUP_BASE="{{ backup_base_path }}"
METRICS_DIR="$BACKUP_BASE/metrics"
MONITORING_DIR="$BACKUP_BASE/monitoring"
METRICS_LOG="$BACKUP_BASE/logs/metrics-$(date +%Y%m%d).log"
RETENTION_DAYS="{{ backup_metrics_retention_days | default('90') }}"

# Create directories if they don't exist
mkdir -p "$METRICS_DIR" "$MONITORING_DIR"

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [METRICS] $*" | tee -a "$METRICS_LOG"
}

collect_system_metrics() {
    log "Collecting system metrics"

    local timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local epoch=$(date +%s)

    # System metrics
    local cpu_usage=$(top -bn1 | grep "Cpu(s)" | awk '{print $2+$4}' | tr -d '%')
    local memory_usage=$(free | grep Mem | awk '{printf "%.1f", $3/$2 * 100.0}')
    local disk_usage=$(df "$BACKUP_BASE" | awk 'NR==2 {print $5}' | tr -d '%')
    local load_avg=$(uptime | awk -F'load average:' '{print $2}' | cut -d, -f1 | xargs)

    # Network metrics
    local network_rx=$(cat /proc/net/dev | awk '/eth0|ens|enp/ {rx+=$2} END {print rx+0}')
    local network_tx=$(cat /proc/net/dev | awk '/eth0|ens|enp/ {tx+=$10} END {print tx+0}')

    # Backup process metrics
    local active_backups=$(pgrep -f "backup-.*\.sh" | wc -l)
    local restic_processes=$(pgrep restic | wc -l)

    cat > "$MONITORING_DIR/system-metrics-$(date +%Y%m%d_%H%M).json" <<EOF
{
    "timestamp": "$timestamp",
    "epoch": $epoch,
    "coordinator": "{{ inventory_hostname }}",
    "system": {
        "cpu_usage_percent": ${cpu_usage:-0},
        "memory_usage_percent": ${memory_usage:-0},
        "disk_usage_percent": ${disk_usage:-0},
        "load_average": ${load_avg:-0},
        "network_rx_bytes": ${network_rx:-0},
        "network_tx_bytes": ${network_tx:-0}
    },
    "backup_processes": {
        "active_backup_scripts": $active_backups,
        "restic_processes": $restic_processes
    }
}
EOF
}

collect_service_metrics() {
    local service_name="$1"
    local repository="$2"

    log "Collecting metrics for service: $service_name"

    local password_file="$BACKUP_BASE/keys/$service_name-password"
    if [[ ! -f "$password_file" ]]; then
        log "WARNING: Password file not found for $service_name"
        return 1
    fi

    # Set environment for restic
    export RESTIC_REPOSITORY="$repository"
    export RESTIC_PASSWORD_FILE="$password_file"
    export RESTIC_CACHE_DIR="$BACKUP_BASE/cache/$service_name"

    local timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local epoch=$(date +%s)

    # Repository metrics
    local repo_accessible=false
    local snapshot_count=0
    local total_size=0
    local total_files=0
    local latest_snapshot=""
    local latest_time=""

    if timeout 30 restic snapshots --quiet >/dev/null 2>&1; then
        repo_accessible=true

        # Get snapshot statistics
        if restic snapshots --tag "$service_name" --json > /tmp/snapshots-$service_name.json 2>/dev/null; then
            snapshot_count=$(jq length /tmp/snapshots-$service_name.json 2>/dev/null || echo "0")

            if [[ $snapshot_count -gt 0 ]]; then
                latest_snapshot=$(jq -r '.[0].id' /tmp/snapshots-$service_name.json 2>/dev/null || echo "")
                latest_time=$(jq -r '.[0].time' /tmp/snapshots-$service_name.json 2>/dev/null || echo "")
            fi

            rm -f /tmp/snapshots-$service_name.json
        fi

        # Get repository statistics
        if restic stats --json > /tmp/stats-$service_name.json 2>/dev/null; then
            total_size=$(jq -r '.total_size' /tmp/stats-$service_name.json 2>/dev/null || echo "0")
            total_files=$(jq -r '.total_file_count' /tmp/stats-$service_name.json 2>/dev/null || echo "0")
            rm -f /tmp/stats-$service_name.json
        fi
    else
        log "WARNING: Cannot access repository for $service_name"
    fi

    # Service status metrics
    local service_active=false
    local service_enabled=false
    local last_backup_status=""
    local last_backup_duration=0

    if systemctl is-active backup-$service_name.service >/dev/null 2>&1; then
        service_active=true
    fi

    if systemctl is-enabled backup-$service_name.timer >/dev/null 2>&1; then
        service_enabled=true
    fi

    # Parse latest metrics from service log
    local service_metrics_file="$METRICS_DIR/backup-$service_name.json"
    if [[ -f "$service_metrics_file" ]]; then
        last_backup_status=$(tail -1 "$service_metrics_file" 2>/dev/null | jq -r '.status' 2>/dev/null || echo "unknown")
        last_backup_duration=$(tail -1 "$service_metrics_file" 2>/dev/null | jq -r '.duration' 2>/dev/null || echo "0")
    fi

    # Calculate backup frequency analysis
    local backups_last_24h=0
    local backups_last_7d=0
    local avg_backup_size=0

    if [[ -f "$service_metrics_file" ]]; then
        local day_ago=$((epoch - 86400))
        local week_ago=$((epoch - 604800))

        backups_last_24h=$(awk -v threshold=$day_ago -F'"' '
            /"timestamp"/ {
                gsub(/[^0-9]/, "", $4)
                if ($4 > threshold) count++
            }
            END { print count+0 }
        ' "$service_metrics_file" 2>/dev/null || echo "0")

        backups_last_7d=$(awk -v threshold=$week_ago -F'"' '
            /"timestamp"/ {
                gsub(/[^0-9]/, "", $4)
                if ($4 > threshold) count++
            }
            END { print count+0 }
        ' "$service_metrics_file" 2>/dev/null || echo "0")

        # Calculate average backup size from successful backups
        avg_backup_size=$(grep '"status":"success"' "$service_metrics_file" 2>/dev/null | \
                         jq -r '.size' 2>/dev/null | \
                         awk '{sum+=$1; count++} END {if(count>0) print int(sum/count); else print 0}' || echo "0")
    fi

    # Create comprehensive metrics record
    cat > "$MONITORING_DIR/service-metrics-$service_name-$(date +%Y%m%d_%H%M).json" <<EOF
{
    "timestamp": "$timestamp",
    "epoch": $epoch,
    "service": "$service_name",
    "coordinator": "{{ inventory_hostname }}",
    "repository": {
        "accessible": $repo_accessible,
        "url": "$repository",
        "snapshots": {
            "total_count": $snapshot_count,
            "latest_id": "$latest_snapshot",
            "latest_time": "$latest_time"
        },
        "storage": {
            "total_size_bytes": $total_size,
            "total_files": $total_files,
            "average_backup_size_bytes": $avg_backup_size
        }
    },
    "service_status": {
        "active": $service_active,
        "enabled": $service_enabled,
        "last_backup_status": "$last_backup_status",
        "last_backup_duration_seconds": $last_backup_duration
    },
    "backup_frequency": {
        "backups_last_24h": $backups_last_24h,
        "backups_last_7d": $backups_last_7d
    }
}
EOF

    log "Metrics collected for $service_name: $snapshot_count snapshots, $(numfmt --to=iec $total_size) total"
}

generate_consolidated_report() {
    log "Generating consolidated metrics report"

    local timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    local report_file="$MONITORING_DIR/consolidated-report-$(date +%Y%m%d_%H%M).json"

    # Aggregate metrics from all services
    local total_snapshots=0
    local total_storage=0
    local healthy_services=0
    local total_services={{ backup_targets | length }}
    local services_summary=""

{% for target in backup_targets | default([]) %}
    local {{ target.service_name | replace('-', '_') }}_metrics="$MONITORING_DIR/service-metrics-{{ target.service_name }}-$(date +%Y%m%d_%H%M).json"
    if [[ -f "${{ target.service_name | replace('-', '_') }}_metrics" ]]; then
        local service_snapshots=$(jq -r '.repository.snapshots.total_count' "${{ target.service_name | replace('-', '_') }}_metrics" 2>/dev/null || echo "0")
        local service_storage=$(jq -r '.repository.storage.total_size_bytes' "${{ target.service_name | replace('-', '_') }}_metrics" 2>/dev/null || echo "0")
        local service_accessible=$(jq -r '.repository.accessible' "${{ target.service_name | replace('-', '_') }}_metrics" 2>/dev/null || echo "false")

        total_snapshots=$((total_snapshots + service_snapshots))
        total_storage=$((total_storage + service_storage))

        if [[ "$service_accessible" == "true" ]]; then
            healthy_services=$((healthy_services + 1))
        fi

        if [[ -n "$services_summary" ]]; then
            services_summary="$services_summary,"
        fi
        services_summary="$services_summary{\"name\":\"{{ target.service_name }}\",\"snapshots\":$service_snapshots,\"storage_bytes\":$service_storage,\"healthy\":$service_accessible}"
    fi
{% endfor %}

    # System health score (0-100)
    local health_score=100
    if [[ $total_services -gt 0 ]]; then
        health_score=$(( (healthy_services * 100) / total_services ))
    fi

    # Get latest system metrics
    local latest_system_metrics=$(ls -t "$MONITORING_DIR"/system-metrics-*.json 2>/dev/null | head -1)
    local cpu_usage=0
    local memory_usage=0
    local disk_usage=0

    if [[ -n "$latest_system_metrics" && -f "$latest_system_metrics" ]]; then
        cpu_usage=$(jq -r '.system.cpu_usage_percent' "$latest_system_metrics" 2>/dev/null || echo "0")
        memory_usage=$(jq -r '.system.memory_usage_percent' "$latest_system_metrics" 2>/dev/null || echo "0")
        disk_usage=$(jq -r '.system.disk_usage_percent' "$latest_system_metrics" 2>/dev/null || echo "0")
    fi

    cat > "$report_file" <<EOF
{
    "timestamp": "$timestamp",
    "coordinator": "{{ inventory_hostname }}",
    "report_type": "consolidated_metrics",
    "summary": {
        "total_services": $total_services,
        "healthy_services": $healthy_services,
        "health_score": $health_score,
        "total_snapshots": $total_snapshots,
        "total_storage_bytes": $total_storage,
        "total_storage_human": "$(numfmt --to=iec $total_storage)"
    },
    "system_status": {
        "cpu_usage_percent": $cpu_usage,
        "memory_usage_percent": $memory_usage,
        "disk_usage_percent": $disk_usage
    },
    "services": [$services_summary]
}
EOF

    log "Consolidated report generated: $report_file"
    log "System health: $health_score% ($healthy_services/$total_services services healthy)"
    log "Total storage: $(numfmt --to=iec $total_storage) across $total_snapshots snapshots"
}

cleanup_old_metrics() {
    log "Cleaning up old metrics files (retention: $RETENTION_DAYS days)"

    # Remove old monitoring files
    find "$MONITORING_DIR" -name "*.json" -mtime +$RETENTION_DAYS -delete 2>/dev/null || true

    # Rotate large metrics files
    find "$METRICS_DIR" -name "backup-*.json" -size +10M | while read -r large_file; do
        log "Rotating large metrics file: $large_file"
        mv "$large_file" "$large_file.$(date +%Y%m%d_%H%M%S)"
        gzip "$large_file.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
    done

    # Clean up old rotated files
    find "$METRICS_DIR" -name "*.gz" -mtime +$RETENTION_DAYS -delete 2>/dev/null || true

    log "Metrics cleanup completed"
}

# Main execution
main() {
    local metrics_start=$(date +%s)
    log "=== Starting Enterprise Backup Metrics Collection ==="

    # Collect system-wide metrics
    collect_system_metrics

    # Collect service-specific metrics
{% for target in backup_targets | default([]) %}
    collect_service_metrics "{{ target.service_name }}" "{{ target.restic_repository }}"
{% endfor %}

    # Generate reports and cleanup
    generate_consolidated_report
    cleanup_old_metrics

    local metrics_end=$(date +%s)
    local metrics_duration=$((metrics_end - metrics_start))
    log "=== Metrics Collection Completed in ${metrics_duration}s ==="
}

# Execute main function
main "$@"