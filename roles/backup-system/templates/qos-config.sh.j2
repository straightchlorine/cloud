#!/bin/bash
# QoS Configuration Script for Backup Traffic
# Generated by Ansible - Do not edit manually

set -euo pipefail

INTERFACE="{{ primary_interface }}"

echo "Configuring QoS for backup traffic on $INTERFACE"

# Configure traffic prioritization
# Lower priority for backup traffic to avoid impacting interactive services
tc qdisc add dev "$INTERFACE" root handle 1: htb default 12 2>/dev/null || true
tc class add dev "$INTERFACE" parent 1: classid 1:12 htb rate 100mbit 2>/dev/null || true

echo "QoS configuration applied successfully"
