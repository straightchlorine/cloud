#!/bin/bash
# Backup System - Health Monitor
# Comprehensive backup system health checking and alerting
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
BACKUP_BASE="{{ backup_base_path }}"
BACKUP_USER="{{ backup_user }}"
HEALTH_LOG="$BACKUP_BASE/logs/health-monitor-$(date +%Y%m%d).log"
ALERT_THRESHOLD_HOURS="{{ backup_alert_threshold_hours | default('25') }}"
WEBHOOK_URL="{{ backup_alert_webhook_url | default('') }}"
EMAIL_TO="{{ backup_alert_email | default('') }}"

# Critical paths
METRICS_DIR="$BACKUP_BASE/metrics"
LOGS_DIR="$BACKUP_BASE/logs"
KEYS_DIR="$BACKUP_BASE/keys"
ALERTS_DIR="$BACKUP_BASE/alerts"

# Create alert directory if it doesn't exist
mkdir -p "$ALERTS_DIR"

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [HEALTH] $*" | tee -a "$HEALTH_LOG"
}

alert() {
    local severity="$1"
    local service="$2"
    local message="$3"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')

    log "$severity: $service - $message"

    # Create alert file
    local alert_file="$ALERTS_DIR/alert-$(date +%s)-$service.json"
    cat > "$alert_file" <<EOF
{
    "timestamp": "$timestamp",
    "severity": "$severity",
    "service": "$service",
    "message": "$message",
    "hostname": "$(hostname)",
    "coordinator": "{{ inventory_hostname }}"
}
EOF

    # Send webhook alert if configured
    if [[ -n "$WEBHOOK_URL" ]]; then
        curl -X POST -H "Content-Type: application/json" \
             -d "@$alert_file" \
             "$WEBHOOK_URL" \
             --connect-timeout 10 \
             --max-time 30 || log "Failed to send webhook alert"
    fi

    # Send email alert if configured
    if [[ -n "$EMAIL_TO" ]] && command -v mail >/dev/null 2>&1; then
        echo "Backup Alert: $severity - $service" | \
        mail -s "[$severity] Backup System Alert: $service" "$EMAIL_TO" || \
        log "Failed to send email alert"
    fi
}

check_service_health() {
    local service_name="$1"
    log "Checking health for service: $service_name"

    # Check if service exists
    if ! systemctl list-units --type=service | grep -q "backup-$service_name.service"; then
        alert "CRITICAL" "$service_name" "Backup service not found or not loaded"
        return 1
    fi

    # Check service status
    if ! systemctl is-active backup-$service_name.service >/dev/null 2>&1; then
        if systemctl is-failed backup-$service_name.service >/dev/null 2>&1; then
            alert "CRITICAL" "$service_name" "Backup service is in failed state"
            return 1
        fi
    fi

    # Check timer status
    if ! systemctl is-enabled backup-$service_name.timer >/dev/null 2>&1; then
        alert "WARNING" "$service_name" "Backup timer is not enabled"
    fi

    # Check last backup time
    local metrics_file="$METRICS_DIR/backup-$service_name.json"
    if [[ -f "$metrics_file" ]]; then
        local last_success=$(grep '"status":"success"' "$metrics_file" | tail -1 | \
                           jq -r '.timestamp' 2>/dev/null || echo "")

        if [[ -n "$last_success" ]]; then
            local last_epoch=$(date -d "$last_success" +%s 2>/dev/null || echo "0")
            local current_epoch=$(date +%s)
            local hours_since=$(( (current_epoch - last_epoch) / 3600 ))

            if [[ $hours_since -gt $ALERT_THRESHOLD_HOURS ]]; then
                alert "CRITICAL" "$service_name" "No successful backup for $hours_since hours (threshold: $ALERT_THRESHOLD_HOURS hours)"
            elif [[ $hours_since -gt $((ALERT_THRESHOLD_HOURS - 2)) ]]; then
                alert "WARNING" "$service_name" "Backup approaching threshold: $hours_since hours since last success"
            else
                log "Service $service_name: Last successful backup $hours_since hours ago"
            fi
        else
            alert "WARNING" "$service_name" "No successful backup found in metrics"
        fi
    else
        alert "WARNING" "$service_name" "No metrics file found"
    fi

    return 0
}

check_repository_health() {
    local service_name="$1"
    local repository="$2"
    local password_file="$KEYS_DIR/$service_name-password"

    log "Checking repository health for $service_name"

    if [[ ! -f "$password_file" ]]; then
        alert "CRITICAL" "$service_name" "Password file missing: $password_file"
        return 1
    fi

    # Set environment for restic
    export RESTIC_REPOSITORY="$repository"
    export RESTIC_PASSWORD_FILE="$password_file"
    export RESTIC_CACHE_DIR="$BACKUP_BASE/cache/$service_name"

    # Quick repository check
    if ! timeout 60 restic snapshots --quiet >/dev/null 2>&1; then
        alert "CRITICAL" "$service_name" "Cannot access repository or repository check failed"
        return 1
    fi

    # Check for recent snapshots
    local snapshot_count=$(restic snapshots --tag "$service_name" --json 2>/dev/null | jq length 2>/dev/null || echo "0")
    if [[ "$snapshot_count" == "0" ]]; then
        alert "WARNING" "$service_name" "No snapshots found with service tag"
    else
        log "Repository health check passed for $service_name ($snapshot_count snapshots)"
    fi

    return 0
}

check_disk_space() {
    log "Checking disk space for backup operations"

    # Check backup base directory
    local backup_usage=$(df "$BACKUP_BASE" | awk 'NR==2 {print $5}' | tr -d '%')
    if [[ $backup_usage -gt 90 ]]; then
        alert "CRITICAL" "disk-space" "Backup directory usage critical: ${backup_usage}%"
    elif [[ $backup_usage -gt 80 ]]; then
        alert "WARNING" "disk-space" "Backup directory usage high: ${backup_usage}%"
    else
        log "Disk space OK: ${backup_usage}% used"
    fi

    # Check staging directory
    local staging_dir="$BACKUP_BASE/staging"
    if [[ -d "$staging_dir" ]]; then
        local staging_size=$(du -sh "$staging_dir" 2>/dev/null | awk '{print $1}' || echo "unknown")
        log "Staging directory size: $staging_size"
    fi
}

check_ssh_connectivity() {
{% for target in backup_targets | default([]) %}
    log "Testing SSH connectivity to {{ target.target_host }}"

    local ssh_key="$KEYS_DIR/{{ target.service_name }}-ssh-key"
    local ssh_user="{{ target.ssh_user | default(backup_user) }}"
    local target_host="{{ target.target_host }}"

    if [[ ! -f "$ssh_key" ]]; then
        alert "CRITICAL" "{{ target.service_name }}" "SSH key missing: $ssh_key"
        continue
    fi

    if ! timeout 15 ssh -i "$ssh_key" \
                      -o ConnectTimeout=10 \
                      -o BatchMode=yes \
                      -o StrictHostKeyChecking=no \
                      "$ssh_user@$target_host" \
                      "echo 'SSH OK'" >/dev/null 2>&1; then
        alert "CRITICAL" "{{ target.service_name }}" "SSH connectivity failed to $target_host"
    else
        log "SSH connectivity OK to {{ target.target_host }}"
    fi
{% endfor %}
}

check_security_posture() {
    log "Checking security posture"

    # Check key file permissions
    find "$KEYS_DIR" -name "*-ssh-key" -not -perm 600 | while read -r key_file; do
        alert "WARNING" "security" "SSH key has incorrect permissions: $key_file"
    done

    find "$KEYS_DIR" -name "*-password*" -not -perm 600 | while read -r pass_file; do
        alert "WARNING" "security" "Password file has incorrect permissions: $pass_file"
    done

    # Check for old log files (cleanup opportunity)
    local old_logs=$(find "$LOGS_DIR" -name "*.log" -mtime +30 2>/dev/null | wc -l)
    if [[ $old_logs -gt 0 ]]; then
        log "Found $old_logs log files older than 30 days (consider cleanup)"
    fi

    # Check vault password file security
    local vault_pass="$KEYS_DIR/.vault-password"
    if [[ -f "$vault_pass" ]]; then
        local vault_perms=$(stat -c %a "$vault_pass" 2>/dev/null || echo "000")
        if [[ "$vault_perms" != "400" ]]; then
            alert "WARNING" "security" "Vault password file has incorrect permissions: $vault_perms"
        fi
    fi
}

generate_health_summary() {
    log "Generating health summary"

    local summary_file="$BACKUP_BASE/monitoring/health-summary-$(date +%Y%m%d_%H%M%S).json"
    local critical_alerts=$(find "$ALERTS_DIR" -name "*.json" -mtime -1 -exec grep -l '"severity": "CRITICAL"' {} \; 2>/dev/null | wc -l)
    local warning_alerts=$(find "$ALERTS_DIR" -name "*.json" -mtime -1 -exec grep -l '"severity": "WARNING"' {} \; 2>/dev/null | wc -l)

    cat > "$summary_file" <<EOF
{
    "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
    "coordinator": "{{ inventory_hostname }}",
    "health_check_duration": $(($(date +%s) - health_start)),
    "alerts_24h": {
        "critical": $critical_alerts,
        "warning": $warning_alerts
    },
    "services_checked": {{ backup_targets | length }},
    "status": "$([ $critical_alerts -eq 0 ] && echo "healthy" || echo "degraded")"
}
EOF

    log "Health summary saved to $summary_file"
}

# Main execution
main() {
    health_start=$(date +%s)
    log "=== Starting Enterprise Backup Health Check ==="

    # Core health checks
    check_disk_space
    check_ssh_connectivity
    check_security_posture

    # Service-specific health checks
{% for target in backup_targets | default([]) %}
    check_service_health "{{ target.service_name }}"
    check_repository_health "{{ target.service_name }}" "{{ target.restic_repository }}"
{% endfor %}

    generate_health_summary

    local health_end=$(date +%s)
    local health_duration=$((health_end - health_start))
    log "=== Health Check Completed in ${health_duration}s ==="
}

# Execute main function
main "$@"