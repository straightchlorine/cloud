#!/bin/bash
# Bandwidth Limiting Script for Backup Operations
# Generated by Ansible - Do not edit manually

set -euo pipefail

INTERFACE="{{ primary_interface }}"
BANDWIDTH_LIMIT="{{ backup_bandwidth_limit | default(100) }}"

# Apply bandwidth limiting using tc (traffic control)
if [ "$BANDWIDTH_LIMIT" -gt 0 ]; then
    echo "Applying bandwidth limit: ${BANDWIDTH_LIMIT}Mbps on $INTERFACE"
    tc qdisc add dev "$INTERFACE" root tbf rate "${BANDWIDTH_LIMIT}mbit" burst 32kbit latency 400ms 2>/dev/null || true
else
    echo "Bandwidth limiting disabled"
fi
