#!/bin/bash
# Backup System - Key Rotation and Management
# Automated SSH key and password rotation for enhanced security
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
BACKUP_BASE="{{ backup_base_path }}"
BACKUP_USER="{{ backup_user }}"
BACKUP_GROUP="{{ backup_group }}"
KEYS_DIR="$BACKUP_BASE/keys"
ROTATION_LOG="$BACKUP_BASE/logs/key-rotation-$(date +%Y%m%d_%H%M%S).log"
ROTATION_BACKUP_DIR="$KEYS_DIR/rotated-$(date +%Y%m%d_%H%M%S)"

# Security settings
KEY_ROTATION_DAYS="{{ backup_key_rotation_days | default('90') }}"
PASSWORD_ROTATION_DAYS="{{ backup_password_rotation_days | default('30') }}"
MINIMUM_PASSWORD_LENGTH=32

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [KEY-ROTATION] $*" | tee -a "$ROTATION_LOG"
}

error_exit() {
    log "ERROR: $1"
    exit "${2:-1}"
}

secure_backup_keys() {
    local service_name="$1"
    log "Creating secure backup of keys for $service_name"

    mkdir -p "$ROTATION_BACKUP_DIR"
    chmod 700 "$ROTATION_BACKUP_DIR"

    # Backup SSH keys
    if [[ -f "$KEYS_DIR/$service_name-ssh-key" ]]; then
        cp "$KEYS_DIR/$service_name-ssh-key" "$ROTATION_BACKUP_DIR/$service_name-ssh-key.old"
        cp "$KEYS_DIR/$service_name-ssh-key.pub" "$ROTATION_BACKUP_DIR/$service_name-ssh-key.pub.old"
        chmod 600 "$ROTATION_BACKUP_DIR/$service_name-ssh-key.old"
        chmod 644 "$ROTATION_BACKUP_DIR/$service_name-ssh-key.pub.old"
    fi

    # Backup password files (encrypted)
    if [[ -f "$KEYS_DIR/$service_name-password.vault" ]]; then
        cp "$KEYS_DIR/$service_name-password.vault" "$ROTATION_BACKUP_DIR/$service_name-password.vault.old"
        chmod 600 "$ROTATION_BACKUP_DIR/$service_name-password.vault.old"
    fi

    log "Keys backed up to $ROTATION_BACKUP_DIR"
}

check_key_age() {
    local key_file="$1"
    local max_age_days="$2"

    if [[ ! -f "$key_file" ]]; then
        echo "missing"
        return 0
    fi

    local key_age_days=$(( ($(date +%s) - $(stat -c %Y "$key_file")) / 86400 ))
    if [[ $key_age_days -gt $max_age_days ]]; then
        echo "expired"
    else
        echo "valid"
    fi
}

generate_new_ssh_key() {
    local service_name="$1"
    log "Generating new SSH key for $service_name"

    local old_key="$KEYS_DIR/$service_name-ssh-key"
    local new_key="$KEYS_DIR/$service_name-ssh-key.new"

    # Generate new key
    ssh-keygen -t ed25519 \
               -f "$new_key" \
               -C "backup-$service_name@{{ ansible_hostname }}-$(date +%Y%m%d)" \
               -N "" >/dev/null 2>&1

    if [[ ! -f "$new_key" ]]; then
        error_exit "Failed to generate new SSH key for $service_name"
    fi

    # Set proper ownership and permissions
    chown "$BACKUP_USER:$BACKUP_GROUP" "$new_key" "$new_key.pub"
    chmod 600 "$new_key"
    chmod 644 "$new_key.pub"

    log "New SSH key generated for $service_name"
}

deploy_new_ssh_key() {
    local service_name="$1"
    local target_host="$2"
    local ssh_user="$3"

    log "Deploying new SSH key for $service_name to $target_host"

    local new_key="$KEYS_DIR/$service_name-ssh-key.new"
    local old_key="$KEYS_DIR/$service_name-ssh-key"

    if [[ ! -f "$new_key" ]]; then
        error_exit "New SSH key not found for $service_name"
    fi

    # Deploy new key using the old key for authentication
    if [[ -f "$old_key" ]]; then
        log "Using existing key to deploy new key"
        if ssh -i "$old_key" \
               -o ConnectTimeout=15 \
               -o BatchMode=yes \
               -o StrictHostKeyChecking=no \
               "$ssh_user@$target_host" \
               "mkdir -p ~/.ssh && chmod 700 ~/.ssh" 2>/dev/null; then

            # Add new key to authorized_keys
            cat "$new_key.pub" | ssh -i "$old_key" \
                                    -o ConnectTimeout=15 \
                                    -o BatchMode=yes \
                                    -o StrictHostKeyChecking=no \
                                    "$ssh_user@$target_host" \
                                    "cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"

            if [[ $? -eq 0 ]]; then
                log "New SSH key successfully deployed to $target_host"
            else
                error_exit "Failed to deploy new SSH key to $target_host"
            fi
        else
            error_exit "Cannot connect to $target_host to deploy new key"
        fi
    else
        log "WARNING: No existing key found, manual deployment required"
        log "Manual command: ssh-copy-id -i $new_key.pub $ssh_user@$target_host"
        return 1
    fi
}

test_new_ssh_key() {
    local service_name="$1"
    local target_host="$2"
    local ssh_user="$3"

    log "Testing new SSH key for $service_name"

    local new_key="$KEYS_DIR/$service_name-ssh-key.new"

    if ssh -i "$new_key" \
           -o ConnectTimeout=10 \
           -o BatchMode=yes \
           -o StrictHostKeyChecking=no \
           "$ssh_user@$target_host" \
           "echo 'New SSH key test successful'" >/dev/null 2>&1; then
        log "New SSH key test successful for $service_name"
        return 0
    else
        log "ERROR: New SSH key test failed for $service_name"
        return 1
    fi
}

activate_new_ssh_key() {
    local service_name="$1"
    log "Activating new SSH key for $service_name"

    local old_key="$KEYS_DIR/$service_name-ssh-key"
    local new_key="$KEYS_DIR/$service_name-ssh-key.new"

    # Move old key to backup location (already done in secure_backup_keys)
    # Activate new key
    mv "$new_key" "$old_key"
    mv "$new_key.pub" "$old_key.pub"

    # Set proper permissions
    chmod 600 "$old_key"
    chmod 644 "$old_key.pub"

    log "New SSH key activated for $service_name"
}

remove_old_ssh_key() {
    local service_name="$1"
    local target_host="$2"
    local ssh_user="$3"

    log "Removing old SSH key from $target_host for $service_name"

    local current_key="$KEYS_DIR/$service_name-ssh-key"
    local old_pub_key="$ROTATION_BACKUP_DIR/$service_name-ssh-key.pub.old"

    if [[ -f "$old_pub_key" ]]; then
        local old_key_content=$(cat "$old_pub_key" 2>/dev/null | awk '{print $2}' || echo "")

        if [[ -n "$old_key_content" ]]; then
            # Remove old key from authorized_keys
            ssh -i "$current_key" \
                -o ConnectTimeout=10 \
                -o BatchMode=yes \
                -o StrictHostKeyChecking=no \
                "$ssh_user@$target_host" \
                "sed -i '/$old_key_content/d' ~/.ssh/authorized_keys" 2>/dev/null

            if [[ $? -eq 0 ]]; then
                log "Old SSH key removed from $target_host"
            else
                log "WARNING: Could not remove old SSH key from $target_host"
            fi
        fi
    fi
}

generate_new_password() {
    local service_name="$1"
    log "Generating new password for $service_name"

    # Generate cryptographically secure password
    local new_password=$(openssl rand -base64 48 | tr -d "=+/" | cut -c1-$MINIMUM_PASSWORD_LENGTH)

    # Create temporary unencrypted file
    local temp_password_file="/tmp/$service_name-password-new.$$"
    echo "$new_password" > "$temp_password_file"
    chmod 600 "$temp_password_file"

    # Encrypt with ansible-vault
    local vault_password_file="$KEYS_DIR/.vault-password"
    if [[ -f "$vault_password_file" ]]; then
        ansible-vault encrypt "$temp_password_file" \
                     --output "$KEYS_DIR/$service_name-password.vault.new" \
                     --vault-password-file "$vault_password_file" 2>/dev/null

        if [[ $? -eq 0 ]]; then
            # Create decrypted version for restic usage
            ansible-vault decrypt "$KEYS_DIR/$service_name-password.vault.new" \
                         --output "$KEYS_DIR/$service_name-password.new" \
                         --vault-password-file "$vault_password_file" 2>/dev/null

            chmod 600 "$KEYS_DIR/$service_name-password.new"
            chown "$BACKUP_USER:$BACKUP_GROUP" "$KEYS_DIR/$service_name-password.new"
            chown "$BACKUP_USER:$BACKUP_GROUP" "$KEYS_DIR/$service_name-password.vault.new"

            log "New password generated and encrypted for $service_name"
        else
            error_exit "Failed to encrypt new password for $service_name"
        fi
    else
        error_exit "Vault password file not found"
    fi

    # Clean up temporary file
    rm -f "$temp_password_file"
}

change_repository_password() {
    local service_name="$1"
    local repository="$2"

    log "Changing repository password for $service_name"

    # Set environment with old password
    export RESTIC_REPOSITORY="$repository"
    export RESTIC_PASSWORD_FILE="$KEYS_DIR/$service_name-password"
    export RESTIC_CACHE_DIR="$BACKUP_BASE/cache/$service_name"

    # Read new password
    local new_password_file="$KEYS_DIR/$service_name-password.new"
    if [[ ! -f "$new_password_file" ]]; then
        error_exit "New password file not found for $service_name"
    fi

    # Change repository password
    export RESTIC_NEW_PASSWORD_FILE="$new_password_file"

    if timeout 60 restic key passwd --new-password-file "$new_password_file" >/dev/null 2>&1; then
        log "Repository password changed successfully for $service_name"
        return 0
    else
        log "ERROR: Failed to change repository password for $service_name"
        return 1
    fi
}

activate_new_password() {
    local service_name="$1"
    log "Activating new password for $service_name"

    # Move files
    mv "$KEYS_DIR/$service_name-password.vault.new" "$KEYS_DIR/$service_name-password.vault"
    mv "$KEYS_DIR/$service_name-password.new" "$KEYS_DIR/$service_name-password"

    # Set permissions
    chmod 600 "$KEYS_DIR/$service_name-password"
    chmod 600 "$KEYS_DIR/$service_name-password.vault"

    log "New password activated for $service_name"
}

rotate_service_keys() {
    local service_name="$1"
    local target_host="$2"
    local ssh_user="$3"
    local repository="$4"

    log "=== Starting key rotation for $service_name ==="

    # Check if rotation is needed
    local ssh_key_status=$(check_key_age "$KEYS_DIR/$service_name-ssh-key" $KEY_ROTATION_DAYS)
    local password_status=$(check_key_age "$KEYS_DIR/$service_name-password" $PASSWORD_ROTATION_DAYS)

    log "Key status for $service_name: SSH=$ssh_key_status, Password=$password_status"

    if [[ "$ssh_key_status" == "valid" && "$password_status" == "valid" ]]; then
        log "No rotation needed for $service_name"
        return 0
    fi

    # Backup existing keys
    secure_backup_keys "$service_name"

    # Rotate SSH key if needed
    if [[ "$ssh_key_status" != "valid" ]]; then
        log "Rotating SSH key for $service_name"

        generate_new_ssh_key "$service_name"

        if deploy_new_ssh_key "$service_name" "$target_host" "$ssh_user"; then
            if test_new_ssh_key "$service_name" "$target_host" "$ssh_user"; then
                activate_new_ssh_key "$service_name"

                # Wait a moment before removing old key
                sleep 5
                remove_old_ssh_key "$service_name" "$target_host" "$ssh_user"

                log "SSH key rotation completed for $service_name"
            else
                error_exit "New SSH key test failed for $service_name - rotation aborted"
            fi
        else
            log "WARNING: SSH key deployment failed for $service_name"
        fi
    fi

    # Rotate password if needed
    if [[ "$password_status" != "valid" ]]; then
        log "Rotating password for $service_name"

        generate_new_password "$service_name"

        if change_repository_password "$service_name" "$repository"; then
            activate_new_password "$service_name"
            log "Password rotation completed for $service_name"
        else
            error_exit "Password rotation failed for $service_name"
        fi
    fi

    log "=== Key rotation completed for $service_name ==="
}

cleanup_rotation_backups() {
    log "Cleaning up old rotation backups"

    # Keep rotation backups for 180 days
    find "$KEYS_DIR" -name "rotated-*" -type d -mtime +180 | while read -r old_backup; do
        log "Removing old rotation backup: $old_backup"
        rm -rf "$old_backup"
    done
}

# Main execution
main() {
    local rotation_start=$(date +%s)
    log "=== Starting Enterprise Backup Key Rotation ==="

    # Create backup directory
    mkdir -p "$ROTATION_BACKUP_DIR"
    chmod 700 "$ROTATION_BACKUP_DIR"

    # Rotate keys for each service
{% for target in backup_targets | default([]) %}
    rotate_service_keys "{{ target.service_name }}" \
                       "{{ target.target_host }}" \
                       "{{ target.ssh_user | default(backup_user) }}" \
                       "{{ target.restic_repository }}"
{% endfor %}

    # Cleanup old backups
    cleanup_rotation_backups

    local rotation_end=$(date +%s)
    local rotation_duration=$((rotation_end - rotation_start))
    log "=== Key Rotation Completed in ${rotation_duration}s ==="
}

# Handle command line arguments
case "${1:-auto}" in
    "force")
        KEY_ROTATION_DAYS=0
        PASSWORD_ROTATION_DAYS=0
        log "Forcing rotation of all keys and passwords"
        ;;
    "ssh-only")
        PASSWORD_ROTATION_DAYS=999999
        log "Rotating SSH keys only"
        ;;
    "password-only")
        KEY_ROTATION_DAYS=999999
        log "Rotating passwords only"
        ;;
    "auto"|"")
        log "Automatic rotation based on age thresholds"
        ;;
    *)
        echo "Usage: $0 [auto|force|ssh-only|password-only]"
        exit 1
        ;;
esac

# Execute main function
main "$@"