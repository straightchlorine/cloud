#!/bin/bash
# Backup System - Coordinator Restore Script
# Service: {{ backup_target.service_name }}
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
export RESTIC_REPOSITORY="{{ backup_target.restic_repository }}"
export RESTIC_PASSWORD_FILE="{{{ common_backup_base_path }}}/keys/{{ backup_target.service_name }}-password"
export RESTIC_CACHE_DIR="{{{ common_backup_base_path }}}/cache/{{ backup_target.service_name }}"

SERVICE_NAME="{{ backup_target.service_name }}"
TARGET_HOST="{{ backup_target.target_host }}"
SSH_USER="{{ backup_target.ssh_user | default(backup_user) }}"
SSH_KEY="{{{ common_backup_base_path }}}/.ssh/nodes/{{ backup_target.service_name }}"

# Usage
usage() {
    echo "Usage: $0 [snapshot-id] [restore-path]"
    echo "  snapshot-id: Restic snapshot ID (use 'latest' for most recent)"
    echo "  restore-path: Path to restore files to"
    exit 1
}

if [ $# -lt 2 ]; then
    usage
fi

SNAPSHOT="$1"
RESTORE_PATH="$2"

echo "Restoring from snapshot: $SNAPSHOT"
echo "Restore path: $RESTORE_PATH"

restic restore "$SNAPSHOT" --target "$RESTORE_PATH"

echo "Restore completed successfully"
