#!/bin/bash
# Backup Coordinator Manager Script
# Generated by Ansible - Do not edit manually

set -euo pipefail

BACKUP_BASE="{{{ common_backup_base_path }}}"

usage() {
    echo "Backup Coordinator Manager"
    echo ""
    echo "Usage: $0 <command> [service]"
    echo ""
    echo "Commands:"
    echo "  status [service]  - Show status of all or specific backup service"
    echo "  start <service>   - Start backup for specific service"
    echo "  logs <service>    - Show logs for specific service"
    echo "  list              - List all configured services"
    echo ""
    echo "Services:"
{% for target in backup_targets %}
    echo "  - {{ target.service_name }}"
{% endfor %}
    exit 1
}

if [ $# -lt 1 ]; then
    usage
fi

COMMAND="$1"
SERVICE="${2:-}"

case "$COMMAND" in
    status)
        if [ -n "$SERVICE" ]; then
            systemctl status "backup-${SERVICE}.timer" "backup-${SERVICE}.service"
        else
{% for target in backup_targets %}
            echo "=== {{ target.service_name }} ==="
            systemctl status "backup-{{ target.service_name }}.timer" --no-pager || true
            echo ""
{% endfor %}
        fi
        ;;
    start)
        if [ -z "$SERVICE" ]; then
            echo "Error: Service name required"
            usage
        fi
        systemctl start "backup-${SERVICE}.service"
        ;;
    logs)
        if [ -z "$SERVICE" ]; then
            echo "Error: Service name required"
            usage
        fi
        journalctl -u "backup-${SERVICE}.service" -f
        ;;
    list)
{% for target in backup_targets %}
        echo "{{ target.service_name }}: {{ target.target_host }}"
{% endfor %}
        ;;
    *)
        echo "Unknown command: $COMMAND"
        usage
        ;;
esac
