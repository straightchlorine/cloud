#!/bin/bash
# Backup System - Coordinator Backup Script
# Service: {{ backup_target.service_name }}
# Target: {{ backup_target.target_host }}
# Generated by Ansible - Do not edit manually

set -euo pipefail

# Configuration
export RESTIC_REPOSITORY="{{ backup_target.restic_repository }}"
export RESTIC_PASSWORD_FILE="{{{ common_backup_base_path }}}/keys/{{ backup_target.service_name }}-password"
export RESTIC_CACHE_DIR="{{{ common_backup_base_path }}}/cache/{{ backup_target.service_name }}"

# Service configuration
SERVICE_NAME="{{ backup_target.service_name }}"
TARGET_HOST="{{ backup_target.target_host }}"
SSH_USER="{{ backup_target.ssh_user | default(backup_user) }}"
SSH_KEY="{{{ common_backup_base_path }}}/.ssh/nodes/{{ backup_target.service_name }}"
RCLONE_CONFIG="{{{ common_backup_base_path }}}/.config/rclone/rclone.conf"
STAGING_DIR="{{{ common_backup_base_path }}}/staging/${SERVICE_NAME}"
LOG_FILE="{{{ common_backup_base_path }}}/logs/backup-${SERVICE_NAME}-$(date +%Y%m%d_%H%M%S).log"
METRICS_FILE="{{{ common_backup_base_path }}}/metrics/backup-${SERVICE_NAME}.json"

# Enhanced configuration
BACKUP_METHOD="{{ backup_target.backup_method | default('hybrid_enhanced') }}"
NETWORK_OPTIMIZATION="{{ backup_target.network_optimization | default(true) }}"
BANDWIDTH_LIMIT="{{ backup_target.bandwidth_limit_mbps | default(0) }}"
CONCURRENT_TRANSFERS="{{ backup_target.concurrent_transfers | default(3) }}"
COMPRESSION_LEVEL="{{ backup_target.compression_level | default('adaptive') }}"

# Backup paths
BACKUP_PATHS=(
{% for path in backup_target.backup_paths %}
    "{{ path }}"
{% endfor %}
)

# Enhanced exclude patterns
EXCLUDE_PATTERNS=(
{% for pattern in backup_target.exclude_patterns | default([]) %}
    "{{ pattern }}"
{% endfor %}
)

# Functions
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [BACKUP-${SERVICE_NAME}] $*" | tee -a "$LOG_FILE"
}

error_exit() {
    log "ERROR: $1"
    record_metrics "error" "$(date +%s)" "$1"
    cleanup_staging
    exit "${2:-1}"
}

cleanup_staging() {
    if [[ -d "$STAGING_DIR" ]]; then
        log "Cleaning up staging directory: $STAGING_DIR"
        rm -rf "$STAGING_DIR"
    fi
}

record_metrics() {
    local operation="$1"
    local timestamp="$2"
    local status="$3"
    local size="${4:-0}"
    local duration="${5:-0}"

    if command -v jq >/dev/null 2>&1; then
        local iso_timestamp=$(date -u -d "@$timestamp" +"%Y-%m-%dT%H:%M:%SZ")
        echo "{\"timestamp\":\"$iso_timestamp\",\"service\":\"$SERVICE_NAME\",\"operation\":\"$operation\",\"status\":\"$status\",\"size\":$size,\"duration\":$duration}" >> "$METRICS_FILE"
    fi
}

check_prerequisites() {
    log "Checking enterprise backup prerequisites..."

    # Check required tools
    for tool in rclone restic ssh jq; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            error_exit "$tool is not installed or not in PATH"
        fi
    done

    # Check password file
    if [[ ! -f "$RESTIC_PASSWORD_FILE" ]]; then
        error_exit "Password file not found: $RESTIC_PASSWORD_FILE"
    fi

    # Check SSH key
    if [[ ! -f "$SSH_KEY" ]]; then
        error_exit "SSH key not found: $SSH_KEY"
    fi

    # Check rclone config
    if [[ ! -f "$RCLONE_CONFIG" ]]; then
        error_exit "Rclone config not found: $RCLONE_CONFIG"
    fi

    log "Prerequisites check completed"
}

test_connectivity() {
    log "Testing enterprise backup connectivity to $TARGET_HOST..."

    # Test SSH connectivity
    if ssh -i "$SSH_KEY" -F /dev/null -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$SSH_USER@$TARGET_HOST" "echo 'SSH connectivity verified'" >/dev/null 2>&1; then
        log "SSH connectivity test passed"
    else
        error_exit "Cannot establish SSH connection to $SSH_USER@$TARGET_HOST"
    fi

    # Test rclone connectivity
    if rclone --config "$RCLONE_CONFIG" lsd "$SERVICE_NAME:/" >/dev/null 2>&1; then
        log "Rclone connectivity test passed"
    else
        error_exit "Cannot connect to remote host via rclone"
    fi
}

validate_disk_space() {
    log "Validating available disk space for backup operation..."

    # Get estimated remote size for all backup paths
    local estimated_size=0
    for path in "${BACKUP_PATHS[@]}"; do
        local path_size=$(rclone --config "$RCLONE_CONFIG" size "$SERVICE_NAME:$path" --json 2>/dev/null | jq -r '.bytes // 0' || echo "0")
        estimated_size=$((estimated_size + path_size))
    done

    if [[ $estimated_size -eq 0 ]]; then
        log "WARNING: Could not estimate remote size, skipping space validation"
        return 0
    fi

    # Get available space in staging directory
    local staging_parent=$(dirname "$STAGING_DIR")
    local available_bytes=$(df --output=avail "$staging_parent" | tail -1)
    available_bytes=$((available_bytes * 1024))  # Convert KB to bytes

    # Add 20% safety margin
    local required_bytes=$((estimated_size + (estimated_size / 5)))

    log "Disk space check: Required $(numfmt --to=iec $required_bytes), Available $(numfmt --to=iec $available_bytes)"

    if [[ $available_bytes -lt $required_bytes ]]; then
        error_exit "Insufficient disk space: Required $(numfmt --to=iec $required_bytes), Available $(numfmt --to=iec $available_bytes)"
    fi

    log "Disk space validation passed"
}

sync_remote_files() {
    log "Starting enhanced enterprise file synchronization from $SERVICE_NAME..."

    # Create staging directory
    mkdir -p "$STAGING_DIR"

    # Build rclone arguments with network optimization
    local rclone_args=(--config "$RCLONE_CONFIG")

    if [[ "$NETWORK_OPTIMIZATION" == "true" ]]; then
        if [[ "$BANDWIDTH_LIMIT" != "0" ]]; then
            rclone_args+=(--bwlimit "${BANDWIDTH_LIMIT}M")
        fi
        rclone_args+=(--transfers "$CONCURRENT_TRANSFERS")
        rclone_args+=(--checkers 4)
        rclone_args+=(--retries 3)
        rclone_args+=(--low-level-retries 10)
        rclone_args+=(--buffer-size 16M)
        rclone_args+=(--use-server-modtime)
    fi

    local total_size=0
    local sync_start=$(date +%s)

    # Sync each backup path
    for path in "${BACKUP_PATHS[@]}"; do
        log "Syncing $path with enterprise optimization..."

        # Build exclude arguments
        local exclude_args=()
        for pattern in "${EXCLUDE_PATTERNS[@]}"; do
            exclude_args+=(--exclude "$pattern")
        done

        # Enhanced sync with rclone
        local path_sync_start=$(date +%s)
        if rclone sync \
            "$SERVICE_NAME:$path" "$STAGING_DIR$path" \
            "${rclone_args[@]}" \
            "${exclude_args[@]}" \
            --progress \
            --stats 30s \
            --stats-file-name-length 0 \
            >> "$LOG_FILE" 2>&1; then
            local path_sync_end=$(date +%s)
            local path_sync_duration=$((path_sync_end - path_sync_start))
            local path_size=$(du -sb "$STAGING_DIR$path" 2>/dev/null | cut -f1 || echo "0")
            total_size=$((total_size + path_size))
            log "Successfully synced $path in ${path_sync_duration}s ($(numfmt --to=iec $path_size))"
        else
            local path_sync_end=$(date +%s)
            local path_sync_duration=$((path_sync_end - path_sync_start))
            log "WARNING: Failed to sync $path (may not exist on remote)"
        fi
    done

    local sync_end=$(date +%s)
    local sync_duration=$((sync_end - sync_start))
    log "Enhanced file synchronization completed in ${sync_duration}s ($(numfmt --to=iec $total_size) total)"
    record_metrics "sync" "$sync_end" "success" "$total_size" "$sync_duration"
}

perform_backup() {
    log "Starting enterprise restic backup with method: $BACKUP_METHOD..."

    # Check if staging directory has content
    if [[ ! -d "$STAGING_DIR" ]] || [[ -z "$(ls -A "$STAGING_DIR" 2>/dev/null)" ]]; then
        error_exit "No files to backup - staging directory is empty"
    fi

    local backup_start=$(date +%s)

    # Build enhanced backup command
    local backup_args=(
        backup
        "$STAGING_DIR"
        --tag "${SERVICE_NAME}"
        --tag "$(hostname)"
        --tag "$(date +%Y-%m-%d)"
        --tag "backup_method:$BACKUP_METHOD"
        --tag "backup:coordinator"
    )

    if [[ "$BACKUP_METHOD" == "hybrid_enhanced" ]]; then
        backup_args+=(--compression "$COMPRESSION_LEVEL")
        if [[ "$NETWORK_OPTIMIZATION" == "true" ]]; then
            backup_args+=(--read-concurrency 4)
        fi
    fi

    # Execute enterprise backup
    log "Executing enterprise backup: restic ${backup_args[*]}"
    if restic "${backup_args[@]}" >> "$LOG_FILE" 2>&1; then
        local backup_exit_code=$?
        local backup_end=$(date +%s)
        local backup_duration=$((backup_end - backup_start))
        local backup_size=$(du -sb "$STAGING_DIR" 2>/dev/null | cut -f1 || echo "0")

        if [[ $backup_exit_code -eq 0 ]]; then
            log "Enterprise backup completed successfully in ${backup_duration}s"
            record_metrics "backup" "$backup_end" "success" "$backup_size" "$backup_duration"
        elif [[ $backup_exit_code -eq 1 ]]; then
            log "Enterprise backup completed with warnings in ${backup_duration}s"
            record_metrics "backup" "$backup_end" "warning" "$backup_size" "$backup_duration"
        else
            record_metrics "backup" "$backup_end" "failed" "$backup_size" "$backup_duration"
            error_exit "Enterprise backup failed with exit code $backup_exit_code"
        fi
    else
        local backup_end=$(date +%s)
        local backup_duration=$((backup_end - backup_start))
        record_metrics "backup" "$backup_end" "failed" "0" "$backup_duration"
        error_exit "Enterprise backup command failed"
    fi
}

cleanup_old_snapshots() {
    log "Cleaning up old snapshots with enterprise retention policy..."

    local cleanup_start=$(date +%s)
    local cleanup_cmd=(
        forget
        --tag "${SERVICE_NAME}"
        --keep-daily "{{ backup_target.retention_policy.daily | default('30') }}"
        --keep-weekly "{{ backup_target.retention_policy.weekly | default('12') }}"
        --keep-monthly "{{ backup_target.retention_policy.monthly | default('24') }}"
        --keep-yearly "{{ backup_target.retention_policy.yearly | default('3') }}"
        --prune
    )

    log "Executing cleanup: restic ${cleanup_cmd[*]}"
    if restic "${cleanup_cmd[@]}" >> "$LOG_FILE" 2>&1; then
        local cleanup_end=$(date +%s)
        local cleanup_duration=$((cleanup_end - cleanup_start))
        log "Enterprise cleanup completed successfully in ${cleanup_duration}s"
        record_metrics "cleanup" "$cleanup_end" "success" "0" "$cleanup_duration"
    else
        local cleanup_end=$(date +%s)
        local cleanup_duration=$((cleanup_end - cleanup_start))
        log "WARNING: Enterprise cleanup failed but backup was successful"
        record_metrics "cleanup" "$cleanup_end" "warning" "0" "$cleanup_duration"
    fi
}

verify_backup_integrity() {
    log "Starting cryptographic integrity verification..."

    local verify_start=$(date +%s)
    local verification_level="{{ backup_target.verification_level | default('full') }}"

    # Perform repository integrity check
    log "Performing repository structure verification..."
    if restic check --read-data-subset=5% >> "$LOG_FILE" 2>&1; then
        log "Repository structure verification passed"
    else
        local verify_end=$(date +%s)
        local verify_duration=$((verify_end - verify_start))
        record_metrics "verification" "$verify_end" "failed" "0" "$verify_duration"
        error_exit "Repository structure verification failed - data integrity compromised"
    fi

    # Full data verification (configurable)
    if [[ "$verification_level" == "full" ]]; then
        log "Performing full cryptographic data verification (this may take time)..."
        if restic check --read-data >> "$LOG_FILE" 2>&1; then
            log "Full cryptographic verification passed - all data is intact"
        else
            local verify_end=$(date +%s)
            local verify_duration=$((verify_end - verify_start))
            record_metrics "verification" "$verify_end" "failed" "0" "$verify_duration"
            error_exit "Full data verification failed - backup corruption detected"
        fi
    elif [[ "$verification_level" == "metadata" ]]; then
        log "Performing metadata-only verification..."
        if restic check >> "$LOG_FILE" 2>&1; then
            log "Metadata verification passed"
        else
            local verify_end=$(date +%s)
            local verify_duration=$((verify_end - verify_start))
            record_metrics "verification" "$verify_end" "failed" "0" "$verify_duration"
            error_exit "Metadata verification failed"
        fi
    fi

    # Verify latest snapshot integrity
    local latest_snapshot=$(restic snapshots --tag "${SERVICE_NAME}" --last 1 --json | jq -r '.[0].id' 2>/dev/null || echo "")
    if [[ -n "$latest_snapshot" ]]; then
        log "Verifying latest snapshot: $latest_snapshot"
        if restic check --read-data "$latest_snapshot" >> "$LOG_FILE" 2>&1; then
            log "Latest snapshot verification passed"
        else
            local verify_end=$(date +%s)
            local verify_duration=$((verify_end - verify_start))
            record_metrics "verification" "$verify_end" "failed" "0" "$verify_duration"
            error_exit "Latest snapshot verification failed"
        fi
    fi

    local verify_end=$(date +%s)
    local verify_duration=$((verify_end - verify_start))
    log "Cryptographic integrity verification completed successfully in ${verify_duration}s"
    record_metrics "verification" "$verify_end" "success" "0" "$verify_duration"
}

get_backup_stats() {
    log "Getting enterprise backup statistics..."

    if restic snapshots --tag "${SERVICE_NAME}" --json > /tmp/snapshots.json 2>>"$LOG_FILE"; then
        local snapshot_count=$(jq length /tmp/snapshots.json 2>/dev/null || echo "unknown")
        log "Total snapshots for ${SERVICE_NAME}: $snapshot_count"

        if command -v jq >/dev/null 2>&1 && [[ "$snapshot_count" != "unknown" && "$snapshot_count" -gt 0 ]]; then
            local latest_snapshot=$(jq -r '.[0].id' /tmp/snapshots.json 2>/dev/null || echo "unknown")
            local latest_time=$(jq -r '.[0].time' /tmp/snapshots.json 2>/dev/null || echo "unknown")
            log "Latest snapshot: $latest_snapshot at $latest_time"

            # Get repository stats
            if restic stats --json > /tmp/stats.json 2>>"$LOG_FILE"; then
                local total_size=$(jq -r '.total_size' /tmp/stats.json 2>/dev/null || echo "unknown")
                local total_file_count=$(jq -r '.total_file_count' /tmp/stats.json 2>/dev/null || echo "unknown")
                log "Repository stats: $total_file_count files, $(numfmt --to=iec $total_size || echo $total_size) bytes"
                rm -f /tmp/stats.json
            fi
        fi

        rm -f /tmp/snapshots.json
    else
        log "Could not retrieve enterprise backup statistics"
    fi
}

# Main execution
main() {
    local operation_start=$(date +%s)
    log "=== Starting Backup Operation for ${SERVICE_NAME} ==="

    # Set up cleanup trap
    trap cleanup_staging EXIT

    check_prerequisites
    test_connectivity
    validate_disk_space
    sync_remote_files
    perform_backup
    verify_backup_integrity
    cleanup_old_snapshots
    get_backup_stats

    local operation_end=$(date +%s)
    local operation_duration=$((operation_end - operation_start))
    log "=== Backup Operation Completed for ${SERVICE_NAME} in ${operation_duration}s ==="
    record_metrics "operation" "$operation_end" "success" "0" "$operation_duration"
}

# Execute main function
main "$@"
