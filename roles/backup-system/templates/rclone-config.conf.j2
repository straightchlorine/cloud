# Rclone Configuration for Backup Coordinator
# Generated by Ansible - Do not edit manually

{% for target in backup_targets %}
[{{ target.service_name }}]
type = sftp
host = {{ target.target_host }}
user = {{ target.ssh_user | default(backup_user) }}
port = {{ target.ssh_port | default(22) }}
key_file = {{ backup_base_path }}/.ssh/nodes/{{ target.service_name }}
use_insecure_cipher = false
disable_hashcheck = false
server_command = sudo /usr/bin/sftp-server
{% if target.ssh_config_extra is defined %}
{{ target.ssh_config_extra }}
{% endif %}

{% endfor %}
