---
# Ansible-lint configuration - gradually reducing skip list
skip_list:
  - var-naming           # Requires careful review
  - command-instead-of-module  # 57 instances, needs refactor
  - command-instead-of-shell   # Requires module replacements
  - ignore-errors        # Must audit each one

  # Phase 2: These can be auto-fixed or are low-priority
  # - key-order          ← ENABLING
  # - fqcn               ← ENABLING
  # - name               ← Will fix manually (better control)

  # Keep disabled for security review
  - risky-file-permissions
  - risky-shell-pipe
  - partial-become       # Review all become usage
  - no-changed-when

  # Other hygiene rules
  - meta-no-tags
  - role-name
  - jinja
  - args

exclude_paths:
  - ./inventory
  - ./.git
  - ./.woodpecker/
